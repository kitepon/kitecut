+import { useState, useSyncExternalStore } from 'react';
+import type { createCapture } from './capture.js';
+import './capture.css';
+export function CapturePanel({ capture }: { capture: ReturnType<typeof createCapture> }) {
+  const state = useSyncExternalStore(capture.subscribe, capture.state);
+  const [open, setOpen] = useState(false), [source, setSource] = useState(''), [microphoneId, setMicrophone] = useState('');
+  const [audio, setAudio] = useState<'none' | 'system' | 'application'>('none'), [message, setMessage] = useState('');
+  const [sources, setSources] = useState<Awaited<ReturnType<typeof capture.sources>>>({ screens: [], cameras: [], microphones: [] });
+  const refresh = async () => { try { setSources(await capture.sources()); } catch (error) { setMessage(String(error)); } };
+  const busy = ['starting', 'recording', 'saving'].includes(state.status);
+  return <div className="local-image capture-panel">
+    <button className="capture-launch" onClick={() => { setOpen(!open); if (!open) void refresh(); }}>{state.status === 'recording' ? '● 録画中' : state.status === 'saving' ? '収録を保存中…' : '◉ 収録する'}</button>
+    {state.status === 'recording' && <button className="capture-stop" onClick={async () => { try { await capture.stop(); } catch (error) { setMessage(String(error)); } }}>■ 録画を停止</button>}
+    {open && <aside role="dialog" aria-label="素材の収録"><header><h2>実演を収録する</h2><button aria-label="収録パネルを閉じる" onClick={() => setOpen(false)}>×</button></header>
+      <p>停止するとMP4を保存し、素材一覧へ追加します。</p>
+      <label>収録対象<select disabled={busy} value={source} onChange={event => setSource(event.target.value)}><option value="">対象を選択</option><optgroup label="画面とウィンドウ">{sources.screens.map(item => <option key={item.id} value={'screen|' + item.id}>{item.name}</option>)}</optgroup><optgroup label="カメラ">{sources.cameras.map(item => <option key={item.id} value={'camera|' + item.id}>{item.name}</option>)}</optgroup></select></label>
+      <button disabled={busy} onClick={() => void refresh()}>対象一覧を更新</button>
+      <label>画面収録の音声<select disabled={busy || source.startsWith('camera|')} value={audio} onChange={event => setAudio(event.target.value as typeof audio)}><option value="none">収録しない</option><option value="application">編集アプリの音声</option><option value="system">PC全体の音声</option></select></label>
+      <label>マイク<select disabled={busy} value={microphoneId} onChange={event => setMicrophone(event.target.value)}><option value="">収録しない</option>{sources.microphones.map(item => <option key={item.id} value={item.id}>{item.name}</option>)}</select></label>
+      <small>音声を併用すると1トラックに混合します。</small>
+      <button className="local-image-generate" disabled={busy || !source} onClick={async () => {
+        setMessage('');
+        try { await capture.start({ ...(source.startsWith('camera|') ? { cameraId: source.slice(7) } : { sourceId: source.slice(7) }), audio: source.startsWith('camera|') ? 'none' : audio, ...(microphoneId ? { microphoneId } : {}) }); }
+        catch (error) { setMessage(String(error)); }
+      }}>録画を開始</button>
+      <p role="status">{state.status === 'recording' ? '録画中です。下の停止ボタンで終了できます。' : state.status === 'starting' ? '収録を開始しています…' : state.status === 'saving' ? '録画を保存して素材へ追加しています…' : state.status === 'completed' ? '収録を保存し、素材一覧に追加しました。' : state.error ?? message}</p>
+      {state.path && <small className="capture-path">{state.path}</small>}
+    </aside>}
+  </div>;
+}
