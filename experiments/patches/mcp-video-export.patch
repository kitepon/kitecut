+import { beforeEach, expect, test, vi } from "vitest";
+import { defaultTimeline, type Timeline } from "@frontstage/core";
+import { runExport } from "@frontstage/engine";
+import { DesktopExportGateway } from "../src/renderer/desktop-export-gateway.js";
+vi.mock("@frontstage/engine", () => ({ runExport: vi.fn() }));
+const media = { open: vi.fn() };
+beforeEach(() => {
+ vi.clearAllMocks(); vi.stubGlobal("window", { desktopExport: {} });
+ vi.stubGlobal("VideoEncoder", class {
+  static async isConfigSupported() { return { supported: true }; }
+  state = "configured";
+  configure() {} addEventListener() {} close() { this.state = "closed"; }
+ });
+});
+
+test("開始は完了を待たず、映像100%でも最終処理中は実行中を返す", async () => {
+ let finish!: () => void;
+ vi.mocked(runExport).mockImplementation(async (_t, _m, _s, progress) => {
+  progress?.(30, 30);
+  await new Promise<void>(resolve => { finish = resolve; });
+  return undefined;
+ });
+ const gateway = new DesktopExportGateway();
+ const observed: unknown[] = [];
+ gateway.subscribe(() => observed.push(gateway.getProgress()));
+ const job = gateway.startVideo(defaultTimeline(), media, "C:/project/試験.mp4", false);
+ expect(job.status).toBe("running");
+ await vi.waitFor(() => expect(runExport).toHaveBeenCalledOnce());
+ expect(gateway.getJob(job.jobId).status).toBe("running");
+ expect(gateway.getProgress()?.done).toBe(30);
+ expect(() => gateway.startVideo(defaultTimeline(), media, "C:/project/別.mp4", false)).toThrow();
+ finish();
+ await vi.waitFor(() => expect(gateway.getJob(job.jobId).status).toBe("completed"));
+ expect(gateway.getProgress()).toBeNull();
+ expect(observed.length).toBeGreaterThan(1);
+});
+
+test("失敗を状態照会へ残し、不明なジョブを完了扱いしない", async () => {
+ vi.mocked(runExport).mockRejectedValue(new Error("書込み拒否"));
+ const gateway = new DesktopExportGateway();
+ const job = gateway.startVideo(defaultTimeline(), media, "C:/project/試験.mp4", false);
+ await vi.waitFor(() => expect(gateway.getJob(job.jobId)).toMatchObject({status:"failed", error:"書込み拒否"}));
+ expect(() => gateway.getJob("unknown")).toThrow();
+ expect(gateway.getProgress()).toBeNull();
+});
+
+test("字幕の仮想refを読まず、開始時の素材とタイムラインを保持する", async () => {
+ const source = { open: vi.fn(async () => new Blob(["元の素材"])) };
+ const timeline = { ...defaultTimeline(), tracks: [{hidden:false, muted:false, clips:[
+  {mediaType:"text", mediaRef:"仮想字幕"}, {mediaType:"video", mediaRef:"映像"}
+ ]}] } as unknown as Timeline;
+ vi.mocked(runExport).mockImplementation(async (snapshot, snapshotMedia) => {
+  expect(snapshot.width).not.toBe(100);
+  expect(await (await snapshotMedia.open("映像")).text()).toBe("元の素材");
+  return undefined;
+ });
+ const gateway = new DesktopExportGateway();
+ const job = gateway.startVideo(timeline, source, "C:/project/試験.mp4", false);
+ timeline.width = 100;
+ source.open.mockImplementation(async () => new Blob(["別プロジェクト"]));
+ await vi.waitFor(() => expect(gateway.getJob(job.jobId).status).toBe("completed"));
+  expect(source.open).toHaveBeenCalledOnce();
+  expect(source.open).toHaveBeenCalledWith("映像");
+});
+
+test("描画失敗時に開始したFFmpegセッションを解放する", async () => {
+ const bridge = { start:vi.fn(async () => "owned"), cancel:vi.fn(async () => {}) };
+ vi.stubGlobal("window", {desktopExport:bridge});
+ vi.mocked(runExport).mockImplementation(async (_t, _m, sink) => {
+  await sink.configure({width:1920,height:1080,fps:30});
+  throw new Error("描画失敗");
+ });
+ const gateway = new DesktopExportGateway();
+ const job = gateway.startVideo(defaultTimeline(), media, "C:/project/試験.mp4", false);
+ await vi.waitFor(() => expect(bridge.cancel).toHaveBeenCalledWith("owned"));
+ expect(gateway.getJob(job.jobId).status).toBe("failed");
+ expect(gateway.getProgress()).toBeNull();
+});
+
+test("人が保存先を選んでいる間はAIの別書出しを始めない", async () => {
+ let cancel!: () => void;
+ vi.stubGlobal("window", {desktopExport:{},desktopProject:{pickExportSave:()=>new Promise<null>(resolve=>{cancel=()=>resolve(null);})}});
+ const gateway=new DesktopExportGateway();
+ const picked=gateway.pickTarget("試験");
+ expect(()=>gateway.startVideo(defaultTimeline(),media,"C:/project/試験.mp4",false)).toThrow();
+ cancel();
+ expect(await picked).toBeNull();
+});
