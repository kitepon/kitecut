+import { z } from 'zod';
+import { synthesizeSoundEffect, type SoundEffectInput } from '../generation/sound-effect.js';
+import { ok, errorResult } from './executor.js';
+import type { ToolSpec } from './types.js';
+
+export function generateSoundEffectTool(): ToolSpec {
+  return {
+    name: 'generate_sound_effect',
+    description: '短い効果音をこの端末で合成して素材へ追加する。chimeは一音の余韻、arrivalは三音の登場音、whooshは切替音。外部録音・モデル・API料金なし。生成後は通常の音声素材として配置・編集できる。',
+    inputSchema: z.object({ preset: z.enum(['chime', 'whoosh', 'arrival']), duration: z.number().positive().default(1.2), pitch: z.number().positive().max(8000).default(587.33), seed: z.number().int().nonnegative().max(4294967295).default(42) }),
+    async run(args, ctx) {
+      if (!ctx.mediaImport) return errorResult('素材への取込みが接続されていません。');
+      const input = args as SoundEffectInput;
+      const labels = { chime: '澄んだ一音', whoosh: '空気の切替音', arrival: '三音の登場音' };
+      const bytes = synthesizeSoundEffect(input);
+      const result = await ctx.mediaImport.fromBytes(bytes, 'audio/wav', `${labels[input.preset]}・${input.pitch}Hz・${input.duration}秒・${input.seed}.wav`);
+      return ok(JSON.stringify({ ...result, parameters: input, sampleRate: 48000 }));
+    },
+  };
+}
