+import { test, expect, vi } from 'vitest';
+import { EditorStore, defaultTimeline, MediaManifestSchema } from '@frontstage/core';
+import { ToolExecutor } from '../src/tools/executor.js';
+import { generateLocalVideoTool } from '../src/tools/generate-local-video-tool.js';
+
+function setup(type = 'image') {
+  const addPlaceholder = vi.fn(), startJob = vi.fn().mockResolvedValue({ jobId: 'job' }), localVideoImage = vi.fn().mockResolvedValue('aW1hZ2U=');
+  const manifest = MediaManifestSchema.parse({ version: 2, entries: [{ id: 'source', name: '元画像', type, source: { kind: 'project', relativePath: 'media/source.png' }, duration: 5 }], folders: [] });
+  const executor = new ToolExecutor([generateLocalVideoTool()], { store: new EditorStore(defaultTimeline()), getManifest: () => manifest, newId: () => 'video', generation: { localVideoImage, addPlaceholder, startJob, hasKey: vi.fn(), confirmThreshold: 0 } });
+  return { executor, addPlaceholder, startJob, localVideoImage };
+}
+
+test('画像を動画へ渡し、保存可能な生成条件と動画の長さを保持する', async () => {
+  const c = setup();
+  expect((await c.executor.execute('generate_local_video', { mediaId: 'source', prompt: 'ガラスが回る' })).isError).toBe(false);
+  const entry = c.addPlaceholder.mock.calls[0]![0];
+  expect(entry).toMatchObject({ type: 'video', duration: 121 / 24, generationInput: { parameters: { mediaId: 'source', kind: 'video' } } });
+  expect(entry.generationInput.parameters.startImage).toBeUndefined();
+  expect(c.startJob.mock.calls[0]![0]).toMatchObject({ input: { startImage: 'aW1hZ2U=', frames: 121, fps: 24 }, costCredits: 0 });
+  expect(MediaManifestSchema.parse({ version: 2, entries: [entry], folders: [] }).entries[0]).toEqual(entry);
+});
+
+test('動画を元画像に指定した場合と不正なフレーム数を生成へ流さない', async () => {
+  const c = setup('video');
+  expect((await c.executor.execute('generate_local_video', { mediaId: 'source', prompt: '動く' })).isError).toBe(true);
+  expect(c.localVideoImage).not.toHaveBeenCalled();
+  expect((await setup().executor.execute('generate_local_video', { mediaId: 'source', prompt: '動く', frames: 120 })).isError).toBe(true);
+  expect(c.startJob).not.toHaveBeenCalled();
+});
