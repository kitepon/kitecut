index 0000000..59d7b45
--- /dev/null
+++ b/packages/ui/src/media/audio-preview.ts
@@ -0,0 +1,46 @@
+export function createAudioPreview(read: (id: string) => Promise<ArrayBuffer>, create = () => new Audio()) {
+  let audio: HTMLAudioElement | undefined, url = '', revision = 0;
+  let state = { mediaId: '', currentTime: 0, duration: 0, paused: true, loading: false };
+  const listeners = new Set<() => void>();
+  const emit = () => { listeners.forEach(listener => listener()); };
+  const element = () => {
+    if (!audio) {
+      audio = create(); audio.controls = true; audio.setAttribute('aria-label', '素材の試聴');
+      for (const event of ['timeupdate', 'play', 'pause', 'ended', 'seeked', 'loadedmetadata']) audio.addEventListener(event, () => {
+        state = { ...state, currentTime: audio!.currentTime, duration: Number.isFinite(audio!.duration) ? audio!.duration : 0, paused: audio!.paused }; emit();
+      });
+    }
+    return audio;
+  };
+  const reset = () => {
+    revision++; audio?.pause(); audio?.removeAttribute('src'); audio?.load();
+    if (url) URL.revokeObjectURL(url); url = '';
+    state = { mediaId: '', currentTime: 0, duration: 0, paused: true, loading: false }; emit();
+  };
+  return {
+    element, reset, state: () => state,
+    subscribe: (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; },
+    async load(id: string) {
+      if (state.mediaId === id && !state.loading && url) return;
+      reset(); const current = revision;
+      state = { ...state, mediaId: id, loading: true }; emit();
+      try {
+        const bytes = await read(id);
+        if (current !== revision) throw Error('試聴する素材またはプロジェクトが変わりました。');
+        const el = element(); url = URL.createObjectURL(new Blob([bytes])); el.src = url;
+        await new Promise<void>((resolve, reject) => {
+          const finish = () => { el.removeEventListener('loadedmetadata', done); el.removeEventListener('error', failed); el.removeEventListener('emptied', changed); };
+          const done = () => { finish(); resolve(); };
+          const failed = () => { finish(); reject(Error('音声素材を再生できません。')); };
+          const changed = () => { if (current !== revision) { finish(); reject(Error('試聴が切り替わりました。')); } };
