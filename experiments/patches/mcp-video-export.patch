+import { GraphicDocumentSchema, outlinedGraphicNode, type GraphicDocument, type GraphicNode } from "../graphic.js";
+import { addClipCommand, replaceClip } from "./timeline-commands.js";
+import { findClip } from "../timeline.js";
+import type { Command } from "./editor-store.js";
+export function finishGraphicOutlineCommand(clipId:string,expected:GraphicNode,image:string):Command {
+    return {label:'文字を輪郭へ変換',apply(t){
+        const loc=findClip(t,clipId);
+        const d=loc && t.tracks[loc.trackIndex]!.clips[loc.clipIndex]!.graphic;
+        const current=d?.nodes.find(n=>n.id===expected.id);
+        if(!d || !current || JSON.stringify(current)!==JSON.stringify(expected))
+            throw Error('変換中に対象の文字が変更・削除されました。手直しを保持し、変換結果は反映しません。');
+        return setGraphicCommand(clipId,{...d,nodes:d.nodes.map(n=>n.id===expected.id?outlinedGraphicNode(n,image):n)}).apply(t);
+    }};
+}
+export function registerBrandKitCommand(clipId: string, name: string, id: string): Command {
+    if (!name.trim()) throw Error('素材名を入力してください');
+    return {label:'ブランド素材を登録',apply(t){
+        const loc=findClip(t,clipId); const clip=loc && t.tracks[loc.trackIndex]!.clips[loc.clipIndex]!;
+        if(!clip?.graphic)throw Error('グラフィックを選択してください');
+        if(t.brandKits?.some(k=>k.id===id))throw Error('素材IDが重複しています');
+        return {...t,brandKits:[...(t.brandKits??[]),{id,name:name.trim(),clip:structuredClone(clip)}]};
+    }};
+}
+export function applyBrandKitCommand(kitId:string,startFrame:number,clipId:string,newId:()=>string):Command {
+    if(!Number.isInteger(startFrame)||startFrame<0)throw Error('配置フレームは0以上の整数です');
+    return {label:'ブランド素材を配置',apply(t){
+        const kit=t.brandKits?.find(k=>k.id===kitId);
+        if(!kit?.clip.graphic)throw Error('ブランド素材がありません');
+        const next=addGraphicCommand(kit.clip.graphic,startFrame,kit.clip.durationFrames,clipId,newId).apply(t);
+        const {sceneGroup,linkGroupId,captionGroupId,...copy}=structuredClone(kit.clip);
+        return replaceClip(next,clipId,()=>({...copy,id:clipId,startFrame}));
+    }};
+}
+export function removeBrandKitCommand(kitId:string):Command {
+    return {label:'ブランド素材の登録を削除',apply(t){
+        if(!t.brandKits?.some(k=>k.id===kitId))throw Error('ブランド素材がありません');
+        return {...t,brandKits:t.brandKits.filter(k=>k.id!==kitId)};
+    }};
+}
+export function addGraphicCommand(input: GraphicDocument, startFrame: number, durationFrames: number, clipId: string, newId: () => string): Command {
+    const graphic = GraphicDocumentSchema.parse(input);
+    return { label: "グラフィックを追加", apply(t) { let first = true; const next = addClipCommand({ id: newId(), name: graphic.name, type: "text", source: { kind: "project", relativePath: "" }, duration: durationFrames / t.fps }, { kind: "new", index: 0 }, startFrame, t.fps, undefined, () => { if (first) {
+            first = false;
+            return clipId;
+        } return newId(); }).apply(t); return replaceClip(next, clipId, c => ({ ...c, textContent: graphic.name, graphic })); } };
+}
+export function setGraphicCommand(clipId: string, input: GraphicDocument): Command {
+    const graphic = GraphicDocumentSchema.parse(input);
+    return { label: "グラフィックを編集", apply(t) { const loc = findClip(t, clipId); if (!loc)
+            throw Error("クリップがありません"); if (t.tracks[loc.trackIndex]!.clips[loc.clipIndex]!.mediaType !== "text")
+            throw Error("グラフィックは文字クリップで編集します"); return replaceClip(t, clipId, c => ({ ...c, graphic })); } };
+}
+export function replaceGraphicImageCommand(clipId:string,nodeId:string,image:string):Command {
+    return {label:'画像パーツを差し替え',apply(t){
+        const loc=findClip(t,clipId);const clip=loc && t.tracks[loc.trackIndex]!.clips[loc.clipIndex]!;
+        const node=clip?.graphic?.nodes.find(n=>n.id===nodeId);
+        if(!node||node.kind!=='image')throw Error('差し替える画像パーツを選択してください');
+        const graphic=GraphicDocumentSchema.parse({...clip!.graphic,nodes:clip!.graphic!.nodes.map(n=>n.id===nodeId?{...n,image}:n)});
+        return replaceClip(t,clipId,c=>({...c,graphic}));
+    }};
+}
