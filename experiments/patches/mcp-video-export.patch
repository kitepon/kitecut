+import type { Clip } from "../clip.js";
+import type { Timeline } from "../timeline.js";
+import type { Command } from "./editor-store.js";
+import { expandToLinkGroup } from "../timeline/link-group.js";
+import { SceneBriefSchema, SceneBriefsSchema, type SceneBrief } from "../scene-brief.js";
+
+export function setSceneBriefsCommand(briefs: SceneBrief[]): Command {
+  const values = SceneBriefsSchema.parse(briefs);
+  if (!values.length) throw Error("保存する構成がありません");
+  return { label: "複数場面の構成を保存", apply(timeline) {
+    for (const value of values) members(timeline, value.sceneId);
+    const ids = new Set(values.map(value => value.sceneId));
+    return { ...timeline, sceneBriefs: [
+      ...(timeline.sceneBriefs ?? []).filter(value => !ids.has(value.sceneId)), ...values,
+    ] };
+  } };
+}
+
+export function setSceneBriefCommand(brief: SceneBrief): Command {
+  const value = SceneBriefSchema.parse(brief);
+  return { label: "場面の構成を保存", apply(timeline) {
+    members(timeline, value.sceneId);
+    return { ...timeline, sceneBriefs: [
+      ...(timeline.sceneBriefs ?? []).filter(b => b.sceneId !== value.sceneId), value,
+    ] };
+  } };
+}
+
+export function storyboardRows(timeline: Timeline) {
+  return sceneGroups(timeline).map(group => ({
+    ...group,
+    preserved: timeline.preservedSceneIds?.includes(group.id) ?? false,
+    brief: timeline.sceneBriefs?.find(b => b.sceneId === group.id),
+    sources: timeline.tracks.flatMap(track => track.clips
+      .filter(clip => clip.sceneGroup?.id === group.id)
+      .map(clip => ({
+        clipId: clip.id, mediaRef: clip.mediaRef, mediaType: clip.mediaType,
+        trackId: track.id, startFrame: clip.startFrame,
+        endFrame: clip.startFrame + clip.durationFrames,
+        sourceStartFrame: clip.trimStartFrame,
+        sourceEndFrame: clip.trimStartFrame + clip.durationFrames * clip.speed,
+        speed: clip.speed,
+      }))),
+  }));
+}
+
+export function sceneGroups(timeline: Timeline) {
+  const groups = new Map<string, { id: string; name: string; clipIds: string[]; startFrame: number; endFrame: number }>();
+  for (const track of timeline.tracks) for (const clip of track.clips) {
+    if (!clip.sceneGroup) continue;
+    let group = groups.get(clip.sceneGroup.id);
+    if (!group) { group = { ...clip.sceneGroup, clipIds: [], startFrame: clip.startFrame, endFrame: clip.startFrame + clip.durationFrames }; groups.set(group.id, group); }
+    group.clipIds.push(clip.id);
+    group.startFrame = Math.min(group.startFrame, clip.startFrame);
+    group.endFrame = Math.max(group.endFrame, clip.startFrame + clip.durationFrames);
+  }
+  return [...groups.values()].sort((a,b) => a.startFrame-b.startFrame || a.id.localeCompare(b.id));
+}
+
+function members(timeline: Timeline, groupId: string): Set<string> {
+  const group = sceneGroups(timeline).find(g => g.id === groupId);
+  if (!group) throw Error("場面がありません");
+  // 後から音声をリンクした場合も、場面移動で同期を壊さない。
+  const ids = expandToLinkGroup(timeline, new Set(group.clipIds));
+  if (timeline.tracks.some(t=>t.clips.some(c=>ids.has(c.id)&&c.sceneGroup&&c.sceneGroup.id!==groupId)))
+    throw Error("別の場面へのリンクがあります。リンクを解除してから操作してください");
+  return ids;
+}
+
+function mapClips(timeline: Timeline, ids: Set<string>, update: (clip: Clip) => Clip): Timeline {
+  return { ...timeline, tracks: timeline.tracks.map(track => ({ ...track, clips: track.clips.map(c => ids.has(c.id) ? update(c) : c) })) };
+}
+
+export function createSceneCommand(clipIds: string[], name: string, id: string): Command {
+  if (!name.trim() || !id) throw Error("場面の名前とIDが必要です");
+  return { label: "場面をまとめる", apply(timeline) {
+    const all = timeline.tracks.flatMap(t => t.clips);
+    if (clipIds.some(id => !all.some(c => c.id === id))) throw Error("選択したクリップがありません");
+    const ids = expandToLinkGroup(timeline, new Set(clipIds));
+    if (ids.size < 2) throw Error("二つ以上のクリップを選択してください");
+    if (all.some(c => ids.has(c.id) && c.sceneGroup)) throw Error("既存の場面を解除してからまとめてください");
+    if (all.some(c => c.sceneGroup?.id === id)) throw Error("場面IDが重複しています");
+    return mapClips(timeline, ids, c => ({ ...c, sceneGroup: { id, name: name.trim() } }));
+  } };
+}
+
+export function ungroupSceneCommand(groupId: string): Command {
+  return { label: "場面を解除", apply(timeline) {
+    members(timeline, groupId);
+    const next = mapClips(timeline, new Set(timeline.tracks.flatMap(t=>t.clips).filter(c=>c.sceneGroup?.id===groupId).map(c=>c.id)), c => {
+      const { sceneGroup: _, ...rest } = c; return rest;
+    });
+    return {...next,
+      ...(timeline.sceneBriefs ? {sceneBriefs: timeline.sceneBriefs.filter(b => b.sceneId !== groupId)} : {}),
+      ...(timeline.preservedSceneIds ? {preservedSceneIds: timeline.preservedSceneIds.filter(id => id !== groupId)} : {}),
+    };
+  } };
+}
+
+export function moveSceneCommand(groupId: string, startFrame: number): Command {
+  if (!Number.isInteger(startFrame) || startFrame < 0) throw Error("移動先は0以上の整数フレームにしてください");
+  return { label: "場面を移動", apply(timeline) {
+    const ids = members(timeline, groupId);
+    const clips = timeline.tracks.flatMap(t=>t.clips).filter(c=>ids.has(c.id));
+    const delta = startFrame - Math.min(...clips.map(c=>c.startFrame));
+    for (const track of timeline.tracks) for (const c of track.clips.filter(c=>ids.has(c.id))) {
+      const start = c.startFrame + delta, end = start + c.durationFrames;
+      if (track.clips.some(other => !ids.has(other.id) && other.startFrame < end && other.startFrame+other.durationFrames > start))
+        throw Error("移動先に別のクリップがあります。空いている位置へ移動してください");
+    }
+    return mapClips(timeline, ids, c=>({...c,startFrame:c.startFrame+delta}));
+  } };
+}
+
+export function duplicateSceneCommand(groupId: string, startFrame: number, newId: () => string): Command {
+  if (!Number.isInteger(startFrame) || startFrame < 0) throw Error("複製先は0以上の整数フレームにしてください");
+  return { label: "場面を複製", apply(timeline) {
+    const ids = members(timeline,groupId);
+    const clips = timeline.tracks.flatMap(t=>t.clips).filter(c=>ids.has(c.id));
+    const group = clips.find(c=>c.sceneGroup?.id===groupId)!.sceneGroup!;
+    const delta = startFrame-Math.min(...clips.map(c=>c.startFrame));
+    const copyGroup = {id:newId(),name:group.name+" のコピー"};
+    const brief = timeline.sceneBriefs?.find(b => b.sceneId === groupId);
+    const links = new Map<string,string>(), captions = new Map<string,string>();
+    function remap(map: Map<string,string>, id: string|undefined) { if(!id)return undefined; if(!map.has(id))map.set(id,newId());return map.get(id)!; }
+    // 同じトラックへ重ねて元の素材を消さず、各トラックの直上へ複製する。
+    return { ...timeline,
+      ...(brief ? {sceneBriefs: [...timeline.sceneBriefs!, {...brief, sceneId: copyGroup.id}]} : {}),
+      tracks: timeline.tracks.flatMap(track => {
+      const copied = track.clips.filter(c=>ids.has(c.id)).map(c=>({...structuredClone(c), id:newId(), startFrame:c.startFrame+delta,
+        sceneGroup:copyGroup, linkGroupId:remap(links,c.linkGroupId), captionGroupId:remap(captions,c.captionGroupId)}));
+      return copied.length ? [{...track,id:newId(),clips:copied},track] : [track];
+    }) };
+  } };
+}
+
+export function transformSceneCommand(groupId: string, x: number, y: number, scale: number): Command {
+  if (![x,y,scale].every(Number.isFinite) || scale<=0) throw Error("移動量は有限値、倍率は正の値にしてください");
+  return { label: "場面の位置と拡縮", apply(timeline) {
+    const ids = members(timeline,groupId);
+    // 画面中心を基準とした等方拡縮。既存の位置・大きさの動きにも同じ変換を適用する。
+    const px=(n:number)=>(n-.5)*scale+.5+x, py=(n:number)=>(n-.5)*scale+.5+y;
+    return mapClips(timeline,ids,c=>c.mediaType==='audio'?c:{...c,
+      transform:{...c.transform,centerX:px(c.transform.centerX),centerY:py(c.transform.centerY),width:c.transform.width*scale,height:c.transform.height*scale},
+      positionTrack:c.positionTrack?{keyframes:c.positionTrack.keyframes.map(k=>({...k,value:{a:px(k.value.a),b:py(k.value.b)}}))}:undefined,
+      scaleTrack:c.scaleTrack?{keyframes:c.scaleTrack.keyframes.map(k=>({...k,value:{a:k.value.a*scale,b:k.value.b*scale}}))}:undefined,
+    });
+  } };
+}
