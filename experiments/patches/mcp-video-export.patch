+const empty: AudioUsage = { purpose: 'effect', tags: [], source: '', author: '', license: '', commercialUse: 'unknown', redistribution: 'unknown', attribution: '', notes: '' };
+type Preview = ReturnType<typeof createAudioPreview>;
+function SharedPlayer({ preview }: { preview: Preview }) {
+  const host = useRef<HTMLDivElement>(null);
+  useEffect(() => { const el = preview.element(); host.current!.append(el); return () => { el.remove(); }; }, [preview]);
+  return <div ref={host}/>;
+}
+const emptyPreview = { mediaId: '' };
+export function AudioLibraryTab({ store, executor, library }: { store: EditorStore; executor: CaptionsExecutor; library: { getSnapshot(): { entries: MediaManifestEntry[] }; subscribe(cb: () => void): () => void; audioPreview?: Preview } }) {
