new file mode 100644
index 0000000..1761acc
--- /dev/null
+++ b/apps/desktop/src/main/graphic-outline.cjs
@@ -0,0 +1,34 @@
+"use strict";
+const fs=require("node:fs/promises"),path=require("node:path"),os=require("node:os");
+const {execFile}=require("node:child_process");const {promisify}=require("node:util");const run=promisify(execFile);
+const xml=v=>String(v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&apos;"}[c]));
+
+async function outlineText(n,fontsDir){
+ const catalog=JSON.parse(await fs.readFile(path.join(fontsDir,"catalog.json"),"utf8"));
+ const family=catalog.fonts.find(f=>f.family===n.fontFamily);
+ const fallback=catalog.fonts.find(f=>f.family===(n.fontFallbackFamily||'Noto Sans JP'));
+ if(n.kind!=="text"||!family)throw Error("同梱されていない書体は輪郭化できません");
+ if(!fallback)throw Error('代替書体が同梱されていません');
+ for(const key of ["width","height","fontSize","fontWeight","letterSpacing","lineHeight","baseline"])if(!Number.isFinite(n[key]))throw Error("文字設定が不正です: "+key);
+ const temp=await fs.mkdtemp(path.join(os.tmpdir(),"frontstage-outline-"));
+ try{
+  for(const file of new Set([...family.files,...fallback.files]))await fs.copyFile(path.join(fontsDir,file),path.join(temp,file));
+  const config=path.join(temp,"fonts.conf");await fs.writeFile(config,'<?xml version="1.0"?><!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd"><fontconfig><dir>'+xml(temp.replaceAll("\\","/"))+'</dir><cachedir>'+xml(temp.replaceAll("\\","/"))+'/cache</cachedir></fontconfig>');
+  const x=n.align==="center"?n.width/2:n.align==="right"?n.width:0;const anchor=n.align==="center"?"middle":n.align==="right"?"end":"start";
+  const a=n.gradient?n.gradient.angle*Math.PI/180:0,dx=Math.cos(a)*n.width/2,dy=Math.sin(a)*n.height/2;
+  const gradient=n.gradient?'<linearGradient id="paint" gradientUnits="userSpaceOnUse" x1="'+(n.width/2-dx)+'" y1="'+(n.height/2-dy)+'" x2="'+(n.width/2+dx)+'" y2="'+(n.height/2+dy)+'"><stop stop-color="'+xml(n.gradient.from)+'"/><stop offset="1" stop-color="'+xml(n.gradient.to)+'"/></linearGradient>':'';
+  let lines;
+  if(n.glyphOffsets?.length){
+   if(!Array.isArray(n.glyphLayout))throw Error('文字位置の計測結果がありません');
+   lines=n.glyphLayout.map(g=>{if(typeof g.text!=='string'||!Number.isFinite(g.x)||!Number.isFinite(g.y))throw Error('文字位置の計測結果が不正です');return '<text text-anchor="start" x="'+g.x+'" y="'+(n.baseline+g.y)+'">'+xml(g.text)+'</text>';}).join('');
+  }else lines=String(n.text??'').split(/\r?\n/).map((s,i)=>'<text x="'+x+'" y="'+(n.baseline+i*n.fontSize*n.lineHeight)+'">'+xml(s)+'</text>').join('');
+  const families=[...new Set([family.family,fallback.family])].map(f=>'"'+f+'"').join(',');
+  const svg='<svg xmlns="http://www.w3.org/2000/svg" width="'+n.width+'" height="'+n.height+'" viewBox="0 0 '+n.width+' '+n.height+'"><defs>'+gradient+'</defs><g font-family="'+xml(families)+'" font-size="'+n.fontSize+'" font-weight="'+n.fontWeight+'" letter-spacing="'+n.letterSpacing+'" text-anchor="'+anchor+'" fill="'+(n.gradient?'url(#paint)':xml(n.fill))+'" stroke="'+xml(n.stroke)+'" stroke-width="'+n.strokeWidth+'" paint-order="stroke fill">'+lines+'</g></svg>';
+  const input=path.join(temp,"text.svg"),output=path.join(temp,"outline.svg");await fs.writeFile(input,svg);
+  const executable=process.platform==="win32"?path.join(process.env.ProgramFiles||"C:/Program Files","Inkscape/bin/inkscape.com"):"inkscape";
+  await run(executable,[input,"--export-text-to-path","--export-plain-svg","--export-filename="+output],{windowsHide:true,env:{...process.env,FONTCONFIG_FILE:config},maxBuffer:2**20});
+  const result=await fs.readFile(output,"utf8");if(/<text[\s>]/.test(result)||!/<path[\s>]/.test(result))throw Error("Inkscapeが文字を輪郭へ変換できませんでした");
+  return "data:image/svg+xml;base64,"+Buffer.from(result).toString("base64");
+ }finally{await fs.rm(temp,{recursive:true,force:true});}
+}
+module.exports={outlineText};
