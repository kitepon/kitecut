diff --git a/apps/desktop/src/renderer/video-search.ts b/apps/desktop/src/renderer/video-search.ts
new file mode 100644
index 0000000..3df1f73
--- /dev/null
+++ b/apps/desktop/src/renderer/video-search.ts
@@ -0,0 +1,52 @@
+import { addClipCommand, type EditorStore, type MediaManifestEntry } from '@frontstage/core';
+export type SearchInput = { mediaId: string; query: string; startSeconds: number; endSeconds: number };
+export type SearchSegment = { startSeconds: number; endSeconds: number; observation: string; uncertainty: string };
+export type SearchResult = { segments: SearchSegment[]; model: string; revision: string; evidenceType: 'visual'; rawAnswer: string; modelLoadSeconds: number; inferenceSeconds: number };
+type State = { status: 'idle' | 'running' | 'completed' | 'failed' | 'cancelling' | 'cancelled'; input?: SearchInput; result?: SearchResult; error?: string; requestSeconds?: number; clipIds?: string[] };
+declare global { interface Window { desktopVideoSearch: { search(input: Omit<SearchInput, 'mediaId'> & { path: string }): Promise<SearchResult>; cancel(): Promise<void> } } }
+export function createVideoSearch(store: EditorStore, entryFor: (id: string) => MediaManifestEntry | undefined, resolvePath: (id: string) => string | null, save: () => Promise<unknown>) {
+  let state: State = { status: 'idle' }, sourcePath: string | null = null;
+  const listeners = new Set<() => void>();
+  const update = (value: State) => { state = value; listeners.forEach(listener => listener()); };
+  return {
+    state: () => state,
+    subscribe: (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; },
+    start(input: SearchInput) {
+      if (state.status === 'running' || state.status === 'cancelling') throw Error('場面検索を実行中です。');
+      const entry = entryFor(input.mediaId), path = resolvePath(input.mediaId);
+      if (!entry || entry.type !== 'video' || !path) throw Error('検索する動画素材を選んでください。');
+      if (!input.query.trim() || !Number.isFinite(input.startSeconds) || !Number.isFinite(input.endSeconds) || input.startSeconds < 0 || input.endSeconds <= input.startSeconds || input.endSeconds > entry.duration) throw Error('探す場面と、素材内の開始・終了秒を指定してください。');
+      sourcePath = path;
+      const started = performance.now();
+      update({ status: 'running', input });
+      void window.desktopVideoSearch.search({ path, query: input.query, startSeconds: input.startSeconds, endSeconds: input.endSeconds }).then(
+        result => update({ status: state.status === 'cancelling' ? 'cancelled' : 'completed', input, result, requestSeconds: (performance.now() - started) / 1000 }),
+        error => update({ status: state.status === 'cancelling' ? 'cancelled' : 'failed', input, error: String(error), requestSeconds: (performance.now() - started) / 1000 }));
+      return state;
+    },
+    async cancel() { if (state.status !== 'running') return state; update({ ...state, status: 'cancelling' }); await window.desktopVideoSearch.cancel(); return state; },
+    async apply({ segmentIndex, startFrame, startSeconds, endSeconds }: { segmentIndex: number; startFrame: number; startSeconds?: number; endSeconds?: number }) {
+      const segment = state.result?.segments[segmentIndex], input = state.input;
+      if (state.status !== 'completed' || !segment || !input) throw Error('配置する検索結果を選んでください。');
+      const entry = entryFor(input.mediaId);
+      if (!entry || resolvePath(input.mediaId) !== sourcePath) throw Error('検索元の素材を現在のプロジェクトで参照できません。');
+      const a = startSeconds ?? segment.startSeconds, b = endSeconds ?? segment.endSeconds;
+      if (![a, b, startFrame].every(Number.isFinite) || a < 0 || b <= a || b > entry.duration || !Number.isInteger(startFrame) || startFrame < 0) throw Error('素材内の開始・終了秒と、配置フレームを指定してください。');
+      const timeline = store.getSnapshot().timeline;
+      const trim = Math.round(a * timeline.fps), duration = Math.round(b * timeline.fps) - trim;
+      if (duration < 1) throw Error('配置区間を1フレーム以上にしてください。');
+      const oldIds = new Set(timeline.tracks.flatMap(track => track.clips.map(clip => clip.id)));
+      const added = addClipCommand(entry, { kind: 'new', index: 0 }, startFrame, timeline.fps, undefined, undefined, duration).apply(timeline);
+      const ids: string[] = [];
+      const next = { ...added, tracks: added.tracks.map(track => ({ ...track, clips: track.clips.map(clip => {
+        if (oldIds.has(clip.id)) return clip;
+        ids.push(clip.id);
+        return { ...clip, trimStartFrame: trim, trimEndFrame: Math.round(entry.duration * timeline.fps) - trim - duration };
+      }) })) };
+      store.dispatch({ label: '検索した場面を配置', apply: () => next });
+      await save();
+      update({ ...state, clipIds: ids });
+      return { clipIds: ids, startFrame, durationFrames: duration, trimStartFrame: trim };
+    },
+  };
+}
