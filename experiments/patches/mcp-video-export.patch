+++ b/apps/desktop/src/renderer/hardware-h264-sink.ts
@@ -0,0 +1,72 @@
+import type { PushFrameSource } from "@frontstage/engine";
+import { FfmpegIpcSink, type DesktopExportBridge, type FfmpegIpcSinkOptions } from "./ffmpeg-sink.js";
+
+// GPU上のフレームをH.264へ圧縮してからIPCへ送る。音声と保存契約は共通のFFmpeg接続を使う。
+export class HardwareH264IpcSink extends FfmpegIpcSink {
+  private encoder?: VideoEncoder;
+  private encoderError?: Error;
+  private pending = Promise.resolve();
+  private wake?: () => void;
+  private streamStarted = false;
+
+  constructor(bridge: DesktopExportBridge, opts: FfmpegIpcSinkOptions & { bitrateMbps?: number }) {
+    super(bridge, { ...opts, codec: "h264_copy" });
+    this.bitrateMbps = opts.bitrateMbps;
+  }
+  private readonly bitrateMbps?: number;
+  async configure(opts: { width: number; height: number; fps: number; audio?: { sampleRate: number; channels: number } }): Promise<void> {
+    const config: VideoEncoderConfig = {
+      codec: "avc1.640033", width: opts.width, height: opts.height, framerate: opts.fps,
+      bitrate: Math.round(this.bitrateMbps !== undefined ? this.bitrateMbps * 1_000_000 : opts.width * opts.height * opts.fps * 0.2),
+      hardwareAcceleration: "prefer-hardware", latencyMode: "realtime", avc: { format: "annexb" },
+    };
+    const support = await VideoEncoder.isConfigSupported(config);
+    if (!support.supported) throw new Error("この環境では指定解像度のGPU H.264書出しを利用できません");
+    this.encoder = new VideoEncoder({
+      output: (chunk, metadata) => {
+        const bytes = new Uint8Array(chunk.byteLength);
+        chunk.copyTo(bytes);
+        this.pending = this.pending.then(async () => {
+          if (!this.streamStarted) {
+            const videoColorSpace = metadata?.decoderConfig?.colorSpace;
+            if (!videoColorSpace) throw new Error('GPU圧縮器が出力の色情報を返しませんでした');
+            await super.configure({ ...opts, videoColorSpace });
+            this.streamStarted = true;
+          }
+          await this.bridge.videoFrame(bytes);
+        }).catch(error => {
+          this.encoderError = error instanceof Error ? error : new Error(String(error));
+        });
+      },
+      error: error => { this.encoderError = error; this.wake?.(); },
+    });
+    this.encoder.addEventListener("dequeue", () => this.wake?.());
+    this.encoder.configure(config);
+  }
+  async ready(): Promise<void> {
+    while (this.encoder!.encodeQueueSize > 2 && !this.encoderError) {
+      await new Promise<void>(resolve => { this.wake = resolve; });
+    }
+    this.wake = undefined;
+    await this.pending;
+    if (this.encoderError) throw this.encoderError;
+  }
+  async pushFrame(source: PushFrameSource): Promise<void> {
+    if (this.encoderError) throw this.encoderError;
+    const frame = new VideoFrame(source.offscreen, { timestamp: source.timestampUs, duration: source.durationUs });
+    try { this.encoder!.encode(frame, { keyFrame: source.keyFrame }); }
+    finally { frame.close(); }
+  }
+  async finalize(): Promise<undefined> {
+    await this.encoder!.flush();
+    await this.pending;
+    if (this.encoderError) throw this.encoderError;
+    this.encoder!.close();
+    return super.finalize();
+  }
+  async abort(): Promise<void> {
+    if (this.encoder && this.encoder.state !== "closed") this.encoder.close();
+    await this.pending;
+    await super.abort();
+  }
+}
