+import { test, expect } from 'vitest';
+import { EditorStore, TimelineSchema, ClipSchema, createSceneCommand } from '@frontstage/core';
+import { ToolExecutor } from '../src/tools/executor.js';
+import { sceneTools } from '../src/tools/scene-tools.js';
+import { historyTools } from '../src/tools/history-tools.js';
+import { GraphicDocumentSchema } from '@frontstage/core';
+
+test('構成生成を別モデルへ委譲する公開操作を持たない',()=>{
+  const names=sceneTools().map(tool=>tool.name);
+  expect(names).toContain('assemble_story_plan');
+  expect(names.some(name=>name.includes('local_story_plan'))).toBe(false);
+});
+
+test('操作者の構成案を直接組み立て、一回の履歴で動画を置き換える',async()=>{
+  const context={durationFrames:30,sceneSlots:['title'],factIds:[],evidence:[],fontFamilies:['Dela Gothic One'],colors:['#fffef9','#21222b'],requiredEvidenceIds:{}};
+  const draft={title:'案',scenes:[{id:'title',durationFrames:30,purpose:'見出し',copy:'字幕と一緒に',design:{fontFamily:'Dela Gothic One',textColor:'#21222b',backgroundColor:'#fffef9',headlinePosition:'center'},audio:{mode:'silent',notes:''},evidenceIds:[],sourceSelection:null}]};
+  const store=new EditorStore(TimelineSchema.parse({})), before=store.getSnapshot().timeline;
+  const graphics={title:GraphicDocumentSchema.parse({version:1,name:'見出し',width:before.width,height:before.height,nodes:[]})};
+  const executor=new ToolExecutor([...sceneTools(),...historyTools()],{store,newId:()=>crypto.randomUUID(),getManifest:()=>({version:2,entries:[],folders:[]}),storyGraphics:async()=>graphics});
+  expect((await executor.execute('assemble_story_plan',{context,draft:{...draft,scenes:[]},fps:30,sources:[]})).isError).toBe(true);
+  expect(store.getSnapshot().timeline).toBe(before);
+  const response=await executor.execute('assemble_story_plan',{context,draft,fps:30,sources:[]});
+  expect(response.isError,JSON.stringify(response)).toBe(false);
+  expect(store.getSnapshot().timeline.tracks[0]!.clips[0]!.durationFrames).toBe(30);
+  await executor.execute('undo_edit',{});expect(store.getSnapshot().timeline).toBe(before);
+});
+
+test('公開操作で構成を保存・取得・取り消しでき、不正な場面は変更前に失敗する',async()=>{
+  const clip=(id:string,startFrame:number)=>ClipSchema.parse({id,mediaRef:'m',mediaType:'video',sourceClipType:'video',startFrame,durationFrames:30});
+  const store=new EditorStore(createSceneCommand(['a','b'],'実演','scene').apply(TimelineSchema.parse({tracks:[{id:'v',type:'video',clips:[clip('a',0),clip('b',40)]}]})));
+  const executor=new ToolExecutor([...sceneTools(),...historyTools()],{store,newId:()=>crypto.randomUUID(),getManifest:()=>({version:2,entries:[],folders:[]})});
+  const brief={sceneId:'scene',purpose:'実演',copy:'字幕といっしょに。',audioNotes:'音声を優先'};
+  expect((await executor.execute('set_scene_brief',brief)).isError).toBe(false);
+  const result=await executor.execute('get_storyboard',{});
+  expect(result.isError).toBe(false);
+  expect(result.blocks[0]).toMatchObject({kind:'text',text:expect.stringContaining('字幕といっしょに。')});
+  const saved=store.getSnapshot().timeline;
+  expect((await executor.execute('set_scene_brief',{...brief,sceneId:'missing'})).isError).toBe(true);
+  expect(store.getSnapshot().timeline).toBe(saved);
+  await executor.execute('undo_edit',{});expect(store.getSnapshot().timeline.sceneBriefs).toBeUndefined();
+  await executor.execute('redo_edit',{});expect(store.getSnapshot().timeline).toBe(saved);
+});
+
+test('複数場面の構成を原子的に保存し、保持指定・不明な場面では履歴も変更しない',async()=>{
+  const clips=['a','b'].map((id,i)=>ClipSchema.parse({id,mediaRef:'m',mediaType:'video',sourceClipType:'video',startFrame:i*30,durationFrames:30,sceneGroup:{id,name:id}}));
+  const store=new EditorStore(TimelineSchema.parse({tracks:[{id:'v',type:'video',clips}]}));
+  const executor=new ToolExecutor([...sceneTools(),...historyTools()],{store,newId:()=>crypto.randomUUID(),getManifest:()=>({version:2,entries:[],folders:[]})});
+  const briefs=['a','b'].map(sceneId=>({sceneId,purpose:'実演',copy:sceneId,audioNotes:'元音声'}));
+  const original=store.getSnapshot().timeline;
+  expect((await executor.execute('set_scene_briefs',{briefs:[briefs[0],{...briefs[1],sceneId:'missing'}]})).isError).toBe(true);
+  expect(store.getSnapshot().timeline).toBe(original);
+  expect((await executor.execute('set_scene_briefs',{briefs})).isError).toBe(false);
+  const saved=TimelineSchema.parse(JSON.parse(JSON.stringify(store.getSnapshot().timeline)));
+  expect(saved.sceneBriefs).toEqual(briefs);
+  await executor.execute('undo_edit',{});expect(store.getSnapshot().timeline).toBe(original);
+  await executor.execute('redo_edit',{});expect(store.getSnapshot().timeline).toEqual(saved);
+  store.dispatch({label:'保持指定',apply:t=>({...t,preservedSceneIds:['b']})});
+  const protectedState=store.getSnapshot().timeline;
+  expect((await executor.execute('set_scene_briefs',{briefs:briefs.map(b=>({...b,copy:'更新'}))})).isError).toBe(true);
+  expect(store.getSnapshot().timeline).toBe(protectedState);
+  store.undo();expect(store.getSnapshot().timeline).toEqual(saved);
+});
