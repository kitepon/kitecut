+import { test, expect } from 'vitest';
+import { EditorStore, defaultTimeline, TimelineSchema } from '@frontstage/core';
+import { buildCatalog, ToolExecutor } from '../src/index.js';
+
+test('音の利用条件は保存形式を通り、共通履歴で取り消し・やり直しできる', async () => {
+  const store = new EditorStore(defaultTimeline());
+  const executor = new ToolExecutor(buildCatalog(), { store, newId: () => 'id', getManifest: () => ({ version: 2, folders: [], entries: [
+    { id: 'a', type: 'audio', name: '締めの音', duration: 1, source: { kind: 'project', relativePath: 'a.wav' } },
+    { id: 'b', type: 'audio', name: '未確認の音', duration: 1, source: { kind: 'project', relativePath: 'b.wav' } },
+  ] }) });
+  const usage = { purpose: 'effect', tags: ['締め', '短い'], source: '自作', author: '作者', license: '自作素材', commercialUse: 'allowed', redistribution: 'prohibited', attribution: '作者名', notes: '個別に確認した条件' };
+  expect((await executor.execute('set_audio_usage', { mediaId: 'a', usage })).isError).toBe(false);
+  expect(TimelineSchema.parse(JSON.parse(JSON.stringify(store.getSnapshot().timeline))).audioLibrary?.a).toEqual(usage);
+  store.undo(); expect(store.getSnapshot().timeline.audioLibrary).toBeUndefined();
+  store.redo(); expect(store.getSnapshot().timeline.audioLibrary?.a).toEqual(usage);
+  const list = async (filter: object) => {
+    const result = await executor.execute('list_audio_library', filter);
+    const block = result.blocks.find(b => b.kind === 'text');
+    return JSON.parse(block?.kind === 'text' ? block.text : '').entries;
+  };
