+      if (!ctx.audioPreview) throw Error('素材試聴が接続されていません。');
+      const a = args as { action: string; mediaId?: string; seconds?: number }, p = ctx.audioPreview;
+      if (a.action === 'load') { if (!a.mediaId) throw Error('mediaIdが必要です。'); await p.load(a.mediaId); }
+      if (a.action === 'play') await p.play();
+      if (a.action === 'pause') p.pause();
+      if (a.action === 'seek') { if (a.seconds === undefined) throw Error('secondsが必要です。'); p.seek(a.seconds); }
+      return ok(JSON.stringify(p.state()));
+    } },
+    { name: 'inspect_audio_levels', description: '音声素材をデコードし、各チャンネルのサンプルピークとRMSをdBFSで返す。nullは無音。fullScaleSamplesは絶対値1以上のサンプル数。聴感音量やtrue peakではなく、編集音量は変更しない。', inputSchema: z.object({ mediaId: z.string() }), async run(args, ctx) {
+      if (!ctx.inspectAudioLevels) throw Error('音声レベル解析が接続されていません。');
+      return ok(JSON.stringify(await ctx.inspectAudioLevels((args as { mediaId: string }).mediaId)));
+    } },
+    { name: 'set_audio_usage', description: '音声素材の用途・出典・利用条件を記録する。条件は操作者が確認した内容を入力し、未確認はunknownにする。GUIと共有し、一回で取り消せる。',
+      inputSchema: z.object({ mediaId: z.string(), usage: AudioUsageSchema }), run(args, ctx) {
+        const { mediaId, usage } = args as { mediaId: string; usage: z.infer<typeof AudioUsageSchema> };
+        const entry = ctx.getManifest().entries.find(e => e.id === mediaId);
+        if (entry?.type !== 'audio') throw Error('音声素材を選んでください。');
+        ctx.store.dispatch({ label: '音の用途と利用条件を記録', apply: timeline => ({ ...timeline, audioLibrary: { ...timeline.audioLibrary, [mediaId]: usage } }) });
+        return ok(JSON.stringify({ mediaId, usage }));
+      } },
+    { name: 'list_audio_library', description: 'プロジェクトの音声素材を用途・出典・利用条件とともに読む。queryは名前・タグ・出典・利用条件へ部分一致。条件が未確認の素材を許可済みとして返さない。',
+      inputSchema: z.object({ query: z.string().optional(), purpose: z.enum(['music', 'effect', 'speech']).optional(), commercialUse: z.enum(['unknown', 'allowed', 'prohibited']).optional(), redistribution: z.enum(['unknown', 'allowed', 'prohibited']).optional() }),
+      run(args, ctx) {
+        const filter = args as { query?: string; purpose?: string; commercialUse?: string; redistribution?: string };
+        const usage = ctx.store.getSnapshot().timeline.audioLibrary ?? {};
+        const entries = ctx.getManifest().entries.filter(e => e.type === 'audio').map(e => ({ ...e, usage: usage[e.id] ?? null })).filter(e =>
+          (!filter.purpose || e.usage?.purpose === filter.purpose) &&
+          (!filter.commercialUse || (e.usage?.commercialUse ?? 'unknown') === filter.commercialUse) &&
+          (!filter.redistribution || (e.usage?.redistribution ?? 'unknown') === filter.redistribution) &&
+          (!filter.query || [e.name, e.usage?.source, e.usage?.license, ...(e.usage?.tags ?? [])].join(' ').toLocaleLowerCase().includes(filter.query.toLocaleLowerCase())));
+        return ok(JSON.stringify({ entries }));
+      } },
+  ];
+}
