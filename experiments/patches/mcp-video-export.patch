@@ -0,0 +1,57 @@
+import { z } from "zod";
+import { findClip } from "../timeline.js";
+import { lerpNumber, sampleTrack, type Keyframe } from "../keyframe.js";
+import { replaceClip } from "./timeline-commands.js";
+import type { Command } from "./editor-store.js";
+
+export const DuckingInputSchema = z.object({
+  clipIds: z.array(z.string()).min(1),
+  markerIds: z.array(z.string()).min(1),
+  reductionDb: z.number().finite().max(0),
+  attackFrames: z.number().int().nonnegative(),
+  releaseFrames: z.number().int().nonnegative(),
+});
+export type DuckingInput = z.infer<typeof DuckingInputSchema>;
+
+export function duckingCommand(input: DuckingInput): Command {
+  const args = DuckingInputSchema.parse(input);
+  return { label: "発話中のBGMを下げる", apply(timeline) {
+    const spans = args.markerIds.map(id => {
+      const marker = timeline.markers?.find(m => m.id === id);
+      if (!marker || marker.kind !== "speech" || marker.endFrame === undefined)
+        throw Error("終了時刻を持つ発話の目印を指定してください: " + id);
+      return { start: marker.frame, end: marker.endFrame };
+    });
+    let next = timeline;
+    for (const id of new Set(args.clipIds)) {
+      const loc = findClip(timeline, id);
+      if (!loc) throw Error("BGMクリップがありません: " + id);
+      const clip = timeline.tracks[loc.trackIndex]!.clips[loc.clipIndex]!;
+      if (clip.mediaType !== "audio") throw Error("BGMは音声クリップを選んでください");
+      const envelope = new Float64Array(clip.durationFrames);
+      for (const span of spans) {
+        const start = span.start - clip.startFrame;
+        const end = span.end - clip.startFrame;
+        const from = Math.max(0, start - args.attackFrames);
+        const until = Math.min(clip.durationFrames, end + args.releaseFrames);
+        for (let frame = from; frame < until; frame++) {
+          const strength = frame < start ? (frame - start + args.attackFrames) / args.attackFrames
+            : frame < end ? 1 : 1 - (frame - end + 1) / (args.releaseFrames + 1);
+          // 重なる発話は減衰を加算せず、より強い方を使う。
+          envelope[frame] = Math.max(envelope[frame]!, strength);
+        }
+      }
+      const keyframes: Keyframe<number>[] = [];
+      for (let frame = 0; frame < clip.durationFrames; frame++) {
+        const base = clip.volumeTrack ? sampleTrack(clip.volumeTrack, frame, 0, lerpNumber) : 0;
+        const key: Keyframe<number> = { frame, value: base + envelope[frame]! * args.reductionDb, interpolationOut: "linear" };
+        const a = keyframes[keyframes.length - 2], b = keyframes[keyframes.length - 1];
+        // 同一直線上の点だけを除き、既存の曲線を各フレームで保持する。
+        if (a && b && (b.value - a.value) * (key.frame - b.frame) === (key.value - b.value) * (b.frame - a.frame)) keyframes.pop();
+        keyframes.push(key);
+      }
+      next = replaceClip(next, id, current => ({ ...current, volumeTrack: { keyframes } }));
+    }
+    return next;
+  } };
+}
