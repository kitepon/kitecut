--- /dev/null
+++ b/packages/core/src/speech-markers.ts
@@ -0,0 +1,19 @@
+import type { Clip } from "./clip.js";
+import type { TranscriptionResult } from "./media/transcript.js";
+import type { TimingMarker } from "./timing-marker.js";
+
+export function speechMarkers(clip: Clip, fps: number, transcript: TranscriptionResult, newId: () => string): TimingMarker[] {
+  if (!(clip.speed > 0) || !(fps > 0)) throw Error("発話時刻を変換できない速度またはfpsです");
+  const sourceStart = clip.trimStartFrame / fps;
+  const sourceEnd = sourceStart + clip.durationFrames * clip.speed / fps;
+  const markers: TimingMarker[] = [];
+  for (const segment of transcript.segments) {
+    if (!Number.isFinite(segment.start) || !Number.isFinite(segment.end) || segment.end <= segment.start) throw Error("音声認識の区間時刻が不正です");
+    if (segment.end <= sourceStart || segment.start >= sourceEnd) continue;
+    const frame = clip.startFrame + Math.round((Math.max(sourceStart, segment.start) - sourceStart) * fps / clip.speed);
+    const endFrame = Math.min(clip.startFrame + clip.durationFrames, clip.startFrame + Math.round((Math.min(sourceEnd, segment.end) - sourceStart) * fps / clip.speed));
+    if (endFrame <= frame) continue;
+    markers.push({ id: newId(), kind: "speech", frame, endFrame, label: segment.text.trim() });
+  }
+  return markers.sort((a, b) => a.frame - b.frame);
+}
