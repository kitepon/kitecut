@@ -0,0 +1,22 @@
+export interface AudioLevels {
+  sampleRate: number;
+  durationSeconds: number;
+  channels: { peakDbfs: number | null; rmsDbfs: number | null; fullScaleSamples: number }[];
+}
+
+export function measureAudioLevels(channels: readonly Float32Array[], sampleRate: number): AudioLevels {
+  if (!channels.length || !channels[0]?.length || !Number.isFinite(sampleRate) || sampleRate <= 0) throw Error('解析する音声がありません。');
+  const frames = channels[0].length;
+  const db = (value: number) => value === 0 ? null : 20 * Math.log10(value);
+  return { sampleRate, durationSeconds: frames / sampleRate, channels: channels.map(samples => {
+    if (samples.length !== frames) throw Error('音声チャンネルの長さが一致しません。');
+    let peak = 0, energy = 0, fullScaleSamples = 0;
+    for (const value of samples) {
+      if (!Number.isFinite(value)) throw Error('音声に無効なサンプルがあります。');
+      const level = Math.abs(value);
+      peak = Math.max(peak, level); energy += value * value;
+      if (level >= 1) fullScaleSamples++;
+    }
+    return { peakDbfs: db(peak), rmsDbfs: db(Math.sqrt(energy / frames)), fullScaleSamples };
+  }) };
+}
