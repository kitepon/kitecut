+ const events:string[]=[];
+ const coordinator={
+  layersForScrub:async()=>{events.push('取得開始');await pending;return {layers:[{frame:0}],cleanup:()=>events.push('解放')};},
+  seekAllTo:vi.fn(async()=>{events.push('再生準備');}),primeAt:async()=>{},layersForPlayback:()=>[{frame:0}],clearPumpBuffers:()=>{},
+ };
+ Reflect.set(engine,'coordinator',coordinator);
+ vi.stubGlobal('requestAnimationFrame',vi.fn(()=>1));vi.stubGlobal('cancelAnimationFrame',vi.fn());
+ try{
+  const capture=engine.captureFrame(0);await Promise.resolve();engine.play();
+  await Promise.resolve();await Promise.resolve();
+  expect(coordinator.seekAllTo).not.toHaveBeenCalled();
+  release();await capture;await Reflect.get(engine,'decodeGate');
+  expect(events).toEqual(['取得開始','解放','再生準備']);
+ }finally{release();engine.pause();vi.unstubAllGlobals();}
+});
+
+function fixture() {
+  let drawn = -1;
+  const cleanup = vi.fn();
+  const renderer = {
+    composite: vi.fn(async (layers: { frame: number }[]) => { drawn = layers[0]!.frame; }),
+    readRGBA: vi.fn(async () => new Uint8Array([drawn, 0, 0, 255])),
+  };
+  const engine = Reflect.construct(PlaybackEngine, [renderer, {}]) as PlaybackEngine;
+  Reflect.set(engine, "timeline", { width: 1, height: 1, tracks: [{ clips: [{ startFrame: 0, durationFrames: 100 }] }] });
+  Reflect.set(engine, "coordinator", { layersForScrub: async (frame: number) => ({ layers: [{ frame }], cleanup }) });
+  return { engine, renderer, cleanup };
+}
+
+test("後続のシークが来ても取得要求のフレームを返す", async () => {
+  const { engine, cleanup } = fixture();
+  const capture = engine.captureFrame(7);
+  const later = engine.seek(8, "exact");
