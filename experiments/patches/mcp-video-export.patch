+export const localVideoSchema = z.object({
+  mediaId: z.string().min(1), prompt: z.string().trim().min(1), name: z.string().optional(),
+  server: z.string().url().default('http://127.0.0.1:8188'),
+  width: z.number().int().min(512).max(1280).multipleOf(32).default(768),
+  height: z.number().int().min(512).max(1280).multipleOf(32).default(768),
+  seed: z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER).default(42),
+  frames: z.number().int().min(5).max(241).refine(n => (n - 1) % 4 === 0, 'フレーム数は4の倍数に1を加えた値を指定してください。').default(121),
+  fps: z.number().int().min(1).max(60).default(24), steps: z.number().int().positive().max(100).default(20),
+});
+
+export function generateLocalVideoTool(): ToolSpec {
+  return {
+    name: 'generate_local_video',
+    description: '素材一覧の画像から、このPCのWan2.2で背景動画を生成する。動きはpromptに指定し、返った素材IDをget_mediaで確認して配置する。',
+    inputSchema: localVideoSchema,
+    async run(args, ctx) {
+      if (!ctx.generation?.localVideoImage) return errorResult('この環境ではローカル動画生成を利用できません。');
+      const input = localVideoSchema.parse(args);
+      const source = ctx.getManifest().entries.find(e => e.id === input.mediaId);
+      if (!source || source.type !== 'image') return errorResult('素材一覧の画像を指定してください。');
+      const startImage = await ctx.generation.localVideoImage(input.mediaId);
+      const endpoint = `comfyui:${input.server}`, duration = input.frames / input.fps;
+      const parameters = { ...input, kind: 'video' };
+      const placeholder = createPlaceholderEntry({ id: ctx.newId(), type: 'video', name: input.name ?? input.prompt.slice(0, 32), duration, ext: 'mp4',
+        genInput: { prompt: input.prompt, model: endpoint, parameters, duration, aspectRatio: `${input.width}:${input.height}`, numImages: 1, outputIndex: 0, createdAt: new Date().toISOString() } });
+      ctx.generation.addPlaceholder(placeholder);
+      const result = await ctx.generation.startJob({ modelEndpoint: endpoint, input: { ...parameters, startImage }, placeholders: [placeholder], model: 'Wan2.2 TI2V 5B', costCredits: 0 });
+      return 'error' in result ? errorResult(result.error) : ok(JSON.stringify({ assetId: placeholder.id, jobId: result.jobId, status: 'generating' }));
+    },
+  };
+}
