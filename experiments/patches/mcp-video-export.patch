+import { histogramYRGB, hueHistogram } from "@frontstage/core";
+
+// 元の全画素計算を専用スレッドへ移し、値と精度を保つ。
+self.onmessage = (event: MessageEvent<{ rgba: Uint8Array; width: number; height: number }>) => {
+  const { rgba, width, height } = event.data;
+  self.postMessage({ yrgb: histogramYRGB(rgba, width, height), hue: hueHistogram(rgba, width, height) });
+};
diff --git a/packages/ui/src/inspector/adjust/use-frame-histograms.ts b/packages/ui/src/inspector/adjust/use-frame-histograms.ts
new file mode 100644
index 0000000..11ffc70
--- /dev/null
+++ b/packages/ui/src/inspector/adjust/use-frame-histograms.ts
@@ -0,0 +1,62 @@
+import { useEffect, useState } from "react";
+import type { EditorStore } from "@frontstage/core";
+import type { PlaybackEngine } from "@frontstage/engine";
+
+type Histograms = { yrgb: { y: number[]; r: number[]; g: number[]; b: number[] }; hue: number[] };
+
+export function useFrameHistograms(store: EditorStore, engineRef: { current: PlaybackEngine | null } | undefined, enabled: boolean) {
+  const [value, setValue] = useState<Histograms>();
+  const [error, setError] = useState<string>();
+  useEffect(() => {
+    setValue(undefined);
+    setError(undefined);
+    if (!enabled) return;
+    const worker = new Worker(new URL("./histogram-worker.ts", import.meta.url), { type: "module" });
+    let disposed = false;
+    let failed = false;
+    let busy = false;
+    let dirty = false;
+    let raf = 0;
+    let sampledTimeline = store.getSnapshot().timeline;
+    let previous = store.getSnapshot();
+    const fail = (message: string) => {
+      if (disposed) return;
+      failed = true;
+      setError("色分布を取得できません: " + message);
+    };
+    const sample = async () => {
+      raf = 0;
+      if (disposed || failed || busy || !dirty) return;
+      const engine = engineRef?.current;
+      if (!engine) return;
+      busy = true;
+      dirty = false;
+      sampledTimeline = store.getSnapshot().timeline;
+      const { width, height } = engine;
+      try {
+        const rgba = await engine.readRGBA();
+        if (!disposed) worker.postMessage({ rgba, width, height }, [rgba.buffer]);
+      } catch (cause) { fail(String(cause)); }
+    };
+    const schedule = () => {
+      dirty = true;
+      if (!disposed && !failed && !busy && !raf) raf = requestAnimationFrame(() => { void sample(); });
+    };
+    worker.onmessage = (event: MessageEvent<Histograms>) => {
+      if (disposed) return;
+      busy = false;
+      if (sampledTimeline === store.getSnapshot().timeline) setValue(event.data);
+      // 未処理の再生位置を蓄積せず、処理中に更新された最新の画面だけを次に読む。
+      if (dirty) schedule();
+    };
+    worker.onerror = event => fail(event.message);
+    const unsubscribe = store.subscribe(() => {
+      const next = store.getSnapshot();
+      if (next.playhead !== previous.playhead || next.timeline !== previous.timeline || next.selection !== previous.selection) schedule();
+      previous = next;
+    });
+    schedule();
+    return () => { disposed = true; unsubscribe(); cancelAnimationFrame(raf); worker.terminate(); };
+  }, [store, engineRef, enabled]);
+  return { histogram: value?.yrgb, hueHistogram: value?.hue, histogramError: error };
+}
