+import {EffectsSection} from '../src/inspector/adjust/EffectsSection.js';
+vi.mock('../src/inspector/adjust/AdjustmentRow.js',()=>({AdjustmentRow:({label,value,onChange}:any)=><input aria-label={label} value={value??''} onChange={e=>onChange(Number(e.target.value))}/>}));
+
+test('GUIでマスクの幅を動かし、途中の表示とUndoを共有する',()=>{
+  const clip=ClipSchema.parse({id:'c',mediaRef:'m',mediaType:'video',startFrame:0,durationFrames:90});
+  const store=new EditorStore({...defaultTimeline(),tracks:[{id:'t',type:'video',muted:false,hidden:false,syncLocked:false,clips:[clip]}]});
+  render(<EffectsSection store={store} clipIds={['c']}/>);
+  fireEvent.click(screen.getByTestId('adjust-section-動画マスク'));
+  fireEvent.change(screen.getByLabelText('切り抜く形'),{target:{value:'1'}});
+  fireEvent.click(screen.getByLabelText('幅（素材幅の比率）を動かす'));
+  fireEvent.change(screen.getByLabelText('幅（素材幅の比率）'),{target:{value:'0'}});
+  act(()=>store.setPlayhead(30));
+  fireEvent.change(screen.getByLabelText('幅（素材幅の比率）'),{target:{value:'1'}});
+  act(()=>store.setPlayhead(15));
+  expect((screen.getByLabelText('幅（素材幅の比率）') as HTMLInputElement).value).toBe('0.5');
+  expect(buildRenderPlan(store.getSnapshot().timeline,15,new Map()).layers[0]!.effects![0]!.params.width!.value).toBe(0.5);
+  act(()=>store.undo());
+  expect((screen.getByLabelText('幅（素材幅の比率）') as HTMLInputElement).value).toBe('0');
+  cleanup();
+});
+
+test('GUIで任意パスを選び、編集とUndoを反映する',()=>{
+  const clip=ClipSchema.parse({id:'c',mediaRef:'m',mediaType:'video',startFrame:0,durationFrames:90});
+  const store=new EditorStore({...defaultTimeline(),tracks:[{id:'t',type:'video',muted:false,hidden:false,syncLocked:false,clips:[clip]}]});
