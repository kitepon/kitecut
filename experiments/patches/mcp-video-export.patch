+import { TextMotionSchema, textUnits } from './text-motion.js';
+import { PathRevealSchema } from './path-reveal.js';
+const number = z.number().finite();
+const paint = z.string().regex(/^(#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|transparent|none)$/);
+const motion = z.object({ keyframes: z.array(z.object({ frame: number.int().nonnegative(), value: number, interpolationOut: z.enum(["linear", "smooth", "hold"]) })) });
+const GraphicBaseNodeSchema = z.object({
+    fontFallbackFamily:z.string().min(1).default('Noto Sans JP'),
+    textMotion: TextMotionSchema.optional(),
+    glyphOffsets: z.array(z.object({index:number.int().nonnegative(),x:number,y:number})).optional(),
+    pathReveal: PathRevealSchema.optional(),
+    id: z.string().min(1), name: z.string(), kind: z.enum(["group", "text", "rect", "ellipse", "path", "image"]), parentId: z.string().optional(),
+    x: number.default(0), y: number.default(0), width: number.positive().default(400), height: number.positive().default(140),
+    rotation: number.default(0), scaleX: number.default(1), scaleY: number.default(1), skewX: number.default(0), opacity: number.min(0).max(1).default(1),
+    fill: paint.default("#fffef9"), stroke: paint.default("#ef8d32"), strokeWidth: number.nonnegative().default(0), radius: number.nonnegative().default(0),
+    gradient: z.object({ from: paint, to: paint, angle: number }).optional(), glow: z.object({ color: paint, blur: number.nonnegative() }).optional(),
+    mask: z.object({ kind: z.enum(["rect", "ellipse", "path"]), path: z.string().optional(), radius: number.nonnegative().optional() }).optional(),
+    text: z.string().optional(), role: z.enum(["logo", "heading", "caption"]).default("heading"), fontFamily: z.string().default("Dela Gothic One"), fontSize: number.positive().default(96), fontWeight: number.min(100).max(900).default(400), letterSpacing: number.default(0), lineHeight: number.positive().default(1.25), align: z.enum(["left", "center", "right"]).default("left"),
+    path: z.string().optional(), image: z.string().regex(new RegExp("^data:image/(png|jpeg|webp|svg[+]xml);base64,")).optional(),
+    motion: z.object({ x: motion.optional(), y: motion.optional(), rotation: motion.optional(), scaleX: motion.optional(), scaleY: motion.optional(), opacity: motion.optional() }).optional(),
+});
+export const GraphicNodeSchema=GraphicBaseNodeSchema.extend({outlineSource:GraphicBaseNodeSchema.optional()});
+export const GraphicDocumentSchema = z.object({ version: z.literal(1), name: z.string(), width: number.positive(), height: number.positive(), nodes: z.array(GraphicNodeSchema) }).superRefine((d, ctx) => {
+    const ids = new Map(d.nodes.map(n => [n.id, n]));
+    if (ids.size !== d.nodes.length)
+        ctx.addIssue({ code: "custom", message: "パーツIDが重複しています" });
+    for (const n of d.nodes) {
+        if(n.glyphOffsets && new Set(n.glyphOffsets.map(v=>v.index)).size!==n.glyphOffsets.length)
+            ctx.addIssue({code:'custom',message:'同じ文字位置の調整が重複しています'});
+        if (n.kind === "image" && !n.image)
+            ctx.addIssue({ code: "custom", message: "画像データがありません" });
+        if (n.kind === "path" && !n.path)
+            ctx.addIssue({ code: "custom", message: "パスがありません" });
+        if (n.mask?.kind === "path" && !n.mask.path)
+            ctx.addIssue({ code: "custom", message: "切り抜きのパスがありません" });
+        let p = n.parentId;
+        const seen = new Set([n.id]);
+        while (p) {
+            if (seen.has(p)) {
+                ctx.addIssue({ code: "custom", message: "グループが循環しています" });
+                break;
+            }
+            seen.add(p);
+            const parent = ids.get(p);
+            if (!parent || parent.kind !== "group") {
+                ctx.addIssue({ code: "custom", message: "親グループがありません" });
+                break;
+            }
+            p = parent.parentId;
+        }
+        for (const t of Object.values(n.motion ?? {})) {
+            if (t && t.keyframes.some((k, i) => i > 0 && k.frame <= t.keyframes[i - 1]!.frame))
+                ctx.addIssue({ code: "custom", message: "キーフレームは時刻順・重複なしで指定してください" });
+        }
+    }
+});
+export type GraphicNode = z.infer<typeof GraphicNodeSchema>;
+export type GraphicDocument = z.infer<typeof GraphicDocumentSchema>;
+export function graphicGlyphLayout(node:GraphicNode,measure:(text:string)=>number){
+    const glyphs:{text:string;index:number;x:number;y:number;motionIndex:number;originX:number}[]=[];
+    const offsets=new Map(node.glyphOffsets?.map(v=>[v.index,v]));
+    let index=0,motionIndex=0;
+    (node.text??'').split(/\r?\n/).forEach((line,row)=>{
+        const width=measure(line),left=node.align==='center'?(node.width-width)/2:node.align==='right'?node.width-width:0;
+        let prefix='';
+        for(const unit of textUnits(line,node.textMotion?.unit??'grapheme')){
+            const originX=left+measure(prefix+unit)-measure(unit);
+            for(const text of textUnits(unit,'grapheme')){
+                const offset=offsets.get(index);
+                glyphs.push({text,index:index++,x:left+measure(prefix+text)-measure(text)+(offset?.x??0),y:row*node.fontSize*node.lineHeight+(offset?.y??0),motionIndex,originX});
+                prefix+=text;
+            }
+            motionIndex++;
+        }
+    });
+    return glyphs;
+}
+export function graphicFontFamilies(node:Pick<GraphicNode,'fontFamily'|'fontFallbackFamily'>):string{
+    return [...new Set([node.fontFamily,node.fontFallbackFamily])].map(f=>JSON.stringify(f)).join(',');
+}
+export function outlinedGraphicNode(node:GraphicNode,image:string):GraphicNode{
+    if(node.kind!=='text')throw Error('文字パーツを選択してください');
+    if(node.textMotion)throw Error('文字ごとの登場を保持した輪郭化にはまだ対応していません。文字演出を解除してから輪郭化してください');
+    const {outlineSource:_,...source}=node;
+    return GraphicNodeSchema.parse({...node,kind:'image',image,gradient:undefined,strokeWidth:0,outlineSource:source});
+}
+export function restoreGraphicText(node:GraphicNode):GraphicNode{
+    if(!node.outlineSource||node.outlineSource.kind!=='text')throw Error('保存された元文字がありません');
+    return GraphicNodeSchema.parse({...node.outlineSource,id:node.id,parentId:node.parentId,x:node.x,y:node.y,width:node.width,height:node.height,rotation:node.rotation,scaleX:node.scaleX,scaleY:node.scaleY,skewX:node.skewX,opacity:node.opacity,motion:node.motion});
+}
+export function graphicNodeAt(n: GraphicNode, frame: number): GraphicNode {
+    const result = { ...n };
+    for (const key of ["x", "y", "rotation", "scaleX", "scaleY", "opacity"] as const) {
+        const track = n.motion?.[key];
+        if (track)
+            result[key] = sampleTrack(track, frame, n[key], lerpNumber);
+    }
+    return result;
+}
+export function createGraphic(name = "タイトル", text = "その瞬間を。", width = 1920, height = 1080): GraphicDocument {
+    return GraphicDocumentSchema.parse({ version: 1, name, width, height, nodes: [{ id: "title", name: "見出し", kind: "text", x: width * .08, y: height * .32, width: width * .84, height: height * .4, text, fontSize: 120 }] });
+}
+export function groupGraphicNodes(doc: GraphicDocument, ids: string[], id: string): GraphicDocument {
+    const chosen = doc.nodes.filter(n => ids.includes(n.id));
+    if (chosen.length !== ids.length || !chosen.length)
+        throw Error("まとめるパーツがありません");
+    const parentId = chosen[0]!.parentId;
+    if (chosen.some(n => n.parentId !== parentId))
+        throw Error("同じ親にあるパーツを選択してください");
+    const indices = chosen.map(n => doc.nodes.indexOf(n)).sort((a, b) => a - b);
+    const first = indices[0]!;
+    if (indices.some((v, i) => v !== first + i))
+        throw Error("重なり順を保つため、隣り合うパーツを選択してください");
+    const group = GraphicNodeSchema.parse({ id, name: "グループ", kind: "group", parentId, width: doc.width, height: doc.height });
+    const nodes = doc.nodes.map(n => ids.includes(n.id) ? { ...n, parentId: id } : n);
+    nodes.splice(first, 0, group);
+    return GraphicDocumentSchema.parse({ ...doc, nodes });
+}
