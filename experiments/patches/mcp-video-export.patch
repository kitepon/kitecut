diff --git a/packages/core/src/story-plan.ts b/packages/core/src/story-plan.ts
new file mode 100644
index 0000000..ad56364
--- /dev/null
+++ b/packages/core/src/story-plan.ts
@@ -0,0 +1,90 @@
+import { z } from "zod";
+
+const id = z.string().min(1);
+const frame = z.number().int().nonnegative().safe();
+const text = z.string().trim().min(1);
+const copy = z.string().refine(value => value.trim().length > 0, "コピーが空です");
+const uniqueIds = z.array(id).refine(values => new Set(values).size === values.length, "IDが重複しています");
+export const StoryPlanContextSchema = z.object({
+  durationFrames: frame.positive(),
+  sceneSlots: uniqueIds.refine(values => values.length > 0, "場面がありません"),
+  factIds: uniqueIds,
+  evidence: z.array(z.object({ id, startFrame: frame, endFrame: z.number().finite().nonnegative() }).strict()
+    .refine(value => value.startFrame < value.endFrame, "素材範囲が不正です"))
+    .refine(values => new Set(values.map(value => value.id)).size === values.length, "素材根拠IDが重複しています"),
+  fontFamilies: z.array(text).min(1),
+  colors: z.array(z.string().regex(/^#[0-9a-fA-F]{6}$/)).min(1),
+  requiredEvidenceIds: z.record(uniqueIds),
+  requiredCopies: z.record(copy).optional(),
+}).strict();
+
+export const StoryPlanDraftSchema = z.object({
+  title: text,
+  scenes: z.array(z.object({
+    id,
+    durationFrames: frame.positive(),
+    purpose: text,
+    copy,
+    design: z.object({
+      fontFamily: text,
+      textColor: z.string().regex(/^#[0-9a-fA-F]{6}$/),
+      backgroundColor: z.string().regex(/^#[0-9a-fA-F]{6}$/),
+      headlinePosition: z.enum(["top", "center", "bottom"]),
+    }).strict(),
+    audio: z.object({ mode: z.enum(["source", "silent", "music"]), notes: z.string() }).strict()
+      .refine(value => value.mode !== "music" || value.notes.trim().length > 0, "音楽の指示がありません"),
+    evidenceIds: uniqueIds,
+    sourceSelection: z.object({ evidenceId: id, startFrame: frame }).strict().nullable(),
+  }).strict()).min(1),
+}).strict();
+
+export type StoryPlanContext = z.infer<typeof StoryPlanContextSchema>;
+export type StoryPlanDraft = z.infer<typeof StoryPlanDraftSchema>;
+
+/** AIの判断を検証し、時刻・素材終了位置・構成保存命令を一意に組み立てる。 */
+export function compileStoryPlan(contextInput: unknown, draftInput: unknown) {
+  const context = StoryPlanContextSchema.parse(contextInput);
+  const draft = StoryPlanDraftSchema.parse(draftInput);
+  if (draft.scenes.length !== context.sceneSlots.length || draft.scenes.some((scene, index) => scene.id !== context.sceneSlots[index]))
+    throw Error("構成の場面IDと順序が入力に一致しません");
+  const evidence = new Map(context.evidence.map(item => [item.id, item]));
+  for (const sceneId of Object.keys(context.requiredCopies ?? {}))
+    if (!context.sceneSlots.includes(sceneId)) throw Error("指定コピーの場面が入力に存在しません");
+  const known = new Set([...context.factIds, ...evidence.keys()]);
+  if (known.size !== context.factIds.length + evidence.size) throw Error("商品と素材の根拠IDが重複しています");
+  for (const [sceneId, refs] of Object.entries(context.requiredEvidenceIds)) {
+    if (!context.sceneSlots.includes(sceneId) || refs.some(ref => !known.has(ref)))
+      throw Error("必須根拠の指定が入力に存在しません");
+  }
+  let cursor = 0;
+  const scenes = draft.scenes.map(scene => {
+    const requiredCopy = context.requiredCopies?.[scene.id];
+    if (requiredCopy !== undefined && scene.copy !== requiredCopy) throw Error(`${scene.id}: 必ず使うコピーと一致しません`);
+    if (scene.evidenceIds.some(ref => !known.has(ref))) throw Error(`${scene.id}: 不明な根拠があります`);
+    if ((context.requiredEvidenceIds[scene.id] ?? []).some(ref => !scene.evidenceIds.includes(ref)))
+      throw Error(`${scene.id}: 必須根拠が不足しています`);
+    if (!context.fontFamilies.includes(scene.design.fontFamily)) throw Error(`${scene.id}: 指定外の書体です`);
+    const colors = context.colors.map(color => color.toLowerCase());
+    if (![scene.design.textColor, scene.design.backgroundColor].every(color => colors.includes(color.toLowerCase())))
+      throw Error(`${scene.id}: 指定外の色です`);
+    const startFrame = cursor;
+    cursor += scene.durationFrames;
+    if (!Number.isSafeInteger(cursor) || cursor > context.durationFrames) throw Error("構成が指定尺を超えています");
+    let sourceRange = null;
+    if (scene.sourceSelection) {
+      const source = scene.sourceSelection, item = evidence.get(source.evidenceId);
+      const endFrame = source.startFrame + scene.durationFrames;
+      if (!item || !scene.evidenceIds.includes(source.evidenceId)) throw Error(`${scene.id}: 素材根拠がありません`);
+      if (!Number.isSafeInteger(endFrame) || source.startFrame < item.startFrame || endFrame > item.endFrame)
+        throw Error(`${scene.id}: 素材範囲を超えています`);
+      sourceRange = { evidenceId: source.evidenceId, startFrame: source.startFrame, endFrame };
+    } else if (scene.audio.mode === "source") throw Error(`${scene.id}: 元音声を再生する素材がありません`);
+    return { ...scene, startFrame, endFrame: cursor, sourceRange };
+  });
+  if (cursor !== context.durationFrames) throw Error("構成の長さが指定尺と一致しません");
+  const briefs = scenes.map(scene => ({
+    sceneId: scene.id, purpose: scene.purpose, copy: scene.copy,
+    audioNotes: [({source:"素材の音声を再生",silent:"無音",music:"音楽を使用"})[scene.audio.mode],scene.audio.notes.trim()].filter(Boolean).join("。"),
+  }));
+  return { title: draft.title, scenes, briefs };
+}
