+import { expect, test, vi } from "vitest";
+import { EditorStore, defaultTimeline, clipFromAsset, setClipPropertyCommand } from "@frontstage/core";
+import { beatTimingTools } from "../src/tools/beat-timing-tools.js";
+import { ToolExecutor } from "../src/tools/executor.js";
+
+function setup() {
+  const entry = { id: "music", name: "音楽", type: "audio" as const, duration: 10, source: { kind: "project" as const, relativePath: "music.wav" } };
+  const clip = clipFromAsset(entry, 30, 100, () => "clip");
+  clip.trimStartFrame = 60; clip.durationFrames = 30; clip.speed = 2;
+  const store = new EditorStore({ ...defaultTimeline(), tracks: [{ id: "track", type: "audio" as const, muted: false, hidden: false, syncLocked: true, clips: [clip] }] });
+  const executor = new ToolExecutor(beatTimingTools(), { store, getManifest: () => ({ version: 2, entries: [entry], folders: [] }), newId: () => crypto.randomUUID(), analyzeBeats: async () => [1, 2.5, 3.5, 4.5].map(seconds => ({ seconds, bpm: 120, confidence: 1 })) });
+  async function call(name: string, args: unknown) {
+    const response = await executor.execute(name, args);
+    if (response.isError) throw Error(JSON.stringify(response));
+    const text = response.blocks[0]!; if (text.kind !== "text") throw Error("文字応答がありません"); return JSON.parse(text.text);
+  }
+  return { store, call };
+}
+
+test("トリム・倍速の拍を作品時刻へ変換し、明示適用とUndoを共有する", async () => {
+  const f = setup(), before = f.store.getSnapshot().timeline;
+  const job = await f.call("analyze_beat_timing", { clipId: "clip" });
+  await vi.waitFor(async () => expect((await f.call("analyze_beat_timing", { jobId: job.jobId })).status).toBe("completed"));
+  expect(f.store.getSnapshot().timeline).toBe(before);
+  await f.call("apply_beat_timing", { jobId: job.jobId });
+  expect(f.store.getSnapshot().timeline.markers?.map(m => m.frame)).toEqual([108, 123]);
+  expect(f.store.getSnapshot().timeline.markers?.[0]?.label).toContain("240 BPM");
+  await f.call("apply_beat_timing", { jobId: job.jobId });
+  expect(f.store.getSnapshot().timeline.markers).toHaveLength(2);
+  f.store.undo(); expect(f.store.getSnapshot().timeline).toEqual(before);
+});
+
+test("解析後の位置変更には古い候補を適用しない", async () => {
+  const f = setup();
+  const job = await f.call("analyze_beat_timing", { clipId: "clip" });
+  await vi.waitFor(async () => expect((await f.call("analyze_beat_timing", { jobId: job.jobId })).status).toBe("completed"));
+  f.store.dispatch(setClipPropertyCommand("clip", "startFrame", 200));
+  await expect(f.call("apply_beat_timing", { jobId: job.jobId })).rejects.toThrow("再解析");
+  expect(f.store.getSnapshot().timeline.markers ?? []).toHaveLength(0);
+});
