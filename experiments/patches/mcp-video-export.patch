+    ClipSchema.parse({id: "t", mediaRef: "title", mediaType: "text", sourceClipType: "text", startFrame: 100, durationFrames: 30}),
+  ]}]});
+  return createSceneCommand(["v", "t"], "実演", "scene").apply(timeline);
+}
+const brief = {sceneId: "scene", purpose: "字幕と読み上げを伝える", copy: "その瞬間を、字幕といっしょに。", audioNotes: "実演音声を聞かせる"};
