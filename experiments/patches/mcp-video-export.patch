+import { decodeWavPcm16Mono } from "@frontstage/engine/audio/wav-encode.js";
+import type { BeatCandidate } from "@frontstage/engine/audio/beat-detection.js";
+
+export function makeBeatAnalyzer(extract: (mediaRef: string) => Promise<{ wav: Uint8Array }>) {
+  return async (mediaRef: string): Promise<BeatCandidate[]> => {
+    const decoded = decodeWavPcm16Mono((await extract(mediaRef)).wav);
+    const worker = new Worker(new URL("./beat-worker.ts", import.meta.url), { type: "module" });
+    try {
+      return await new Promise<BeatCandidate[]>((resolve, reject) => {
+        worker.onmessage = (event: MessageEvent<{ beats?: BeatCandidate[]; error?: string }>) => {
+          if (event.data.error) reject(new Error(event.data.error));
+          else if (event.data.beats) resolve(event.data.beats);
+          else reject(new Error("拍の解析結果がありません"));
+        };
+        worker.onerror = (event) => reject(new Error(event.message));
+        worker.postMessage({ pcm: decoded.samples, sampleRate: decoded.sampleRate }, [decoded.samples.buffer]);
+      });
+    } finally { worker.terminate(); }
+  };
+}
