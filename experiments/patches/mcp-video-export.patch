+import { expect, test } from "vitest";
+import { BEAT_SAMPLE_RATE, detectBeatCandidates } from "../src/audio/beat-detection.js";
+
+test("120BPMのクリックを、追跡が始まった後は一拍ずつ33ms以内で捉える", async () => {
+  const rate = BEAT_SAMPLE_RATE;
+  const pcm = new Float32Array(rate * 10);
+  for (let t = 0.5; t < 10; t += 0.5) {
+    for (let i = 0; i < rate * 0.03; i++) pcm[Math.round(t * rate) + i] = Math.sin(2 * Math.PI * 1000 * i / rate) * Math.exp(-i / (rate * 0.004));
+  }
+  const beats = await detectBeatCandidates(pcm, rate);
+  for (let t = 1.5; t < 10; t += 0.5) expect(beats.some(b => Math.abs(b.seconds - t) < 1 / 30)).toBe(true);
+  expect(beats.every(b => Math.abs((b.seconds - 0.5) * 2 - Math.round((b.seconds - 0.5) * 2)) < 2 / 30)).toBe(true);
+  expect(beats.every(b => Number.isFinite(b.confidence) && b.bpm > 0)).toBe(true);
+});
+
+test("無音には拍を追加しない", async () => {
+  expect(await detectBeatCandidates(new Float32Array(BEAT_SAMPLE_RATE * 4), BEAT_SAMPLE_RATE)).toEqual([]);
+});
