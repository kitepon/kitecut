@@ -0,0 +1,86 @@
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+import { HardwareH264IpcSink } from "../src/renderer/hardware-h264-sink.js";
+import { FfmpegIpcSink } from '../src/renderer/ffmpeg-sink.js';
+import type { PushFrameSource } from "@frontstage/engine";
+class Encoder {
+  static color: VideoColorSpaceInit | undefined;
+  static supported = true;
+  static last: Encoder;
+  static async isConfigSupported() { return { supported: Encoder.supported }; }
+  state = "configured";
+  encodeQueueSize = 0;
+  configure = vi.fn();
+  addEventListener = vi.fn();
+  close = vi.fn(() => { this.state = "closed"; });
+  async flush() {}
+  constructor(private init: { output: (chunk: unknown, metadata: unknown) => void }) { Encoder.last = this; }
+  encode() { this.init.output({ byteLength: 4, copyTo: (bytes: Uint8Array) => bytes.set([0, 0, 0, 1]) },{decoderConfig:{colorSpace:Encoder.color}}); }
+}
+beforeEach(() => {
+  Encoder.supported = true;
+  Encoder.color = {primaries:'bt709',transfer:'bt709',matrix:'bt709',fullRange:false};
+  vi.stubGlobal("VideoEncoder", Encoder);
+  vi.stubGlobal("VideoFrame", class { close() {} });
+});
+afterEach(() => vi.unstubAllGlobals());
+const config = { width: 1920, height: 1080, fps: 30 };
+test('音声の保存完了を待ち、保存失敗を呼出元へ返す',async()=>{
+ const {bridge}=setup();let complete!:()=>void;
+ bridge.audioData.mockImplementation(()=>new Promise<void>(resolve=>{complete=resolve;}));
+ const sink=new FfmpegIpcSink(bridge,{codec:'libx264',outPath:'audio.mp4'});
+ const data={numberOfFrames:4,numberOfChannels:1,copyTo:async(target:Float32Array)=>target.fill(.5)} as unknown as AudioData;
+ let settled=false;const pending=sink.pushAudioData(data).then(()=>{settled=true;});
+ await vi.waitFor(()=>expect(bridge.audioData).toHaveBeenCalledOnce());expect(settled).toBe(false);
+ complete();await pending;expect(settled).toBe(true);
+ bridge.audioData.mockRejectedValue(new Error('音声保存失敗'));await expect(sink.pushAudioData(data)).rejects.toThrow('音声保存失敗');
+});
+test("指定したWeb用ビットレートをGPU圧縮器へ渡す", async () => {
+  const { bridge } = setup();
+  const sink = new HardwareH264IpcSink(bridge, { codec: "libx264", outPath: "C:/project/web.mp4", bitrateMbps: 6 });
+  await sink.configure(config);
+  expect(Encoder.last.configure).toHaveBeenCalledWith(expect.objectContaining({ bitrate: 6_000_000 }));
+  await sink.abort();
+});
+function setup() {
+  const bridge = { start: vi.fn(async () => "session"), videoFrame: vi.fn(async (_data: Uint8Array) => {}), audioData: vi.fn(), finish: vi.fn(async () => "output"), cancel: vi.fn(async () => {}) };
+  return { bridge, sink: new HardwareH264IpcSink(bridge, { codec: "libx264", outPath: "C:/project/output.mp4" }) };
+}
+test("圧縮データの受渡しを完了してから保存を確定する", async () => {
+  const { bridge, sink } = setup();
+  let delivered!: () => void;
+  bridge.videoFrame.mockImplementation(() => new Promise<void>(resolve => { delivered = resolve; }));
+  await sink.configure(config);
+  expect(bridge.start).not.toHaveBeenCalled();
+  await sink.pushFrame({ offscreen: {}, timestampUs: 0, durationUs: 33333, keyFrame: true } as PushFrameSource);
+  const finish = sink.finalize();
+  await vi.waitFor(() => expect(bridge.videoFrame).toHaveBeenCalledOnce());
+  expect(bridge.start).toHaveBeenCalledWith(expect.objectContaining({codec:'h264_copy',videoColorSpace:Encoder.color}));
+  expect(bridge.videoFrame.mock.calls[0]![0].byteLength).toBe(4);
+  expect(bridge.finish).not.toHaveBeenCalled();
+  delivered();
+  await finish;
+  expect(bridge.finish).toHaveBeenCalledOnce();
+});
+test('色情報が欠けた圧縮結果を保存しない',async()=>{
+ const {bridge,sink}=setup();Encoder.color=undefined;
+ await sink.configure(config);
+ await sink.pushFrame({offscreen:{},timestampUs:0,durationUs:33333,keyFrame:true} as PushFrameSource);
+ await expect(sink.finalize()).rejects.toThrow('色情報');
+ expect(bridge.start).not.toHaveBeenCalled();expect(bridge.videoFrame).not.toHaveBeenCalled();
+ await sink.abort();
+});
+test("圧縮器非対応と転送失敗を完了扱いしない", async () => {
+  const first = setup(); Encoder.supported = false;
+  await expect(first.sink.configure(config)).rejects.toThrow("利用できません");
+  expect(first.bridge.start).not.toHaveBeenCalled();
+  Encoder.supported = true;
+  const { bridge, sink } = setup();
+  bridge.videoFrame.mockRejectedValue(new Error("転送失敗"));
+  await sink.configure(config);
+  await sink.pushFrame({ offscreen: {}, timestampUs: 0, durationUs: 33333, keyFrame: true } as PushFrameSource);
+  await expect(sink.finalize()).rejects.toThrow("転送失敗");
+  expect(bridge.finish).not.toHaveBeenCalled();
+  await sink.abort();
+  expect(Encoder.last.close).toHaveBeenCalledOnce();
+  expect(bridge.cancel).toHaveBeenCalledWith("session");
+});
