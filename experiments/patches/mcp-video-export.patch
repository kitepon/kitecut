+import { ClipSchema } from "../schema/schemas.js";
+import { compileStoryPlan } from "../story-plan.js";
+import { GraphicDocumentSchema, type GraphicDocument } from "../graphic.js";
+import type { Clip } from "../clip.js";
+import { sourceDurationFrames } from "../clip.js";
+import type { Track } from "../timeline.js";
+import type { Command } from "./editor-store.js";
+
+export interface StorySourceBinding { evidenceId: string; videoClipId: string; mediaId: string; audioClipId?: string; audioMediaId?: string }
+
+/** 構成の検証と素材の解決を終えてから、ひとつの履歴として組み立てる。 */
+export function assembleStoryCommand(input: {
+  context: unknown; draft: unknown; fps: number;
+  sources: StorySourceBinding[];
+  graphics: Record<string, GraphicDocument>;
+}, newId: () => string = () => crypto.randomUUID()): Command {
+  const plan = compileStoryPlan(input.context, input.draft);
+  const bindings = structuredClone(input.sources);
+  if (new Set(bindings.map(b => b.evidenceId)).size !== bindings.length)
+    throw Error("素材の割り当てが重複しています");
+  const graphics = Object.fromEntries(Object.entries(input.graphics).map(([id, graphic]) => [id, GraphicDocumentSchema.parse(graphic)]));
+  if (Object.keys(graphics).length !== plan.scenes.length || plan.scenes.some(s => !graphics[s.id]))
+    throw Error("全場面の文字と背景を用意してください");
+  return { label: "構成から動画を組み立て", apply(t) {
+    if (input.fps !== t.fps) throw Error("構成を作った時と動画のフレームレートが違います");
+    if (t.preservedSceneIds?.length) throw Error("保持指定のある場面を置き換えることはできません");
+    const clips = t.tracks.flatMap(track => track.clips);
+    const video: Clip[] = [], audio: Clip[] = [], titles: Clip[] = [];
+    for (const scene of plan.scenes) {
+      const graphic = graphics[scene.id]!;
+      if (graphic.width !== t.width || graphic.height !== t.height)
+        throw Error(`${scene.id}: グラフィックの寸法が動画に一致しません`);
+      const sceneGroup = { id: scene.id, name: scene.copy };
+      const base = { startFrame: scene.startFrame, durationFrames: scene.durationFrames, sceneGroup };
+      titles.push(ClipSchema.parse({ ...base, id: newId(), mediaRef: newId(), mediaType: "text", sourceClipType: "text", textContent: scene.copy, graphic }));
+      if (scene.audio.mode === "music") throw Error(`${scene.id}: 音楽素材の割り当てにまだ対応していません`);
+      if (!scene.sourceRange) continue;
+      const range = scene.sourceRange;
+      const binding = bindings.find(b => b.evidenceId === range.evidenceId);
+      const source = binding && clips.find(c => c.id === binding.videoClipId);
+      if (!source || source.mediaType !== "video") throw Error(`${scene.id}: 対応する動画素材がありません`);
+      if (source.mediaRef !== binding!.mediaId) throw Error(`${scene.id}: 構成に指定した動画素材が差し替わっています`);
+      if (!(source.speed > 0) || range.startFrame < source.trimStartFrame || range.endFrame > source.trimStartFrame + source.durationFrames * source.speed)
+        throw Error(`${scene.id}: 現在の動画素材の区間を超えています`);
+      const linkGroupId = scene.audio.mode === "source" ? newId() : undefined;
+      video.push(ClipSchema.parse({ ...base, id: newId(), mediaRef: source.mediaRef, mediaType: "video", sourceClipType: source.sourceClipType,
+        trimStartFrame: range.startFrame, trimEndFrame: sourceDurationFrames(source) - range.endFrame, transform: source.transform, crop: source.crop, linkGroupId }));
+      if (scene.audio.mode !== "source") continue;
+      const candidates = binding?.audioClipId ? clips.filter(c => c.id === binding.audioClipId)
+        : clips.filter(c => source.linkGroupId && c.linkGroupId === source.linkGroupId && c.mediaType === "audio");
+      if (candidates.length !== 1 || candidates[0]!.mediaType !== "audio") throw Error(`${scene.id}: 元音声を一意に選べません`);
+      const sound = candidates[0]!;
+      if (binding?.audioMediaId && sound.mediaRef !== binding.audioMediaId) throw Error(`${scene.id}: 構成に指定した音声素材が差し替わっています`);
+      const offset = source.startFrame + (range.startFrame - source.trimStartFrame) / source.speed - sound.startFrame;
+      const speed = sound.speed / source.speed;
+      const trim = sound.trimStartFrame + offset * sound.speed;
+      if (!(speed > 0) || offset < 0 || offset + scene.durationFrames / source.speed > sound.durationFrames)
+        throw Error(`${scene.id}: 元音声の区間が不足しています`);
+      if (!Number.isSafeInteger(trim)) throw Error(`${scene.id}: 元音声の開始位置を整数フレームで表現できません`);
+      audio.push(ClipSchema.parse({ ...base, id: newId(), mediaRef: sound.mediaRef, mediaType: "audio", sourceClipType: sound.sourceClipType,
+        trimStartFrame: trim, trimEndFrame: sourceDurationFrames(sound) - trim - Math.round(scene.durationFrames * speed), speed, volume: sound.volume, linkGroupId }));
+    }
+    const track = (type: Track["type"], items: Clip[]): Track => ({ id: newId(), type, muted: false, hidden: false, syncLocked: true, clips: items });
+    return { ...t, settingsConfigured: true, markers: [], sceneBriefs: plan.briefs,
+      tracks: [track("text", titles), track("video", video), track("audio", audio)] };
+  }};
+}
