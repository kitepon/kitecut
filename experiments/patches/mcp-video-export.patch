+import { TimingMarkersSchema, type TimingMarker } from "../timing-marker.js";
+import { findClip } from "../timeline.js";
+import type { Command } from "./editor-store.js";
+import { splitLinkedClipCommand } from "./timeline-commands.js";
+import { setKeyframeCommand, type KeyframeTrackKey, type KeyframeValueMap } from "./keyframe-commands.js";
+
+export function editTimingMarkersCommand(upserts: TimingMarker[], removeIds: string[] = []): Command {
+  const validated = TimingMarkersSchema.parse(upserts);
+  return { label: "音の目印を編集", apply(timeline) {
+    const replaced = new Set([...removeIds, ...validated.map(m => m.id)]);
+    const markers = [...(timeline.markers ?? []).filter(m => !replaced.has(m.id)), ...validated]
+      .sort((a, b) => a.frame - b.frame || a.id.localeCompare(b.id));
+    return { ...timeline, markers };
+  } };
+}
+
+export function splitAtMarkerCommand(clipIds: string[], markerId: string, newId: () => string): Command {
+  return { label: "目印でカット", apply(timeline) {
+    const marker = timeline.markers?.find(m => m.id === markerId);
+    if (!marker) throw Error("目印がありません");
+    for (const id of clipIds) {
+      const loc = findClip(timeline, id);
+      if (!loc) throw Error("クリップがありません: " + id);
+      const clip = timeline.tracks[loc.trackIndex]!.clips[loc.clipIndex]!;
+      if (marker.frame <= clip.startFrame || marker.frame >= clip.startFrame + clip.durationFrames)
+        throw Error("カットする目印はクリップの内側に置いてください");
+    }
+    return clipIds.reduce((next, id) => splitLinkedClipCommand(id, marker.frame, undefined, newId).apply(next), timeline);
+  } };
+}
+
+export function keyframeAtMarkerCommand<K extends KeyframeTrackKey>(
+  clipId: string, markerId: string, track: K, value: KeyframeValueMap[K],
+): Command {
+  return { label: "目印に動きを合わせる", apply(timeline) {
+    const marker = timeline.markers?.find(m => m.id === markerId);
+    const loc = findClip(timeline, clipId);
+    if (!marker || !loc) throw Error("目印またはクリップがありません");
+    const clip = timeline.tracks[loc.trackIndex]!.clips[loc.clipIndex]!;
+    const frame = marker.frame - clip.startFrame;
+    if (frame < 0 || frame >= clip.durationFrames) throw Error("目印がクリップの範囲外です");
+    return setKeyframeCommand(clipId, track, frame, value).apply(timeline);
+  } };
+}
