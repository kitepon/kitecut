+import { useEffect, useState, useSyncExternalStore } from 'react';
+import type { MediaManifestEntry } from '@frontstage/core';
+import type { createVideoSearch } from './video-search.js';
+import './video-search.css';
+export function VideoSearchPanel({ search, entries }: { search: ReturnType<typeof createVideoSearch>; entries: () => MediaManifestEntry[] }) {
+  const [open, setOpen] = useState(false), [media, setMedia] = useState(''), [query, setQuery] = useState('');
+  const [from, setFrom] = useState(0), [to, setTo] = useState(0), [position, setPosition] = useState(0);
+  const [selected, setSelected] = useState(0), [cutFrom, setCutFrom] = useState(0), [cutTo, setCutTo] = useState(0), [error, setError] = useState('');
+  const state = useSyncExternalStore(search.subscribe, search.state);
+  const candidates = state.result?.segments ?? [];
+  useEffect(() => { if (state.input) { setMedia(state.input.mediaId); setQuery(state.input.query); setFrom(state.input.startSeconds); setTo(state.input.endSeconds); } }, [state.input]);
+  useEffect(() => { setSelected(0); if (state.result?.segments[0]) { setCutFrom(state.result.segments[0].startSeconds); setCutTo(state.result.segments[0].endSeconds); } }, [state.result]);
+  const active = state.status === 'running' || state.status === 'cancelling';
+  const label = active ? '場面を検索中…' : state.status === 'completed' ? `場面検索 · ${candidates.length}件` : '場面を探す';
+  async function run(action: () => unknown) { try { setError(''); await action(); } catch (error) { setError(String(error)); } }
+  return <aside className="video-search"><button className="video-search-launch" onClick={() => setOpen(!open)}>{label}</button>
+    {open && <section role="dialog" aria-label="場面検索"><header><div><small>VIDEOCHAT3 · VISUAL SEARCH</small><h2>欲しい瞬間を、言葉で。</h2></div><button aria-label="場面検索を閉じる" onClick={() => setOpen(false)}>×</button></header>
+      <label>検索する素材<select value={media} disabled={active} onChange={event => { const id = event.target.value; setMedia(id); setFrom(0); setTo(entries().find(entry => entry.id === id)?.duration ?? 0); }}><option value="">動画を選ぶ</option>{entries().filter(entry => entry.type === 'video').map(entry => <option key={entry.id} value={entry.id}>{entry.name}</option>)}</select></label>
+      <label>探したい場面<textarea value={query} disabled={active} onChange={event => setQuery(event.target.value)} placeholder="例：カップにコーヒーを注いでいる場面" rows={3}/></label>
