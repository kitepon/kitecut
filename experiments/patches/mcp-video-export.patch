+  useEffect(() => {
+    if (entry && library.audioPreview && library.audioPreview.state().mediaId !== entry.id) void library.audioPreview.load(entry.id).catch(e => setStatus(String(e)));
+  }, [entry, library]);
+  async function run(name: string, args: unknown) {
+    const result = await executor.execute(name, args);
+    if (result.isError) throw Error(result.blocks.filter(b => b.kind === 'text').map(b => b.text).join('\n'));
+    return result;
+  }
