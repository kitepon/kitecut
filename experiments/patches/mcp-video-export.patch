+++ b/apps/desktop/src/main/local-speech.py
@@ -0,0 +1,37 @@
+"""採用した声質参照方式で日本語ナレーションを生成する。"""
+import base64
+import contextlib
+import io
+import json
+import os
+import sys
+import time
+import hashlib
+
+request = json.loads(sys.stdin.buffer.read().decode('utf-8'))
+os.environ['HF_HOME'] = request['modelCache']
+with open(request['referenceAudio'], 'rb') as reference_file:
+    reference_hash = hashlib.sha256(reference_file.read()).hexdigest()
+if reference_hash != request['provenance']['referenceSha256']:
+    raise ValueError('採用時の参照音声とファイルが一致しません。')
+with contextlib.redirect_stdout(sys.stderr):
+    import torch
+    import soundfile as sf
+    from qwen_tts import Qwen3TTSModel
+    torch.set_num_threads(8)
+    torch.manual_seed(request['provenance']['seed'])
+    started = time.perf_counter()
+    model = Qwen3TTSModel.from_pretrained(request['modelPath'], device_map='cuda:0', dtype=torch.bfloat16, attn_implementation='sdpa')
+    prompt = model.create_voice_clone_prompt(ref_audio=request['referenceAudio'], x_vector_only_mode=True)
+    waves, sample_rate = model.generate_voice_clone(text=request['text'], language='Japanese', voice_clone_prompt=prompt)
+    audio = waves[0]
+    if request['speed'] != 1:
+        import librosa
+        audio = librosa.effects.time_stretch(audio, rate=request['speed'])
+    wav = io.BytesIO()
+    sf.write(wav, audio, sample_rate, format='WAV', subtype='PCM_16')
+result = dict(base64=base64.b64encode(wav.getvalue()).decode('ascii'), duration=len(audio)/sample_rate,
+              sampleRate=sample_rate, elapsedSeconds=time.perf_counter()-started, voice='standard',
+              provenance={**request['provenance'], 'referenceSha256': reference_hash,
+                          'speedMethod': 'librosa-time-stretch' if request['speed'] != 1 else 'native'})
+sys.stdout.write(json.dumps(result))
diff --git a/apps/desktop/src/main/media-restoration.cjs b/apps/desktop/src/main/media-restoration.cjs
new file mode 100644
index 0000000..c211ef0
--- /dev/null
+++ b/apps/desktop/src/main/media-restoration.cjs
@@ -0,0 +1,55 @@
+"use strict";
+const { spawn } = require('node:child_process');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+
+function execute(executable, args, cwd) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(executable, args, { cwd, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] });
+    const output = [], errors = [];
+    child.stdout.on('data', chunk => output.push(chunk));
+    child.stderr.on('data', chunk => errors.push(chunk));
+    child.on('error', reject);
+    child.on('close', code => code === 0 ? resolve(Buffer.concat(output)) : reject(Error(`素材補正に失敗しました (${code}): ${Buffer.concat(errors).toString('utf8')}`)));
+  });
+}
+
+function restorationArgs(mode, noiseFloor = -30) {
+  if (mode === 'stabilize') return ['-vf', 'format=yuv420p,vidstabtransform=input=motion.trf:smoothing=15:optzoom=1,unsharp=5:5:0.5:3:3:0'];
+  if (mode === 'video-denoise') return ['-vf', 'nlmeans=s=3:p=7:r=15'];
+  if (mode === 'audio-denoise') {
+    if (!Number.isFinite(noiseFloor) || noiseFloor < -80 || noiseFloor > -20) throw Error('雑音レベルは-80〜-20dBで指定してください。');
+    // FFmpeg 6.1.1の窓長は3×(sampleRate/80)。残る2窓分を処理の前後で相殺する。
+    return ['-af', `aresample=48000,apad=pad_len=1200,afftdn=nr=12:nf=${noiseFloor}:tn=0,atrim=start_sample=1200,asetpts=PTS-STARTPTS`];
+  }
+  throw Error('補正の種類を指定してください。');
+}
+
+async function restoreMedia(input, ffmpeg, ffprobe) {
+  const filter = restorationArgs(input.mode, input.noiseFloor);
+  if (typeof input.path !== 'string' || !path.isAbsolute(input.path)) throw Error('元の素材を指定してください。');
+  const metadata = JSON.parse((await execute(ffprobe, ['-v', 'error', '-show_streams', '-show_format', '-of', 'json', input.path])).toString('utf8'));
+  const audioOnly = input.mode === 'audio-denoise';
+  if (!metadata.streams.some(s => s.codec_type === (audioOnly ? 'audio' : 'video'))) throw Error(audioOnly ? '素材に音声がありません。' : '素材に映像がありません。');
+  if (audioOnly) {
+    const audioDuration = Number(metadata.streams.find(s => s.codec_type === 'audio').duration);
+    if (!(audioDuration > 0)) throw Error('元音声の長さを取得できませんでした。');
+    // AAC復号の末尾paddingを素材の宣言された音声期間から除く。
+    filter[1] = `atrim=duration=${audioDuration},${filter[1]}`;
+  }
+  const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'frontstage-restoration-'));
+  const started = Date.now();
+  try {
+    if (input.mode === 'stabilize') await execute(ffmpeg, ['-v', 'error', '-i', input.path, '-vf', 'format=yuv420p,vidstabdetect=shakiness=5:accuracy=15:mincontrast=0.05:result=motion.trf', '-an', '-f', 'null', '-'], directory);
+    const name = audioOnly ? 'result.wav' : 'result.mp4';
+    const codecs = audioOnly ? ['-map', '0:a:0', '-vn', '-c:a', 'pcm_s16le'] : ['-map', '0:v:0', '-map', '0:a?', '-c:v', 'libx264', '-crf', '18', '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '192k', '-movflags', '+faststart'];
+    await execute(ffmpeg, ['-v', 'error', '-i', input.path, ...filter, ...codecs, name], directory);
+    const output = path.join(directory, name);
+    const verified = JSON.parse((await execute(ffprobe, ['-v', 'error', '-show_streams', '-show_format', '-of', 'json', output])).toString('utf8'));
+    const duration = Number(verified.format.duration);
+    if (!(duration > 0)) throw Error('補正結果の長さを取得できませんでした。');
+    return { bytes: new Uint8Array(await fs.readFile(output)), duration, elapsedSeconds: (Date.now() - started) / 1000 };
+  } finally { await fs.rm(directory, { recursive: true, force: true }); }
+}
+module.exports = { restoreMedia, restorationArgs };
