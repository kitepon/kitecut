diff --git a/packages/ui/test/audio-preview.test.ts b/packages/ui/test/audio-preview.test.ts
new file mode 100644
index 0000000..2d505de
--- /dev/null
+++ b/packages/ui/test/audio-preview.test.ts
@@ -0,0 +1,29 @@
+import { createAudioPreview } from '../src/media/audio-preview.js';
+
+function player() {
+  const el = new EventTarget() as HTMLAudioElement;
+  Object.assign(el, { currentTime: 0, duration: 2, paused: true, controls: false, src: '', setAttribute() {}, removeAttribute() { el.src = ''; },
+    load() { queueMicrotask(() => el.dispatchEvent(new Event(el.src ? 'loadedmetadata' : 'emptied'))); },
+    pause() { Object.assign(el, { paused: true }); el.dispatchEvent(new Event('pause')); },
+    async play() { Object.assign(el, { paused: false }); el.dispatchEvent(new Event('play')); },
+  });
+  return el;
+}
+beforeEach(() => { vi.stubGlobal('URL', { createObjectURL: vi.fn(() => 'blob:test'), revokeObjectURL: vi.fn() }); });
+afterEach(() => vi.unstubAllGlobals());
+test('画面とAPIで一つのプレーヤー状態を共有し、リセットで停止する', async () => {
+  const el = player(), p = createAudioPreview(async () => new ArrayBuffer(2), () => el);
+  await p.load('a'); await p.play(); expect(p.state().paused).toBe(false);
+  el.pause(); expect(p.state().paused).toBe(true);
+  p.seek(1); expect(p.state().currentTime).toBe(1);
+  expect(() => p.seek(3)).toThrow('範囲外');
+  p.reset(); expect(p.state().mediaId).toBe(''); expect(p.state().paused).toBe(true);
+  expect(URL.revokeObjectURL).toHaveBeenCalledWith('blob:test');
+});
+test('読込み中にプロジェクトを切り替えると古い素材を適用しない', async () => {
+  let finish!: (bytes: ArrayBuffer) => void;
+  const p = createAudioPreview(() => new Promise(resolve => { finish = resolve; }), player);
+  const loading = p.load('a'); p.reset(); finish(new ArrayBuffer(2));
+  await expect(loading).rejects.toThrow('変わりました');
+  expect(p.state().mediaId).toBe(''); expect(URL.createObjectURL).not.toHaveBeenCalled();
+});
