+"use strict";
+const { spawn } = require('node:child_process');
+const { readFileSync } = require('node:fs');
+const path = require('node:path');
+
+function createVideoSearch({ configPath, worker = path.join(__dirname, 'video-search.py'), onTrace = () => {} }) {
+  let child;
+  return {
+    cancel() { if (child) child.kill(); },
+    search(input) {
+      if (child) throw Error('場面検索を実行中です。');
+      if (!configPath) throw Error('動画理解の実行環境が設定されていません。');
+      const runtime = JSON.parse(readFileSync(configPath, 'utf8'));
+      return new Promise((resolve, reject) => {
+        child = spawn(runtime.pythonExecutable, [worker], { windowsHide: true,
+          stdio: ['pipe', 'pipe', 'pipe'], env: { ...process.env, PYTHONUTF8: '1' } });
+        const output = [], errors = [];
+        child.stdout.on('data', data => output.push(data));
+        child.stderr.on('data', data => { errors.push(data); onTrace(data); });
+        child.on('error', reject);
+        child.stdin.on('error', reject);
+        child.on('close', code => {
+          child = undefined;
+          if (code !== 0) return reject(Error(`場面検索が終了しました (${code}): ${Buffer.concat(errors).toString('utf8')}`));
+          try { resolve(JSON.parse(Buffer.concat(output).toString('utf8'))); } catch (error) { reject(error); }
+        });
+        child.stdin.end(JSON.stringify({ ...input, runtime }));
+      });
+    },
+  };
+}
+module.exports = { createVideoSearch };
diff --git a/apps/desktop/src/main/video-search.py b/apps/desktop/src/main/video-search.py
new file mode 100644
index 0000000..e3994e0
--- /dev/null
+++ b/apps/desktop/src/main/video-search.py
@@ -0,0 +1,102 @@
+"""採用済みVideoChat3で素材内の指定場面を探す。時刻は元動画の秒。"""
+import contextlib
+import json
+import math
+import os
+import sys
+import time
+
+
+def parse_answer(answer, start, end):
+    value = json.loads(answer)
+    if not isinstance(value, list):
+        raise ValueError('モデルの回答に区間一覧がありません。')
+    for segment in value:
+        a, b = segment['startSeconds'], segment['endSeconds']
+        if isinstance(a, bool) or isinstance(b, bool) or not all(isinstance(t, (int, float)) and math.isfinite(t) for t in (a, b)) or not start <= a < b <= end:
+            raise ValueError('モデルが検索範囲外または不正な区間を返しました。')
+        if not isinstance(segment.get('observation'), str) or not isinstance(segment.get('uncertainty'), str):
+            raise ValueError('モデルの回答に観察または不確実さの記載がありません。')
+    return {'segments': value}
+
+
+def search(request):
+    import torch
+    from torch.nn.attention import SDPBackend, sdpa_kernel
+    from transformers import AutoConfig, AutoModelForCausalLM, AutoProcessor, TextStreamer, LogitsProcessor, LogitsProcessorList
+    from qwen_vl_utils import process_vision_info
+    from lmformatenforcer import JsonSchemaParser
+    from lmformatenforcer.integrations.transformers import build_transformers_prefix_allowed_tokens_fn
+    config = request['runtime']
+    start = time.perf_counter()
+    model_path = config['modelPath']
+    common = dict(local_files_only=True, trust_remote_code=True, revision=config['revision'])
+    processor = AutoProcessor.from_pretrained(model_path, **common)
+    model_config = AutoConfig.from_pretrained(model_path, **common)
+    model_config.vision_config.attn_impl = 'sdpa'
+    model = AutoModelForCausalLM.from_pretrained(model_path, config=model_config,
+        torch_dtype=torch.bfloat16, attn_implementation='sdpa', device_map='cuda:0', **common).eval()
+    if sys.platform == 'win32':
+        from videochat3_sdpa import install
+        install(model)
+    torch.cuda.synchronize()
+    loaded = time.perf_counter()
+    a, b = request['startSeconds'], request['endSeconds']
+    schema = {'type': 'array', 'items': {'type': 'object', 'properties': {
+        'startSeconds': {'type': 'number'}, 'endSeconds': {'type': 'number'},
+        'observation': {'type': 'string'}, 'uncertainty': {'type': 'string'}},
+        'required': ['startSeconds', 'endSeconds', 'observation', 'uncertainty'], 'additionalProperties': False}}
+    prompt = (f'Find the visible event requested below in this video. Search only from {a} to {b} seconds. '
+        'Use the original video timestamps shown with the frames. Return all matching intervals. '
+        'Do not infer sounds or dialogue: this input contains visual evidence only. '
+        'If the event is not visible, return []. '
+        'Each interval must have startSeconds, endSeconds, observation (what is visibly happening), '
+        'and uncertainty (ambiguity or boundary uncertainty, described in words, not a confidence number). Describe observations and uncertainty in Japanese. '
+        'Return only one JSON array, '
+        'like [{"startSeconds":1.0,"endSeconds":2.0,"observation":"...","uncertainty":"..."}]. '
+        'Do not write anything after this JSON.\nRequested event: ' + request['query'])
+    messages = [{'role': 'user', 'content': [
+        {'type': 'video', 'video': request['path'], 'video_start': a, 'video_end': b},
+        {'type': 'text', 'text': prompt}]}]
+    text = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
+    images, videos, kwargs = process_vision_info(messages, image_patch_size=14,
+        return_video_kwargs=True, return_video_metadata=True)
+    videos, metadata = zip(*videos)
+    inputs = processor(text=text, images=images, videos=list(videos), video_metadata=list(metadata),
+        do_resize=False, return_tensors='pt', **(kwargs or {})).to(model.device).to(model.dtype)
+    prefix = build_transformers_prefix_allowed_tokens_fn(processor.tokenizer, JsonSchemaParser(schema))
+    class PresencePenalty(LogitsProcessor):
+        # 研究で実測した設定。生成済みtokenを一度だけ減点して回答の反復を抑える。
+        def __call__(self, input_ids, scores):
+            seen = torch.zeros_like(scores, dtype=torch.bool)
+            seen.scatter_(1, input_ids[:, inputs.input_ids.shape[1]:], True)
+            return scores - 1.5 * seen.to(scores.dtype)
+    with torch.inference_mode(), sdpa_kernel([SDPBackend.EFFICIENT_ATTENTION, SDPBackend.CUDNN_ATTENTION]):
+        generated = model.generate(**inputs, max_new_tokens=1024, do_sample=False,
+            prefix_allowed_tokens_fn=prefix,
+            logits_processor=LogitsProcessorList([PresencePenalty()]),
+            streamer=TextStreamer(processor.tokenizer, skip_prompt=True, skip_special_tokens=True))
+    tokens = generated[0, inputs.input_ids.shape[1]:].tolist()
+    eos = model.generation_config.eos_token_id
+    if not tokens or tokens[-1] not in (eos if isinstance(eos, list) else [eos]):
+        raise ValueError('モデルの回答が完了しませんでした。')
+    answer = processor.tokenizer.decode(tokens, skip_special_tokens=True)
+    print('VideoChat3の回答: ' + answer, file=sys.stderr)
+    result = parse_answer(answer, a, b)
+    torch.cuda.synchronize()
+    return {**result, 'model': config['modelId'], 'revision': config['revision'],
+        'evidenceType': 'visual', 'rawAnswer': answer, 'metadata': list(metadata),
+        'modelLoadSeconds': loaded - start, 'inferenceSeconds': time.perf_counter() - loaded}
+
+
+if __name__ == '__main__':
+    request = json.load(sys.stdin)
+    handles = []
+    directory = request['runtime'].get('ffmpegDirectory')
+    if directory:
+        os.environ['PATH'] = directory + os.pathsep + os.environ['PATH']
+        if sys.platform == 'win32':
+            handles.append(os.add_dll_directory(directory))
+    with contextlib.redirect_stdout(sys.stderr):
+        result = search(request)
+    print(json.dumps(result, ensure_ascii=False))
diff --git a/apps/desktop/src/main/videochat3_sdpa.py b/apps/desktop/src/main/videochat3_sdpa.py
new file mode 100644
index 0000000..492cfa4
--- /dev/null
+++ b/apps/desktop/src/main/videochat3_sdpa.py
@@ -0,0 +1,20 @@
+"""公式のblock対角attentionを区間ごとに計算し、巨大な全区間maskを作らない。"""
+import torch
+import torch.nn.functional as F
+
+
+def sdpa_attention(q, k, v, q_cu_seqlens=None, k_cu_seqlens=None):
+    boundaries = q_cu_seqlens.tolist()
+    outputs = []
+    # 配布元maskでTrueになる区間だけを計算する。重みと全入力トークンは保持する。
+    for start, end in zip(boundaries[:-1], boundaries[1:]):
+        output = F.scaled_dot_product_attention(q[start:end].transpose(0, 1).unsqueeze(0),
+            k[start:end].transpose(0, 1).unsqueeze(0), v[start:end].transpose(0, 1).unsqueeze(0), dropout_p=0.0)
+        outputs.append(output.squeeze(0).transpose(0, 1).reshape(end-start, -1))
+    return torch.cat(outputs, dim=0)
+
+
+def install(model):
+    import sys
+    module = sys.modules[type(model).__module__]
+    module.VL_VISION_ATTENTION_FUNCTIONS['sdpa'] = sdpa_attention
