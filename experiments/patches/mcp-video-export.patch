+import { test, expect, vi } from 'vitest';
+vi.mock('@frontstage/ui', () => ({ probeMediaBlob: vi.fn(async () => ({ duration: 3, hasAudio: true })) }));
+import { createMediaRestoration } from '../src/renderer/media-restoration.js';
+
+function fixture(saved = true) {
+  const source = { id: 'source', type: 'video', name: '素材', duration: 3, hasAudio: true };
+  let project: object | null = { id: 'project' };
+  let finish!: (value: any) => void;
+  vi.stubGlobal('window', { desktopRestoration: { process: () => new Promise(resolve => { finish = resolve; }) } });
+  const library = { entry: () => source, addEntry: vi.fn(), setThumbnail: vi.fn() };
+  const save = vi.fn(async () => saved);
+  const restoration = createMediaRestoration(library as any, () => 'C:/source.mp4', () => project, save);
+  return { restoration, library, save, switchProject: () => { project = { id: 'project' }; }, unsaved: () => { project = null; }, finish: () => finish({ bytes: new Uint8Array([1]), duration: 3, elapsedSeconds: 1 }) };
+}
+
+test('処理中は未完成素材を保存せず、完成した素材だけ追加して保存する', async () => {
+  const f = fixture();
+  f.restoration.start({ mediaId: 'source', mode: 'stabilize' });
+  expect(f.library.addEntry).not.toHaveBeenCalled();
+  f.finish();
+  await vi.waitFor(() => expect(f.restoration.state().status).toBe('completed'));
+  expect(f.library.addEntry).toHaveBeenCalledTimes(1);
+  expect(f.save).toHaveBeenCalledTimes(1);
+});
+
+test('同じIDを持つ別プロジェクトへ切り替えても結果を混入しない', async () => {
+  const f = fixture();
+  f.restoration.start({ mediaId: 'source', mode: 'stabilize' });
+  f.switchProject();
+  f.finish();
+  await vi.waitFor(() => expect(f.restoration.state().status).toBe('failed'));
+  expect(f.library.addEntry).not.toHaveBeenCalled();
+  expect(f.save).not.toHaveBeenCalled();
+});
+
+test('保存失敗を完了と表示しない', async () => {
+  const f = fixture(false);
+  f.restoration.start({ mediaId: 'source', mode: 'audio-denoise' });
+  f.finish();
+  await vi.waitFor(() => expect(f.restoration.state().status).toBe('failed'));
+  expect(f.restoration.state().error).toContain('保存できません');
+  expect(f.restoration.state().input?.noiseFloor).toBe(-30);
+});
+
+test('未保存プロジェクトでは補正を開始しない', () => {
+  const f = fixture();
+  f.unsaved();
+  expect(() => f.restoration.start({ mediaId: 'source', mode: 'stabilize' })).toThrow('先にプロジェクトを保存');
+});
