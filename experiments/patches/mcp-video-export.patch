--- /dev/null
+++ b/apps/desktop/src/main/local-speech.cjs
@@ -0,0 +1,34 @@
+"use strict";
+const { spawn } = require("node:child_process");
+const fs = require("node:fs/promises");
+const path = require("node:path");
+
+async function generateSpeech(input, configPath = process.env.FRONTSTAGE_LOCAL_SPEECH_CONFIG) {
+  if (!configPath) throw Error("日本語読み上げの実行環境が設定されていません。");
+  const config = JSON.parse(await fs.readFile(configPath, "utf8"));
+  const voice = input.voice ?? 'standard';
+  if (!input.text?.trim() || !Number.isFinite(input.speed) || input.speed <= 0) throw Error('文章と正の読み上げ速度を指定してください。');
+  if (voice === 'calm') {
+    if (!config.nemo) throw Error('落ち着いたナレーションの実行環境が設定されていません。');
+    return require('./local-speech-nemo.cjs').generate(input, config.nemo);
+  }
+  if (voice !== 'standard') throw Error('音声の種類が不正です。');
+  if (!config.qwen) throw Error('標準ナレーションの実行環境が設定されていません。');
+  return new Promise((resolve, reject) => {
+    const child = spawn(config.qwen.pythonExecutable, [path.join(__dirname, "local-speech.py")], {
+      windowsHide: true, stdio: ["pipe", "pipe", "pipe"], env: { ...process.env, PYTHONUTF8: "1", HF_HUB_OFFLINE: "1", TRANSFORMERS_OFFLINE: "1" },
+    });
+    const output = [], errors = [];
+    child.stdout.on("data", chunk => output.push(chunk));
+    child.stderr.on("data", chunk => errors.push(chunk));
+    child.on("error", reject);
+    child.stdin.on("error", reject);
+    child.on("close", code => {
+      if (code !== 0) return reject(Error(`日本語読み上げに失敗しました (${code}): ${Buffer.concat(errors).toString("utf8")}`));
+      try { resolve(JSON.parse(Buffer.concat(output).toString("utf8"))); }
+      catch (error) { reject(error); }
+    });
+    child.stdin.end(JSON.stringify({ ...input, ...config.qwen }));
+  });
+}
+module.exports = { generateSpeech };
