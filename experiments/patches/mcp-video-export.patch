+  fireEvent.click(screen.getByRole('button',{name:/実演/}));
+  fireEvent.click(screen.getByRole('checkbox',{name:'AIの改稿でこの場面を残す'}));
+  expect(store.getSnapshot().timeline.preservedSceneIds).toEqual(['scene']);
+  act(()=>store.undo());
+  expect((screen.getByRole('checkbox',{name:'AIの改稿でこの場面を残す'}) as HTMLInputElement).checked).toBe(false);
+  fireEvent.change(screen.getByLabelText('目的'),{target:{value:'翻訳の実演'}});
+  fireEvent.change(screen.getByLabelText('コピー'),{target:{value:'その瞬間を。'}});
+  fireEvent.click(screen.getByRole('button',{name:'構成を保存'}));
+  const saved=store.getSnapshot().timeline.sceneBriefs![0]!;
+  expect(saved.purpose).toBe('翻訳の実演');
+  act(()=>store.dispatch(setSceneBriefCommand({...saved,copy:'字幕といっしょに。'})));
+  expect((screen.getByLabelText('コピー') as HTMLTextAreaElement).value).toBe('字幕といっしょに。');
+  act(()=>store.undo());
+  expect((screen.getByLabelText('コピー') as HTMLTextAreaElement).value).toBe('その瞬間を。');
+  fireEvent.change(screen.getByLabelText('コピー'),{target:{value:'人が入力中'}});
+  act(()=>store.dispatch(setSceneBriefCommand({...saved,copy:'外部からの改稿'})));
+  expect((screen.getByLabelText('コピー') as HTMLTextAreaElement).value).toBe('人が入力中');
+  fireEvent.click(screen.getByRole('button',{name:'構成を保存'}));
+  expect(screen.getByRole('alert').textContent).toContain('入力中に構成が変更');
+  expect(store.getSnapshot().timeline.sceneBriefs![0]!.copy).toBe('外部からの改稿');
+  fireEvent.click(screen.getByRole('button',{name:'最新の構成を読み直す（入力を破棄）'}));
+  expect((screen.getByLabelText('コピー') as HTMLTextAreaElement).value).toBe('外部からの改稿');
+  cleanup();
+});
+test('人が場面を作り、外部操作の移動を読み、解除を一回で戻せる',()=>{
+  const clip=(id:string,startFrame:number)=>ClipSchema.parse({id,mediaRef:'m',mediaType:'video',sourceClipType:'video',startFrame,durationFrames:30});
+  const store=new EditorStore(TimelineSchema.parse({tracks:[{id:'v',type:'video',clips:[clip('one',0),clip('two',40)]}]}));
