+import { GraphicRasterizer, measureGraphicTextBaseline, measureGraphicGlyphLayout } from "@frontstage/engine";
+import type { GraphicDocument, GraphicNode } from "@frontstage/core";
+export const desktopGraphics = {
+    outline: async (node: GraphicNode) => (window as unknown as {
+        desktopGraphics: {
+            outline(n: GraphicNode & {baseline:number}): Promise<string>;
+        };
+    }).desktopGraphics.outline({...node,baseline:await measureGraphicTextBaseline(node),...(node.glyphOffsets?.length?{glyphLayout:await measureGraphicGlyphLayout(node)}:{})}),
+    async renderPng(document: GraphicDocument, frame: number): Promise<string> { const raster = new GraphicRasterizer(); try {
+        await raster.prepare([document]);
+        const canvas = new OffscreenCanvas(document.width, document.height);
+        raster.draw(canvas.getContext("2d")!, document, frame, document);
+        const bytes = new Uint8Array(await (await canvas.convertToBlob({ type: "image/png" })).arrayBuffer());
+        let binary = "";
+        for (let i = 0; i < bytes.length; i += 8192)
+            binary += String.fromCharCode(...bytes.subarray(i, i + 8192));
+        return btoa(binary);
+    }
+    finally {
+        raster.dispose();
+    } }
+};
