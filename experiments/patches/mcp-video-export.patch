new file mode 100644
index 0000000..47fa9cb
--- /dev/null
+++ b/packages/engine/test/path-distance.test.ts
@@ -0,0 +1,19 @@
+import {test,expect} from 'vitest';
+import {signedDistances} from '../src/render/path-distance.js';
+test('距離場を全画素の総当たり計算と比較する',()=>{
+  const width=9,height=7;
+  const alpha=Uint8ClampedArray.from({length:width*height},(_,i)=>((i*17+3)%11<5?255:0));
+  const result=signedDistances(alpha,width,height);
+  for(let i=0;i<alpha.length;i++){
+    let closest=Infinity;
+    for(let j=0;j<alpha.length;j++)if(alpha[i]!==alpha[j])closest=Math.min(closest,Math.hypot(i%width-j%width,Math.floor(i/width)-Math.floor(j/width)));
+    expect(result[i]).toBeCloseTo(alpha[i]===255?-closest:closest,5);
+  }
+});
+test('全面透明と全面不透明でも距離を有限値で返す',()=>{
+  for(const alpha of [new Uint8ClampedArray(12),new Uint8ClampedArray(12).fill(255)]){
+    const result=signedDistances(alpha,4,3);
+    expect([...result].every(Number.isFinite)).toBe(true);
+    expect([...result].every(v=>alpha[0]===255?v<0:v>0)).toBe(true);
+  }
+});
