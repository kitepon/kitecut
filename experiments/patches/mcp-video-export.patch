diff --git a/apps/desktop/src/renderer/scene-comparison.ts b/apps/desktop/src/renderer/scene-comparison.ts
new file mode 100644
index 0000000..a885e8e
--- /dev/null
+++ b/apps/desktop/src/renderer/scene-comparison.ts
@@ -0,0 +1,55 @@
+import { storyboardRows, type ProjectDoc } from '@frontstage/core';
+import type { SceneComparisonFacade, SceneComparisonState, SceneComparisonVersion } from '@frontstage/ai';
+
+export interface SceneComparisonDeps {
+  pauseEditor():void;
+  saveCurrent(): Promise<{path:string;name:string}>;
+  references(): Promise<{path:string;name:string}[]>;
+  read(path:string): Promise<ProjectDoc>;
+  render(doc:ProjectDoc,sourcePath:string,outputPath:string,start:number,count:number,progress:(done:number,total:number)=>void): Promise<void>;
+  bytes(path:string): Promise<Blob>;
+  newId():string;
+}
+
+export function createSceneComparison(deps:SceneComparisonDeps):SceneComparisonFacade {
+  let state:SceneComparisonState|null=null;
+  let play:((version:'before'|'after')=>Promise<void>)|undefined;
+  const listeners=new Set<()=>void>();
+  const update=(next:SceneComparisonState)=>{state=next;for(const cb of listeners)cb();};
+  function version(doc:ProjectDoc,sceneId:string,name:string,path:string):SceneComparisonVersion {
+    const row=storyboardRows(doc.timeline).find(r=>r.id===sceneId);
+    if(!row)throw Error(`「${name}」に対応する場面がありません。同じ場面を含む別名保存を選んでください。`);
+    return {name,path,startFrame:row.startFrame,endFrame:row.endFrame,fps:doc.timeline.fps,copy:row.brief?.copy??''};
+  }
+  return {
+    pauseEditor:deps.pauseEditor,
+    bindPlayback(callback){play=callback;return()=>{if(play===callback)play=undefined;};},
+    async play(side){if(!play)throw Error('比較画面の準備ができていません');deps.pauseEditor();await play(side);},
+    references:deps.references,
+    state:()=>state,
+    subscribe(cb){listeners.add(cb);return()=>{listeners.delete(cb);};},
+    start(referencePath,sceneId){
+      if(state?.status==='running')throw Error('比較動画を作成中です');
+      deps.pauseEditor();
+      const id=deps.newId(),initial:SceneComparisonState={id,sceneId,status:'running',done:0,total:0};update(initial);
+      void (async()=>{
+        try {
+          const current=await deps.saveCurrent();
+          if(referencePath.replaceAll('\\','/').toLowerCase()===current.path.replaceAll('\\','/').toLowerCase())throw Error('比較元には別名保存したプロジェクトを選んでください');
+          const refs=await deps.references(),ref=refs.find(r=>r.path===referencePath);
+          if(!ref)throw Error('比較元をアプリで一度開いてから選んでください');
+          const [beforeDoc,afterDoc]=await Promise.all([deps.read(referencePath),deps.read(current.path)]);
+          const before=version(beforeDoc,sceneId,ref.name,`${current.path}/比較-${id}-変更前.mp4`);
+          const after=version(afterDoc,sceneId,current.name,`${current.path}/比較-${id}-変更後.mp4`);
+          const firstCount=before.endFrame-before.startFrame,total=firstCount+after.endFrame-after.startFrame;
+          update({...initial,before,after,total});
+          await deps.render(beforeDoc,referencePath,before.path,before.startFrame,firstCount,done=>update({...state!,done}));
+          await deps.render(afterDoc,current.path,after.path,after.startFrame,after.endFrame-after.startFrame,done=>update({...state!,done:firstCount+done}));
+          update({...state!,status:'completed',done:total});
+        }catch(error){update({...state!,status:'failed',error:error instanceof Error?error.message:String(error)});}
+      })();
+      return initial;
+    },
+    async preview(side){if(state?.status!=='completed')throw Error('比較動画は完成していません');return deps.bytes(state[side]!.path);},
+  };
+}
diff --git a/apps/desktop/src/renderer/story-graphics.ts b/apps/desktop/src/renderer/story-graphics.ts
new file mode 100644
index 0000000..bc8a934
--- /dev/null
+++ b/apps/desktop/src/renderer/story-graphics.ts
@@ -0,0 +1,22 @@
+import { GraphicDocumentSchema, type compileStoryPlan } from '@frontstage/core';
+
+/** 読み込んだ書体の実測幅で、提案コピーを画面内に収める。 */
+export async function storyGraphics(plan:ReturnType<typeof compileStoryPlan>,width:number,height:number){
+  const canvas=document.createElement('canvas'),context=canvas.getContext('2d');
+  if(!context)throw Error('文字幅を測定できません');
+  return Object.fromEntries(await Promise.all(plan.scenes.map(async scene=>{
+    const font=scene.design.fontFamily;
+    await document.fonts.load(`400 96px "${font}"`,scene.copy);
+    if(!document.fonts.check(`400 96px "${font}"`,scene.copy))throw Error(`書体を読み込めません: ${font}`);
+    context.font=`400 96px "${font}"`;
+    const measured=context.measureText(scene.copy).width;
+    const size=Math.min(height*0.12,(width*0.84)/Math.max(1,measured)*96);
+    const band=height*0.24;
+    const y=scene.design.headlinePosition==='top'?height*0.05:scene.design.headlinePosition==='bottom'?height-band+height*0.05:(height-size*1.25)/2;
+    const background=scene.sourceRange?{y:scene.design.headlinePosition==='bottom'?height-band:scene.design.headlinePosition==='center'?(height-band)/2:0,height:band}:{y:0,height};
+    return [scene.id,GraphicDocumentSchema.parse({version:1,name:scene.copy,width,height,nodes:[
+      {id:'background',name:'見出しの背景',kind:'rect',x:0,width,...background,fill:scene.design.backgroundColor},
+      {id:'headline',name:'構成の見出し',kind:'text',x:width*0.08,y,width:width*0.84,height:size*1.5,text:scene.copy,fontFamily:font,fontSize:size,fill:scene.design.textColor,align:'center'},
+    ]})];
+  })));
+}
