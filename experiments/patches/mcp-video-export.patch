diff --git a/packages/ai/src/tools/speech-timing-tools.ts b/packages/ai/src/tools/speech-timing-tools.ts
new file mode 100644
index 0000000..071f601
--- /dev/null
+++ b/packages/ai/src/tools/speech-timing-tools.ts
@@ -0,0 +1,72 @@
+import { z } from "zod";
+import { findClip, speechMarkers, editTimingMarkersCommand, type TimingMarker, type Clip, type Timeline } from "@frontstage/core";
+import { ok, errorResult } from "./executor.js";
+import type { ToolSpec, ToolContext } from "./types.js";
+
+function timingSource(t: Timeline, id: string) {
+  const loc = findClip(t, id);
+  if (!loc) throw Error("解析するクリップがありません");
+  const clip = t.tracks[loc.trackIndex]!.clips[loc.clipIndex]!;
+  return { id: clip.id, mediaRef: clip.mediaRef, startFrame: clip.startFrame, trimStartFrame: clip.trimStartFrame, durationFrames: clip.durationFrames, speed: clip.speed, fps: t.fps };
+}
+interface Job {
+  status: "running" | "completed" | "failed";
+  source: ReturnType<typeof timingSource>;
+  markers?: TimingMarker[];
+  language?: string;
+  error?: string;
+  applied: boolean;
+}
+
+export function speechTimingTools(): ToolSpec[] {
+  const jobsByStore = new WeakMap<ToolContext["store"], Map<string, Job>>();
+  function jobs(ctx: ToolContext) {
+    let value = jobsByStore.get(ctx.store);
+    if (!value) { value = new Map(); jobsByStore.set(ctx.store, value); }
+    return value;
+  }
+  return [
+    { name: "analyze_speech_timing", description: "選んだ音声または音声付き動画から発話区間の目印候補を作る。保存済み認識を活用し、未認識なら無償ローカル認識を準備して使用。直ちにjobIdを返す。同じjobIdで結果を取得。解析だけでは作品を変更せず、apply_speech_timingで適用する。", inputSchema: z.object({ clipId: z.string().optional(), jobId: z.string().optional() }), async run(args, ctx) {
+      const a = args as { clipId?: string; jobId?: string };
+      if (a.jobId) {
+        const job = jobs(ctx).get(a.jobId);
+        return job ? ok(JSON.stringify({ jobId: a.jobId, ...job })) : errorResult("発話解析ジョブがありません");
+      }
+      if (!a.clipId) return errorResult("解析するclipIdを指定してください");
+      const facade = ctx.transcription;
+      if (!facade) return errorResult("音声認識が接続されていません");
+      const timeline = ctx.store.getSnapshot().timeline;
+      const source = timingSource(timeline, a.clipId);
+      const loc = findClip(timeline, a.clipId)!;
+      const clip: Clip = timeline.tracks[loc.trackIndex]!.clips[loc.clipIndex]!;
+      const entry = ctx.getManifest().entries.find(e => e.id === clip.mediaRef);
+      if (!entry || !["audio", "video"].includes(clip.mediaType) || entry.hasAudio === false) return errorResult("音声を持つ素材を選んでください");
+      const jobId = ctx.newId();
+      const job: Job = { status: "running", source, applied: false };
+      jobs(ctx).set(jobId, job);
+      const analyze = async () => {
+        let result = await facade.cachedTranscript(clip.mediaRef);
+        if (!result) {
+          if (!facade.prepareLocal) throw Error("ローカル音声認識を準備できません");
+          await facade.prepareLocal();
+          if (JSON.stringify(timingSource(ctx.store.getSnapshot().timeline, source.id)) !== JSON.stringify(source)) throw Error("認識の準備中に対象クリップが変わりました。再解析してください");
+          result = await facade.transcribe(clip.mediaRef, { forceLocal: true });
+        }
+        job.markers = speechMarkers(clip, timeline.fps, result, ctx.newId);
+        job.language = result.language;
+        job.status = "completed";
+      };
+      void analyze().catch(error => { job.error = String(error); job.status = "failed"; });
+      return ok(JSON.stringify({ jobId, status: job.status }));
+    } },
+    { name: "apply_speech_timing", description: "完了した発話解析を一回のUndoで目印へ追加する。解析後に対象の位置・トリム・速度が変わっていたら適用を拒否し再解析を案内する。同じジョブの再適用は重複追加しない。目印は適用後に人が修正できる。", inputSchema: z.object({ jobId: z.string() }), run(args, ctx) {
+      const job = jobs(ctx).get((args as { jobId: string }).jobId);
+      if (!job || job.status !== "completed" || !job.markers) return errorResult("発話解析が完了していません");
+      if (job.applied) return ok(JSON.stringify({ markers: job.markers, applied: true }));
+      if (JSON.stringify(timingSource(ctx.store.getSnapshot().timeline, job.source.id)) !== JSON.stringify(job.source)) return errorResult("解析後に対象クリップの時刻が変わりました。再解析してください");
+      ctx.store.dispatch(editTimingMarkersCommand(job.markers));
+      job.applied = true;
+      return ok(JSON.stringify({ markers: job.markers }));
+    } },
+  ];
+}
