+// @vitest-environment jsdom
+import { test, expect, vi } from "vitest";
+import { render, screen, fireEvent, waitFor, cleanup } from "@testing-library/react";
+import { EditorStore, defaultTimeline } from "@frontstage/core";
+import { SpeechTimingPanel } from "../src/timeline/SpeechTimingPanel.js";
+
+test.each(["speech", "beat"] as const)("%sの解析中から候補表示へ進み、適用は利用者の操作で実行する", async (kind) => {
+  const label = kind === "speech" ? "発話" : "拍";
+  const store = new EditorStore(defaultTimeline()); store.select(["voice"]);
+  const markers = [{ id: "speech", kind: "speech", frame: 30, endFrame: 60, label: "声" }];
+  const execute = vi.fn(async (name: string, args: unknown) => {
+    const data = name === `apply_${kind}_timing` ? { markers } : (args as { jobId?: string }).jobId ? { jobId: "job", status: "completed", markers } : { jobId: "job", status: "running" };
+    return { isError: false, blocks: [{ kind: "text" as const, text: JSON.stringify(data) }] };
+  });
+  render(<SpeechTimingPanel store={store} executor={{ execute }} kind={kind} />);
+  fireEvent.click(screen.getByRole("button", { name: `選択素材の${label}を自動検出` }));
+  await waitFor(() => expect(screen.getByRole("button", { name: `${label}を解析中…` })).toBeTruthy());
+  await waitFor(() => expect(screen.getByRole("button", { name: `${label}の目印にする` })).toBeTruthy(), { timeout: 2500 });
+  expect(execute.mock.calls.some(c => c[0] === `apply_${kind}_timing`)).toBe(false);
+  expect(screen.getByRole("list", { name: `${label}の候補` }).textContent).toContain("声");
+  expect(screen.getByText("30–60 フレーム")).toBeTruthy();
+  fireEvent.click(screen.getByRole("button", { name: `${label}の目印にする` }));
+  await waitFor(() => expect(screen.getByRole("button", { name: "目印へ適用済み" })).toBeTruthy());
+  expect(execute).toHaveBeenCalledWith(`apply_${kind}_timing`, { jobId: "job" });
+  cleanup();
+});
