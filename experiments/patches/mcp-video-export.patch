+import { z } from 'zod';
+import { StoryPlanContextSchema, StoryPlanDraftSchema, GraphicDocumentSchema, compileStoryPlan } from '@frontstage/core';
+
+export const StorySourceSchema = z.object({ evidenceId: z.string().min(1), videoClipId: z.string().min(1), mediaId: z.string().min(1), audioClipId: z.string().optional(), audioMediaId: z.string().optional() }).strict();
+export const StoryEvidenceSchema = z.object({ evidenceId: z.string().min(1), mediaId: z.string().min(1), observation: z.string(), uncertainty: z.string(), origin: z.enum(['human','videochat3']), startSeconds: z.number().nonnegative().optional(), endSeconds: z.number().positive().optional(), model: z.string().optional(), revision: z.string().optional() }).strict();
+export const StoryPlanInputSchema = z.object({
+  context: StoryPlanContextSchema, draft: StoryPlanDraftSchema, fps: z.number().positive().finite(),
+  sources: z.array(StorySourceSchema), graphics: z.record(GraphicDocumentSchema).optional(),
+  facts: z.string().default(''), direction: z.string().default(''), evidenceNotes: z.array(StoryEvidenceSchema).default([]),
+}).strict();
+export type StoryPlanInput = z.infer<typeof StoryPlanInputSchema>;
+export type StoryPlanRecord = Omit<StoryPlanInput,'fps'|'draft'> & { id: string; fps: number | null; draft: StoryPlanInput['draft'] | null; savedAt: string; origin: 'operator'|'legacy'; status: string; legacyError?: string };
+export type StoryPlanSummary = Pick<StoryPlanRecord,'id'|'savedAt'|'origin'|'status'> & { title: string };
+export interface StoryPlansBridge {
+  save(input: StoryPlanInput): Promise<StoryPlanRecord>;
+  history(): Promise<StoryPlanSummary[]>;
+  open(id: string): Promise<StoryPlanRecord>;
+  state(): Promise<StoryPlanRecord | null>;
+  subscribe(callback: (value: StoryPlanRecord) => void): () => void;
+}
+export function makeStoryPlans(bridge: StoryPlansBridge) {
+  return { ...bridge, async save(input: unknown) {
+    const value = StoryPlanInputSchema.parse(input);
+    compileStoryPlan(value.context, value.draft);
+    return bridge.save(value);
+  } };
+}
+export type StoryPlansFacade = ReturnType<typeof makeStoryPlans>;
