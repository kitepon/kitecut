+import { test, expect } from "vitest";
+import { GraphicDocumentSchema, createGraphic, groupGraphicNodes, graphicNodeAt, outlinedGraphicNode, restoreGraphicText } from "./graphic.js";
+import { ClipSchema } from "./schema/schemas.js";
+import { EditorStore } from "./editor/editor-store.js";
+import { addGraphicCommand, setGraphicCommand } from "./editor/graphic-commands.js";
+import { defaultTimeline } from "./timeline.js";
+import { buildRenderPlan } from "./render-plan.js";
+test('輪郭化前の文字を保存し、後の位置変更を保って復元する',()=>{
+ const doc=createGraphic();const original=doc.nodes[0]!;
+ original.letterSpacing=4;original.gradient={from:'#ffffff',to:'#ef8d32',angle:90};original.strokeWidth=2;
+ const outlined=outlinedGraphicNode(original,'data:image/svg+xml;base64,PHN2Zy8+');
+ const reopened=GraphicDocumentSchema.parse(JSON.parse(JSON.stringify({...doc,nodes:[outlined]}))).nodes[0]!;
+ reopened.x=300;reopened.motion={x:{keyframes:[{frame:0,value:300,interpolationOut:'linear'},{frame:20,value:400,interpolationOut:'linear'}]}};
+ const restored=restoreGraphicText(reopened);
+ expect(restored.text).toBe(original.text);expect(restored.fontFamily).toBe(original.fontFamily);
+ expect(restored.letterSpacing).toBe(4);expect(restored.gradient).toEqual(original.gradient);expect(restored.strokeWidth).toBe(2);
+ expect(restored.x).toBe(300);expect(restored.motion).toEqual(reopened.motion);expect(restored.kind).toBe('text');expect(restored.image).toBeUndefined();
+ expect(()=>restoreGraphicText(original)).toThrow('元文字');
