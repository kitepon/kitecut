+import {useState} from 'react';
+import {GRAPHIC_FONTS,graphicFontFamilies,type GraphicNode} from '@frontstage/core';
+export function FontGallery({node,onChange}:{node:GraphicNode;onChange:(patch:Partial<GraphicNode>)=>void}){
+ const [open,setOpen]=useState(false),[query,setQuery]=useState('');
+ return <section className="graphic-font-gallery">
+  <button onClick={()=>setOpen(!open)} aria-expanded={open}>書体を見本で比較</button>
+  <label>代替書体<select value={node.fontFallbackFamily} onChange={e=>onChange({fontFallbackFamily:e.target.value})}>{GRAPHIC_FONTS.map(f=><option key={f.family} value={f.family}>{f.family}</option>)}</select></label>
+  <small>選択書体にない文字は {node.fontFallbackFamily} で補います。両方にない文字はOSの書体になります。</small>
+  {open&&<><label>書体を絞り込む<input value={query} onChange={e=>setQuery(e.target.value)} placeholder="書体名・特徴"/></label><div style={{maxHeight:340,overflowY:'auto',display:'grid',gap:8}}>
+   {GRAPHIC_FONTS.filter(f=>(f.family+' '+f.category).toLowerCase().includes(query.toLowerCase())).map(f=><button key={f.family} aria-pressed={node.fontFamily===f.family} onClick={()=>onChange({fontFamily:f.family,fontWeight:400})} style={{textAlign:'left',padding:12,border:node.fontFamily===f.family?'1px solid #ef8d32':undefined}}>
+    <small>{f.family} · {f.category}</small><div style={{fontFamily:graphicFontFamilies({...node,fontFamily:f.family}),fontSize:24,fontWeight:400,whiteSpace:'pre-wrap',overflowWrap:'anywhere',marginTop:8}}>{node.text||'あなたの映像を KiteCut'}</div>
+   </button>)}
+  </div></>}
+ </section>;
+}
diff --git a/packages/ui/src/inspector/GlyphPositions.tsx b/packages/ui/src/inspector/GlyphPositions.tsx
new file mode 100644
