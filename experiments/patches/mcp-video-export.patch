+import {test,expect} from 'vitest';
+import {defaultTimeline,ClipSchema,type ProjectDoc} from '@frontstage/core';
+import {createSceneComparison} from '../src/renderer/scene-comparison.js';
+
+test('同じ場面の移動と長さの違いを各版の区間に対応付け、音声付き描画へ渡す',async()=>{
+ const doc=(start:number,duration:number):ProjectDoc=>({timeline:{...defaultTimeline(),tracks:[{id:'v',type:'video',muted:false,hidden:false,syncLocked:false,clips:[ClipSchema.parse({id:'v',mediaRef:'m',mediaType:'video',sourceClipType:'video',startFrame:start,durationFrames:duration,sceneGroup:{id:'scene',name:'実演'}})]}]},manifest:{version:2,entries:[],folders:[]},generationLog:{version:1,entries:[]} as never});
+ const calls:unknown[]=[],before=doc(30,60),after=doc(45,90);
+ const comparison=createSceneComparison({pauseEditor(){},saveCurrent:async()=>({path:'current',name:'改稿'}),references:async()=>[{path:'previous',name:'初稿'}],read:async p=>p==='previous'?before:after,
+ render:async(d,p,out,start,count,progress)=>{calls.push([d,p,start,count]);progress(count,count);},bytes:async()=>new Blob(),newId:()=> 'test'});
+ const complete=new Promise<void>(resolve=>{const off=comparison.subscribe(()=>{if(comparison.state()?.status!=='running'){off();resolve();}});});
+ comparison.start('previous','scene');await complete;
+ expect(comparison.state()?.status).toBe('completed');
+ expect(calls).toEqual([[before,'previous',30,60],[after,'current',45,90]]);
+ expect(comparison.state()?.done).toBe(150);
+ expect(comparison.state()?.before?.name).toBe('初稿');
+ expect(comparison.state()?.after?.name).toBe('改稿');
+});
+
+test('対応する場面がない場合は描画を開始せず失敗を公開する',async()=>{
+ let rendered=false;
+ const comparison=createSceneComparison({pauseEditor(){},saveCurrent:async()=>({path:'current',name:'改稿'}),references:async()=>[{path:'previous',name:'初稿'}],read:async()=>({timeline:defaultTimeline(),manifest:{version:2,entries:[],folders:[]},generationLog:{}} as ProjectDoc),render:async()=>{rendered=true;},bytes:async()=>new Blob(),newId:()=> 'test'});
+ const complete=new Promise<void>(resolve=>{const off=comparison.subscribe(()=>{if(comparison.state()?.status==='failed'){off();resolve();}});});
+ comparison.start('previous','missing');await complete;
+ expect(comparison.state()?.error).toContain('対応する場面がありません');expect(rendered).toBe(false);
+});
