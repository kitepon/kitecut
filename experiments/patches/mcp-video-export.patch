+import { useEffect, useState, useSyncExternalStore } from 'react';
+import type { MediaLibrary } from '@frontstage/ui';
+import type { createMediaRestoration, RestorationInput } from './media-restoration.js';
+import './media-restoration.css';
+export function MediaRestorationPanel({ restoration, library }: { restoration: ReturnType<typeof createMediaRestoration>; library: MediaLibrary }) {
+  const [open, setOpen] = useState(false), [mediaId, setMediaId] = useState('');
+  const [mode, setMode] = useState<RestorationInput['mode']>('stabilize'), [noiseFloor, setNoiseFloor] = useState(-30);
+  const [error, setError] = useState(''), [previewId, setPreviewId] = useState(''), [url, setUrl] = useState('');
+  const state = useSyncExternalStore(restoration.subscribe, restoration.state);
+  const media = useSyncExternalStore(cb => library.subscribe(cb), () => library.getSnapshot()).entries;
+  const selected = media.find(m => m.id === mediaId);
+  const savedSource = selected?.generationInput?.model === 'FFmpeg' ? selected.generationInput.parameters?.mediaId : undefined;
+  const resultId = savedSource ? mediaId : state.status === 'completed' && state.input?.mediaId === mediaId ? state.assetId : undefined;
+  const sourceId = typeof savedSource === 'string' ? savedSource : mediaId;
+  useEffect(() => {
+    let active = true, objectUrl = '';
+    setUrl('');
+    if (open && previewId) void restoration.preview(previewId).then(value => { objectUrl = value; if (active) setUrl(value); else URL.revokeObjectURL(value); }).catch(e => { if (active) setError(String(e)); });
+    return () => { active = false; if (objectUrl) URL.revokeObjectURL(objectUrl); };
+  }, [open, previewId, restoration]);
+  return <div className="restoration-control">
+    <button onClick={() => setOpen(!open)}>素材を補正</button>
+    {open && <section className="restoration-panel" aria-label="素材補正">
+      <h3>素材を補正する</h3>
+      <label>補正する素材<select value={mediaId} onChange={e => { setMediaId(e.target.value); setPreviewId(''); }}>{[<option key="" value="">素材を選ぶ</option>, ...media.filter(m => m.type === 'video' || m.type === 'audio').map(m => <option key={m.id} value={m.id}>{m.name}</option>)]}</select></label>
+      <label>補正の種類<select value={mode} onChange={e => setMode(e.target.value as RestorationInput['mode'])}><option value="stabilize">手ぶれを抑える</option><option value="video-denoise">映像のざらつきを抑える</option><option value="audio-denoise">音声の雑音を抑える</option></select></label>
+      {mode === 'audio-denoise' && <label>雑音の強さ<select value={noiseFloor} onChange={e => setNoiseFloor(Number(e.target.value))}><option value={-40}>小さい</option><option value={-30}>中くらい</option><option value={-20}>大きい</option></select></label>}
+      <p>{mode === 'stabilize' ? '画面の端を切り取り、揺れを抑えます。' : mode === 'video-denoise' ? '細部も変わるため、補正前後を比べてください。' : '音声素材として保存します。声が弱くなる場合は強さを下げてください。'}元の素材は保持します。</p>
+      <button disabled={!mediaId || state.status === 'running'} onClick={() => { setError(''); try { restoration.start({ mediaId, mode, noiseFloor }); } catch (e) { setError(String(e)); } }}>補正して素材へ保存</button>
+      <p role="status">{state.status === 'running' ? '素材を補正しています…' : state.status === 'completed' ? `補正後の素材を保存しました（${state.elapsedSeconds?.toFixed(1)}秒）。` : state.status === 'failed' ? state.error : ''}</p>
+      {error && <p role="alert">{error}</p>}
+      <div className="restoration-compare"><button disabled={!sourceId} onClick={() => setPreviewId(sourceId)}>補正前を見る・聞く</button><button disabled={!resultId} onClick={() => setPreviewId(resultId!)}>補正後を見る・聞く</button></div>
+      {url && <video key={url} src={url} controls aria-label="補正の比較プレビュー"/>}
+      {resultId && <p>補正後の素材を素材一覧からタイムラインへ配置できます。</p>}
+    </section>}
+  </div>;
+}
