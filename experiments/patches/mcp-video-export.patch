@@ -0,0 +1,38 @@
+import { z } from "zod";
+import { createPlaceholderEntry } from "@frontstage/core";
+import type { ToolSpec } from "./types.js";
+import { ok, errorResult } from "./executor.js";
+
+export const localImageSchema = z.object({
+  prompt: z.string().trim().min(1),
+  name: z.string().optional(),
+  server: z.string().url().default("http://127.0.0.1:8188"),
+  width: z.number().int().min(512).max(2048).multipleOf(16).default(1024),
+  height: z.number().int().min(512).max(2048).multipleOf(16).default(1024),
+  seed: z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER).default(42),
+  steps: z.number().int().positive().default(20),
+  modelFile: z.string().default("mage_flow_bf16.safetensors"),
+  textEncoderFile: z.string().default("qwen3vl_4b_bf16.safetensors"),
+  vaeFile: z.string().default("mage_flow_vae_bf16.safetensors"),
+});
+
+export function generateLocalImageTool(): ToolSpec {
+  return {
+    name: "generate_local_image",
+    description: "ローカルの ComfyUI と Mage-Flow で画像を無料生成し、素材一覧へ追加する。生成中は素材に進捗を表示する。返った素材 ID を get_media で確認し、生成完了後 add_clips で配置できる。API キー不要。",
+    inputSchema: localImageSchema,
+    async run(args, ctx) {
+      if (!ctx.generation?.localImage) return errorResult("この環境ではローカル画像生成を利用できません。");
+      const input = localImageSchema.parse(args);
+      const endpoint = `comfyui:${input.server}`;
+      const placeholder = createPlaceholderEntry({
+        id: ctx.newId(), type: "image", name: input.name ?? input.prompt.slice(0, 32), duration: 5, ext: "png",
+        genInput: { prompt: input.prompt, model: endpoint, parameters: input, duration: 5, aspectRatio: `${input.width}:${input.height}`, numImages: 1, outputIndex: 0, createdAt: new Date().toISOString() },
+      });
+      ctx.generation.addPlaceholder(placeholder);
+      const result = await ctx.generation.startJob({ modelEndpoint: endpoint, input, placeholders: [placeholder], model: "Mage-Flow", costCredits: 0 });
+      if ("error" in result) return errorResult(result.error);
+      return ok(JSON.stringify({ assetId: placeholder.id, jobId: result.jobId, status: "generating", seed: input.seed }));
+    },
+  };
+}
