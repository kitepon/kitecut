+
+export function LocalImagePanel({ generate, generateSound, generateSpeech, generateVideo, getImages }: { generate: (input: Record<string, unknown>) => Promise<void>; generateSound: (input: Record<string, unknown>) => Promise<void>; generateSpeech: (input: Record<string, unknown>) => Promise<void>; generateVideo: (input: Record<string, unknown>) => Promise<void>; getImages: () => { id: string; name: string }[] }) {
+  const [open, setOpen] = useState(false), [prompt, setPrompt] = useState('');
+  const [ratio, setRatio] = useState('1024x1024'), [seed, setSeed] = useState('42');
+  const [server, setServer] = useState('http://127.0.0.1:8188');
+  const [busy, setBusy] = useState(false), [message, setMessage] = useState('');
+  return <div className="local-image">
+    <button className="local-image-launch" onClick={() => setOpen(!open)}>✦ ローカル素材生成</button>
