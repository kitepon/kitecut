@@ -0,0 +1,42 @@
+"use strict";
+const fs = require('node:fs');
+const path = require('node:path');
+const { randomUUID } = require('node:crypto');
+
+// 構成案を版ごとに保存する。旧生成記録は読み取り専用で参照する。
+function createStoryPlans({ directory, legacyDirectory, onChange = () => {} }) {
+  let current = null;
+  const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+  function read(id) {
+    const legacy = id.startsWith('legacy:');
+    const key = legacy ? id.slice(7) : id;
+    if (!uuid.test(key)) throw Error('構成のIDが不正です');
+    const raw = JSON.parse(fs.readFileSync(legacy ? path.join(legacyDirectory, key, 'state.json') : path.join(directory, key + '.json'), 'utf8'));
+    if (!legacy) return raw;
+    const brief = raw.request?.brief ?? {};
+    return { id, origin: 'legacy', status: raw.status, savedAt: raw.finishedAt ?? raw.startedAt,
+      context: raw.request?.context, draft: raw.draft ?? null, fps: brief.fps ?? null,
+      facts: typeof brief.productFacts === 'string' ? brief.productFacts : '', direction: typeof brief.direction === 'string' ? brief.direction : '',
+      sources: (brief.evidence ?? []).filter(e => e.clipId && e.mediaId).map(e => ({ evidenceId: e.id, videoClipId: e.clipId, mediaId: e.mediaId })),
+      evidenceNotes: (brief.evidence ?? []).filter(e => e.description).map(e => ({ evidenceId: e.id, mediaId: e.mediaId, observation: e.description, origin: 'human', uncertainty: '', ...(brief.fps ? { startSeconds: e.startFrame / brief.fps, endSeconds: e.endFrame / brief.fps } : {}) })),
+      legacyError: raw.error };
+  }
+  function history() {
+    const ids = fs.existsSync(directory) ? fs.readdirSync(directory).filter(name => name.endsWith('.json') && uuid.test(name.slice(0,-5))).map(name => name.slice(0,-5)) : [];
+    if (fs.existsSync(legacyDirectory)) ids.push(...fs.readdirSync(legacyDirectory, { withFileTypes: true }).filter(e => e.isDirectory() && uuid.test(e.name)).map(e => 'legacy:' + e.name));
+    return ids.map(read).sort((a,b) => b.savedAt.localeCompare(a.savedAt)).map(value => ({ id: value.id, title: value.draft?.title ?? '未完成の構成記録', status: value.status, savedAt: value.savedAt, origin: value.origin }));
+  }
+  function publish(value) { current = value; onChange(structuredClone(value)); return structuredClone(value); }
+  return {
+    history,
+    open: id => publish(read(id)),
+    state() { return current && structuredClone(current); },
+    save(input) {
+      const value = { ...input, id: randomUUID(), savedAt: new Date().toISOString(), origin: 'operator', status: 'saved' };
+      fs.mkdirSync(directory, { recursive: true });
+      fs.writeFileSync(path.join(directory, value.id + '.json'), JSON.stringify(value, null, 2), { flag: 'wx' });
+      return publish(value);
+    },
+  };
+}
+module.exports = { createStoryPlans };
