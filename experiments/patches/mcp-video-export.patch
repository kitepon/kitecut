+      <p role="status">{label}{state.requestSeconds !== undefined && ` · ${state.requestSeconds.toFixed(1)}秒`}</p>
+      {state.status === 'completed' && <><p className="video-search-note">映像から見つけた候補です。境界の時刻は配置後に確認・調整できます。音声や会話の内容は解析していません。</p>
+        {candidates.length === 0 && <p>指定した場面は見つかりませんでした。</p>}
+        <div className="video-search-results">{candidates.map((segment, index) => <button className={selected === index ? 'selected' : ''} key={index} onClick={() => { setSelected(index); setCutFrom(segment.startSeconds); setCutTo(segment.endSeconds); }}><strong>{segment.startSeconds.toFixed(2)}–{segment.endSeconds.toFixed(2)}秒</strong><span>{segment.observation}</span><small>{segment.uncertainty}</small></button>)}</div>
+        {candidates.length > 0 && <><div className="video-search-grid"><label>切り出し開始（秒）<input type="number" step="0.01" value={cutFrom} onChange={event => setCutFrom(Number(event.target.value))}/></label><label>切り出し終了（秒）<input type="number" step="0.01" value={cutTo} onChange={event => setCutTo(Number(event.target.value))}/></label></div>
+          <label>配置するフレーム<input type="number" min="0" step="1" value={position} onChange={event => setPosition(Number(event.target.value))}/></label>
