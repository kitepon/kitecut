+export interface CaptureInput { sourceId?: string; cameraId?: string; microphoneId?: string; audio: 'none' | 'system' | 'application' }
+export interface CaptureState { status: 'idle' | 'starting' | 'recording' | 'saving' | 'completed' | 'failed'; startedAt?: number; path?: string; assetIds?: string[]; error?: string }
+export interface CaptureBridge {
+  display(input: CaptureInput): Promise<MediaStream>;
+  sources(): Promise<{ id: string; name: string }[]>;
+  select(input: CaptureInput): Promise<void>;
+  begin(): Promise<void>;
+  abort(): Promise<void>;
+  append(bytes: ArrayBuffer): Promise<void>;
+  finish(): Promise<{ path: string; bytes: number }>;
+}
+declare global { interface Window { desktopCapture: Omit<CaptureBridge, 'display'>; frontstageAcquireDisplay: () => Promise<void> } }
+
+export function desktopCaptureBridge(): CaptureBridge {
+  return { ...window.desktopCapture, async display(input) {
+    let stream!: MediaStream;
+    window.frontstageAcquireDisplay = async () => {
+      stream = await navigator.mediaDevices.getDisplayMedia({ video: { frameRate: 30 },
+        audio: input.audio === 'none' ? false : { autoGainControl: false, echoCancellation: false, noiseSuppression: false } });
+    };
+    await window.desktopCapture.select(input);
+    return stream;
+  } };
+}
+
+export function createCapture(bridge: CaptureBridge, importFile: (path: string) => Promise<{ assetIds: string[] }>, save: () => Promise<unknown>, project: () => object | null) {
+  let state: CaptureState = { status: 'idle' }, recorder: MediaRecorder | undefined;
+  const listeners = new Set<() => void>();
+  let result: Promise<CaptureState>;
+  const update = (next: CaptureState) => { state = next; for (const listener of listeners) listener(); };
+  return {
+    state: () => state,
+    subscribe: (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; },
+    async sources() {
+      const devices = await navigator.mediaDevices.enumerateDevices();
+      return { screens: await bridge.sources(), cameras: devices.filter(d => d.kind === 'videoinput').map(d => ({ id: d.deviceId, name: d.label || 'カメラ' })), microphones: devices.filter(d => d.kind === 'audioinput').map(d => ({ id: d.deviceId, name: d.label || 'マイク' })) };
+    },
+    async start(input: CaptureInput) {
+      if (['starting', 'recording', 'saving'].includes(state.status)) throw Error('収録中です。停止してから次の収録を始めてください。');
+      const origin = project();
+      if (!origin) throw Error('収録を始める前にプロジェクトを保存してください。');
+      const ensureProject = () => { if (project() !== origin) throw Error('収録中にプロジェクトが変わったため、素材を適用できません。収録ファイルはVideosに保存しました。'); };
+      update({ status: 'starting' });
+      const streams: MediaStream[] = [];
+      let audioContext: AudioContext | undefined;
+      const release = () => { streams.forEach(stream => stream.getTracks().forEach(track => track.stop())); if (audioContext) void audioContext.close(); };
+      try {
+        let video: MediaStream;
+        if (input.cameraId) video = await navigator.mediaDevices.getUserMedia({ video: { deviceId: { exact: input.cameraId } }, audio: false });
+        else video = await bridge.display(input);
+        streams.push(video);
+        if (input.microphoneId) streams.push(await navigator.mediaDevices.getUserMedia({ video: false, audio: { deviceId: { exact: input.microphoneId } } }));
+        const audioStreams = streams.filter(stream => stream.getAudioTracks().length);
+        const combined = new MediaStream(video.getVideoTracks());
+        if (audioStreams.length) {
+          audioContext = new AudioContext();
+          const destination = audioContext.createMediaStreamDestination();
+          audioStreams.forEach(stream => audioContext!.createMediaStreamSource(stream).connect(destination));
+          destination.stream.getAudioTracks().forEach(track => combined.addTrack(track));
+          await audioContext.resume();
+        }
+        recorder = new MediaRecorder(combined, { mimeType: 'video/mp4;codecs=avc1.42001E,mp4a.40.2' });
+        await bridge.begin();
+        let writes = Promise.resolve();
+        recorder.ondataavailable = event => { if (event.data.size) writes = writes.then(async () => bridge.append(await event.data.arrayBuffer())); };
+        result = new Promise(resolve => {
+          recorder!.onerror = event => { update({ status: 'failed', error: String((event as ErrorEvent).error ?? '録画中にエラーが発生しました。') }); };
+          recorder!.onstop = async () => {
+            release();
+            const recordingError = state.status === 'failed' ? state.error : undefined;
+            update({ ...state, status: 'saving' });
+            let savedPath: string | undefined;
+            try {
+              await writes;
+              const file = await bridge.finish();
+              savedPath = file.path;
+              ensureProject();
+              const imported = await importFile(file.path);
+              ensureProject();
+              if (await save() === false) throw Error('収録素材をプロジェクトへ保存できませんでした。');
+              ensureProject();
+              update({ status: recordingError ? 'failed' : 'completed', path: file.path, assetIds: imported.assetIds, ...(recordingError ? { error: recordingError } : {}) });
+            } catch (error) { await bridge.abort(); update({ status: 'failed', ...(savedPath ? { path: savedPath } : {}), error: String(error) }); }
+            resolve(state);
+          };
+        });
+        recorder.start(1000);
+        video.getVideoTracks()[0]!.onended = () => { if (recorder?.state === 'recording') recorder.stop(); };
+        update({ status: 'recording', startedAt: Date.now() });
+        return state;
+      } catch (error) { release(); await bridge.abort(); update({ status: 'failed', error: String(error) }); throw error; }
+    },
+    async stop() {
+      if (!recorder || recorder.state !== 'recording') throw Error('録画中ではありません。');
+      recorder.stop();
+      const final = await result;
+      if (final.status === 'failed') throw Error(final.error);
+      return final;
+    },
+  };
+}
