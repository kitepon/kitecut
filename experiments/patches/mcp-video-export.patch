+// @vitest-environment jsdom
+import { test, expect } from "vitest";
+import { fireEvent, render, screen, cleanup } from "@testing-library/react";
+import { EditorStore, defaultTimeline, editTimingMarkersCommand, clipFromAsset, volumeAt } from "@frontstage/core";
+import { TimingMarkersPanel } from "../src/timeline/TimingMarkersPanel.js";
+import { act } from "react";
+
+test("GUIの修正とAIの目印が同じパネルへ反映され、削除を取り消せる", () => {
+  const store = new EditorStore(defaultTimeline());
+  store.setPlayhead(45);
+  render(<TimingMarkersPanel store={store} />);
+  fireEvent.click(screen.getByRole("button", { name: /音の目印/ }));
+  fireEvent.click(screen.getByRole("button", { name: /再生位置に目印/ }));
+  const label = screen.getByLabelText("目印の名前");
+  fireEvent.change(label, { target: { value: "製品名を見せる" } });
+  fireEvent.blur(label);
+  expect(store.getSnapshot().timeline.markers![0]).toMatchObject({ frame: 45, label: "製品名を見せる" });
+  act(() => store.dispatch(editTimingMarkersCommand([{ id: "ai", frame: 90, label: "効果音", kind: "effect" }])));
+  expect(screen.getByText("効果音", { selector: "span" })).toBeTruthy();
+  fireEvent.click(screen.getByRole("button", { name: "目印を削除" }));
+  expect(store.getSnapshot().timeline.markers).toHaveLength(1);
+  act(() => store.undo());
+  expect(screen.getByText("製品名を見せる")).toBeTruthy();
+  cleanup();
+});
+
+test("GUIで指定した減衰をBGMへ適用し、Undoで戻せる", () => {
+  const clip = clipFromAsset({ id: "music", name: "BGM", type: "audio", duration: 4, source: { kind: "project", relativePath: "music.wav" } }, 30, 0, () => "bgm");
+  const store = new EditorStore({ ...defaultTimeline(), markers: [{ id: "speech", kind: "speech", frame: 30, endFrame: 60, label: "発話" }], tracks: [{ id: "audio", type: "audio", muted: false, hidden: false, syncLocked: true, clips: [clip] }] });
+  store.select(["bgm"]);
+  render(<TimingMarkersPanel store={store} />);
+  fireEvent.click(screen.getByRole("button", { name: /音の目印/ }));
+  fireEvent.click(screen.getByText("発話中のBGMを下げる"));
+  fireEvent.change(screen.getByLabelText("BGMの減衰dB"), { target: { value: "-6" } });
+  fireEvent.click(screen.getByRole("button", { name: "選択したBGMへ適用" }));
+  expect(volumeAt(store.getSnapshot().timeline.tracks[0]!.clips[0]!, 40)).toBeCloseTo(10 ** (-6 / 20), 12);
+  act(() => store.undo());
+  expect(store.getSnapshot().timeline.tracks[0]!.clips[0]).toBe(clip);
+  cleanup();
+});
