@@ -0,0 +1,28 @@
+import { test, expect } from 'vitest';
+import { createRequire } from 'node:module';
+import { execFileSync } from 'node:child_process';
+import { mkdtemp, writeFile, rm } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+const require = createRequire(import.meta.url);
+const { restoreMedia } = require('../src/main/media-restoration.cjs');
+const ffmpeg = require('ffmpeg-static'), ffprobe = require('ffprobe-static').path;
+
+test('補正後も映像フレーム数と音声の長さを保持し、無効な入力を拒否する', async () => {
+  const dir = await mkdtemp(path.join(os.tmpdir(), 'restoration-test-'));
+  try {
+    const source = path.join(dir, 'source.mp4');
+    execFileSync(ffmpeg, ['-v', 'error', '-f', 'lavfi', '-i', 'testsrc2=s=160x96:r=30:d=0.4', '-f', 'lavfi', '-i', 'sine=frequency=500:sample_rate=44100:duration=0.4', '-c:v', 'libx264', '-c:a', 'aac', '-shortest', source]);
+    for (const mode of ['stabilize', 'video-denoise', 'audio-denoise']) {
+      const result = await restoreMedia({ path: source, mode }, ffmpeg, ffprobe);
+      const output = path.join(dir, mode + (mode === 'audio-denoise' ? '.wav' : '.mp4'));
+      await writeFile(output, result.bytes);
+      const metadata = JSON.parse(execFileSync(ffprobe, ['-v', 'error', '-show_streams', '-of', 'json', output], { encoding: 'utf8' }));
+      if (mode !== 'audio-denoise') expect(Number(metadata.streams.find((s: any) => s.codec_type === 'video').nb_frames)).toBe(12);
+      else expect(result.duration).toBeCloseTo(0.4, 2);
+      expect(result.elapsedSeconds).toBeGreaterThan(0);
+    }
+    await expect(restoreMedia({ path: source, mode: 'audio-denoise', noiseFloor: 3 }, ffmpeg, ffprobe)).rejects.toThrow('雑音レベル');
+    await expect(restoreMedia({ path: path.join(dir, 'missing.mp4'), mode: 'stabilize' }, ffmpeg, ffprobe)).rejects.toThrow('素材補正に失敗');
+  } finally { await rm(dir, { recursive: true, force: true }); }
+}, 30000);
