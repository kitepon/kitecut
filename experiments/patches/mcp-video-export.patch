+// @vitest-environment jsdom
+import {test,expect} from 'vitest';
+import {render,screen,fireEvent,cleanup} from '@testing-library/react';
+import {act} from 'react';
+import {EditorStore,TimelineSchema,ClipSchema,createGraphic,setGraphicCommand} from '@frontstage/core';
+import {buildCatalog} from '@frontstage/ai';
+import {BrandKitsPanel} from '../src/timeline/BrandKitsPanel.js';
+
+test('GUIで登録した素材をMCPで配置し、保存再開とUndoを通じて元から独立して保持する',async()=>{
+ const graphic=createGraphic('見出し','その瞬間を。');
+ const clip=ClipSchema.parse({id:'title',mediaRef:'m',mediaType:'text',sourceClipType:'text',startFrame:4,durationFrames:80,graphic,sceneGroup:{id:'scene',name:'元場面'}});
+ const store=new EditorStore(TimelineSchema.parse({tracks:[{id:'t',type:'text',clips:[clip]}]}));store.select(['title']);
+ render(<BrandKitsPanel store={store}/>);
+ fireEvent.click(screen.getByRole('button',{name:'ブランド素材 0'}));
+ fireEvent.change(screen.getByLabelText('素材名'),{target:{value:'LiveTR 見出し'}});
+ fireEvent.click(screen.getByText('選択したグラフィックを登録'));
+ const saved=TimelineSchema.parse(JSON.parse(JSON.stringify(store.getSnapshot().timeline)));
+ expect(saved.brandKits![0]!.clip.graphic).toEqual(graphic);
+ act(()=>store.dispatch(setGraphicCommand('title',{...graphic,name:'変更後'})));
+ expect(store.getSnapshot().timeline.brandKits![0]!.clip.graphic!.name).toBe('見出し');
+ const ctx={store,newId:()=>crypto.randomUUID(),getManifest:()=>({version:2 as const,entries:[],folders:[]})};
+ const spec=buildCatalog().find(t=>t.name==='apply_brand_kit')!;
+ await act(async()=>{await spec.run({kitId:saved.brandKits![0]!.id,startFrame:120},ctx);});
+ const copy=store.getSnapshot().timeline.tracks[0]!.clips[0]!;
+ expect(copy.graphic).toEqual(graphic);expect(copy.startFrame).toBe(120);expect(copy.sceneGroup).toBeUndefined();
+ act(()=>store.undo());expect(store.getSnapshot().timeline.tracks).toHaveLength(1);
+ fireEvent.click(screen.getByLabelText('LiveTR 見出しの登録を削除'));
+ expect(screen.getByText('ブランド素材 0')).toBeTruthy();
+ act(()=>store.undo());expect(screen.getByLabelText('LiveTR 見出しを配置')).toBeTruthy();
+ cleanup();
+});
