+import { test, expect, vi } from "vitest";
+import { EditorStore, defaultTimeline, clipFromAsset, setClipPropertyCommand } from "@frontstage/core";
+import { speechTimingTools } from "../src/tools/speech-timing-tools.js";
+import { ToolExecutor } from "../src/tools/executor.js";
+import type { ToolContext } from "../src/tools/types.js";
+
+function fixture(cached: boolean) {
+  const entry = { id: "media", name: "声", type: "audio" as const, duration: 4, source: { kind: "project" as const, relativePath: "声.wav" } };
+  const clip = clipFromAsset(entry, 30, 30, () => "clip");
+  const store = new EditorStore({ ...defaultTimeline(), tracks: [{ id: "track", type: "audio", muted: false, hidden: false, syncLocked: true, clips: [clip] }] });
+  const result = { text: "こんにちは", words: [], segments: [{ text: "こんにちは", start: 1, end: 2 }] };
+  const prepareLocal = vi.fn(async () => {}), transcribe = vi.fn(async () => result);
+  const ctx: ToolContext = { store, newId: () => crypto.randomUUID(), getManifest: () => ({ version: 2, entries: [entry], folders: [] }), transcription: { cachedTranscript: async () => cached ? result : null, prepareLocal, transcribe, hasKey: async () => true, estimateCredits: () => 0 } };
+  const executor = new ToolExecutor(speechTimingTools(), ctx);
+  async function call(name: string, args: unknown) { const response = await executor.execute(name, args); if (response.isError) throw Error(JSON.stringify(response)); const b = response.blocks[0]!; if (b.kind !== "text") throw Error("文字応答がありません"); return JSON.parse(b.text); }
+  return { store, prepareLocal, transcribe, executor, call };
+}
+
+test("キャッシュを活用し、解析だけでは編集せず、適用を一回のUndoへまとめる", async () => {
+  const f = fixture(true), before = f.store.getSnapshot().timeline;
+  const job = await f.call("analyze_speech_timing", { clipId: "clip" });
+  await vi.waitFor(async () => expect((await f.call("analyze_speech_timing", { jobId: job.jobId })).status).toBe("completed"));
+  expect(f.store.getSnapshot().timeline).toBe(before); expect(f.prepareLocal).not.toHaveBeenCalled();
+  await f.call("apply_speech_timing", { jobId: job.jobId });
+  expect(f.store.getSnapshot().timeline.markers![0]).toMatchObject({ frame: 60, endFrame: 90, label: "こんにちは" });
+  await f.call("apply_speech_timing", { jobId: job.jobId });
+  expect(f.store.getSnapshot().timeline.markers).toHaveLength(1);
+  f.store.undo(); expect(f.store.getSnapshot().timeline).toBe(before);
+});
+test("未認識ならローカルを強制し、解析後の時刻変更へ古い結果を適用しない", async () => {
+  const f = fixture(false);
+  const job = await f.call("analyze_speech_timing", { clipId: "clip" });
+  await vi.waitFor(async () => expect((await f.call("analyze_speech_timing", { jobId: job.jobId })).status).toBe("completed"));
+  expect(f.prepareLocal).toHaveBeenCalledOnce(); expect(f.transcribe).toHaveBeenCalledWith("media", { forceLocal: true });
+  f.store.dispatch(setClipPropertyCommand("clip", "startFrame", 60));
+  const before = f.store.getSnapshot().timeline;
+  expect((await f.executor.execute("apply_speech_timing", { jobId: job.jobId })).isError).toBe(true);
+  expect(f.store.getSnapshot().timeline).toBe(before);
+});
