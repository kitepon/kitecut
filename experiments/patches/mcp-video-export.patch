@@ -0,0 +1,21 @@
+import { test, expect } from 'vitest';
+import { synthesizeSoundEffect } from '../src/generation/sound-effect.js';
+
+test('効果音は指定尺のPCMで、両端が無音になり、飽和しない', () => {
+  for (const preset of ['chime', 'whoosh', 'arrival'] as const) {
+    const bytes = synthesizeSoundEffect({ preset, duration: 1.2, pitch: 587.33, seed: 42 });
+    const view = new DataView(bytes.buffer);
+    expect(view.getUint32(24, true)).toBe(48000);
+    expect(view.getUint32(40, true)).toBe(57600 * 2);
+    let peak = 0;
+    for (let offset = 44; offset < bytes.length; offset += 2) peak = Math.max(peak, Math.abs(view.getInt16(offset, true)));
+    expect(peak).toBeGreaterThan(500); expect(peak).toBeLessThan(32767);
+    expect(view.getInt16(44, true)).toBe(0); expect(view.getInt16(bytes.length - 2, true)).toBe(0);
+  }
+});
+
+test('同じ条件の切替音を再現でき、seedを変えると波形が変わる', () => {
+  const input = { preset: 'whoosh' as const, duration: .5, pitch: 500, seed: 12 };
+  expect(synthesizeSoundEffect(input)).toEqual(synthesizeSoundEffect(input));
+  expect(synthesizeSoundEffect(input)).not.toEqual(synthesizeSoundEffect({ ...input, seed: 13 }));
+});
