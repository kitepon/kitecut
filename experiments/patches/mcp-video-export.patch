+const nemo = createRequire(import.meta.url)('../src/main/local-speech-nemo.cjs');
+afterEach(() => vi.unstubAllGlobals());
+
+test('接続先が別エンジンなら原稿を送らず失敗する', async () => {
+  const fetcher = vi.fn().mockResolvedValue(new Response(JSON.stringify({ uuid: 'other' })));
+  vi.stubGlobal('fetch', fetcher);
+  await expect(nemo.generate({ text: '本文', speed: 1 }, { endpoint: 'http://localhost:50121' })).rejects.toThrow('指定先はVOICEVOX Nemoではありません');
+  expect(fetcher).toHaveBeenCalledTimes(1);
+});
+
+test('外部エンジンの合成失敗をそのまま返す', async () => {
+  const response = (data: unknown) => new Response(JSON.stringify(data));
+  const fetcher = vi.fn().mockResolvedValueOnce(response({ uuid: '208cf94d-43d2-4cf5-abc0-9783cac36d29' }))
+    .mockResolvedValueOnce(response('0.24.0')).mockResolvedValueOnce(response({ speedScale: 1 }))
+    .mockResolvedValueOnce(new Response('音声合成に失敗', { status: 500 }));
+  vi.stubGlobal('fetch', fetcher);
+  await expect(nemo.generate({ text: '字幕といっしょに。', speed: 1.25 }, { endpoint: 'http://localhost:50121' })).rejects.toThrow('音声合成に失敗');
+  expect(new URL(fetcher.mock.calls[2]![0]).searchParams.get('text')).toBe('字幕といっしょに。');
+  expect(new URL(fetcher.mock.calls[2]![0]).searchParams.get('speaker')).toBe('10006');
