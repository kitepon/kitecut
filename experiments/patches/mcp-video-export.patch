+import { afterEach, expect, test, vi } from 'vitest';
+import { createCapture } from '../src/renderer/capture.js';
+afterEach(() => vi.unstubAllGlobals());
+const savedProject = {};
+test('録画中の作品切替ではMP4を保持して取込みと保存を拒否する', async () => {
+  const track = { stop: vi.fn(), onended: null };
+  const stream = { getTracks: () => [track], getVideoTracks: () => [track], getAudioTracks: () => [] };
+  vi.stubGlobal('MediaStream', class {});
+  vi.stubGlobal('MediaRecorder', class {
+    state = 'inactive'; onstop: any;
+    start() { this.state = 'recording'; }
+    stop() { this.state = 'inactive'; void this.onstop(); }
+  });
+  let project = {};
+  const imported = vi.fn(async () => ({ assetIds: ['recorded'] })), save = vi.fn();
+  const capture = createCapture({ display: async () => stream as unknown as MediaStream, sources: vi.fn(), select: vi.fn(), begin: vi.fn(), abort: vi.fn(), append: vi.fn(), finish: async () => ({ path: 'Videos/収録.mp4', bytes: 15 }) }, imported, save, () => project);
+  await capture.start({ sourceId: 'window:1', audio: 'none' });
+  project = {};
+  await expect(capture.stop()).rejects.toThrow('プロジェクト');
+  expect(imported).not.toHaveBeenCalled();
+  expect(save).not.toHaveBeenCalled();
+  expect(capture.state()).toMatchObject({ status: 'failed', path: 'Videos/収録.mp4' });
+  expect(track.stop).toHaveBeenCalledOnce();
+});
+test('停止時の最後のデータを書き終えてから取込み・保存する', async () => {
+  const track = { stop: vi.fn(), onended: null };
+  const stream = { getTracks: () => [track], getVideoTracks: () => [track], getAudioTracks: () => [] };
+  vi.stubGlobal('navigator', { mediaDevices: { getDisplayMedia: async () => stream } });
+  vi.stubGlobal('MediaStream', class { getTracks() { return [track]; } });
+  vi.stubGlobal('MediaRecorder', class {
+    state = 'inactive'; ondataavailable: any; onstop: any;
+    start() { this.state = 'recording'; }
+    stop() { this.state = 'inactive'; this.ondataavailable({ data: new Blob(['最後の映像']) }); void this.onstop(); }
+  });
+  let release!: () => void;
+  const pending = new Promise<void>(resolve => { release = resolve; });
+  const order: string[] = [];
+  const capture = createCapture({ display: async () => stream as unknown as MediaStream, sources: vi.fn(), select: vi.fn(), begin: vi.fn(), abort: vi.fn(),
+    append: async bytes => { expect(new TextDecoder().decode(bytes)).toBe('最後の映像'); await pending; order.push('書込み'); },
+    finish: async () => { order.push('確定'); return { path: '収録.mp4', bytes: 15 }; },
+  }, async () => { order.push('取込み'); return { assetIds: ['recorded'] }; }, async () => { order.push('保存'); }, () => savedProject);
+  await capture.start({ sourceId: 'window:1', audio: 'none' });
+  const stopped = capture.stop();
+  expect(capture.state().status).toBe('saving');
+  expect(order).toEqual([]);
+  release();
+  expect((await stopped).assetIds).toEqual(['recorded']);
+  expect(order).toEqual(['書込み', '確定', '取込み', '保存']);
+  expect(track.stop).toHaveBeenCalledOnce();
+});
+test('マイク取得が失敗したら先に取得した画面の収録を解放する', async () => {
+  const stop = vi.fn();
+  vi.stubGlobal('navigator', { mediaDevices: { getDisplayMedia: async () => ({ getTracks: () => [{ stop }] }), getUserMedia: async () => { throw Error('マイクへのアクセス拒否'); } } });
+  const capture = createCapture({ display: () => navigator.mediaDevices.getDisplayMedia(), sources: vi.fn(), select: vi.fn(), begin: vi.fn(), append: vi.fn(), finish: vi.fn(), abort: vi.fn() }, vi.fn(), vi.fn(), () => savedProject);
+  await expect(capture.start({ sourceId: 'window:1', microphoneId: 'mic', audio: 'none' })).rejects.toThrow('マイクへのアクセス拒否');
+  expect(stop).toHaveBeenCalledOnce();
+  expect(capture.state().status).toBe('failed');
+});
