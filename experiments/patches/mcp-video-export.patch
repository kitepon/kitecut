+      <p>作りたい背景や雰囲気を言葉に。生成した画像は素材一覧に追加されます。</p>
+      <form onSubmit={async event => {
+        event.preventDefault(); setBusy(true); setMessage('');
+        const [width, height] = ratio.split('x').map(Number);
+        try { await generate({ prompt, width, height, seed: Number(seed), server }); setMessage('生成を開始しました。素材一覧で進捗を確認できます。'); }
+        catch (error) { setMessage(String(error)); }
+        finally { setBusy(false); }
+      }}>
+        <label>作りたい画像<textarea required rows={6} value={prompt} onChange={event => setPrompt(event.target.value)} placeholder="濃いチャコールの空間に、琥珀色のガラスが柔らかく浮かぶ。中央にはタイトルを置く余白。文字は入れない。" /></label>
+        <div className="local-image-row"><label>構図<select value={ratio} onChange={event => setRatio(event.target.value)}><option value="1024x1024">正方形</option><option value="1536x864">横長 16:9</option><option value="864x1536">縦長 9:16</option></select></label><label>バリエーション番号<input type="number" min="0" step="1" value={seed} onChange={event => setSeed(event.target.value)} /></label></div>
+        <details><summary>接続設定</summary><label>ComfyUI のアドレス<input type="url" required value={server} onChange={event => setServer(event.target.value)} /></label><p>Mage-Flow、Qwen3-VL-4B、Mage-VAE を導入した ComfyUI に接続します。</p></details>
+        <button className="local-image-generate" type="submit" disabled={busy}>{busy ? '生成を受け付けています…' : 'このPCで生成する'}</button>
+        <small>API料金なし · Mage-Flow</small>
+        {message && <p role="status">{message}</p>}
+      </form>
+    </aside>}
+  </div>;
+}
+
+function VideoForm({ generate, getImages, server }: { generate: (input: Record<string, unknown>) => Promise<void>; getImages: () => { id: string; name: string }[]; server: string }) {
+  const [images, setImages] = useState<{ id: string; name: string }[]>([]);
+  const [mediaId, setMediaId] = useState(''), [prompt, setPrompt] = useState('');
+  const [busy, setBusy] = useState(false), [message, setMessage] = useState('');
+  return <details onToggle={event => { if (event.currentTarget.open) setImages(getImages()); }}><summary>画像から背景動画をつくる</summary><form onSubmit={async event => {
