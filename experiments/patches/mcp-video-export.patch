+import {useState} from 'react';
+import {createPortal} from 'react-dom';
+import './timing-markers.css';
+import {registerBrandKitCommand,applyBrandKitCommand,removeBrandKitCommand,type EditorStore} from '@frontstage/core';
+import {useStore} from '../store/use-store.js';
+
+export function BrandKitsPanel({store}:{store:EditorStore}) {
+  const [open,setOpen]=useState(false),[name,setName]=useState(''),[error,setError]=useState('');
+  const kits=useStore(store,s=>s.timeline.brandKits);
+  const run=(fn:()=>void)=>{setError('');try{fn();}catch(e){setError(String(e));}};
+  const id=()=>crypto.randomUUID();
+  return <div className="timing-markers" style={{left:'auto',right:8}}><button className="timing-trigger" aria-expanded={open} onClick={()=>setOpen(!open)}>ブランド素材 {kits?.length??0}</button>{open&&createPortal(<div className="timing-markers timing-overlay"><section className="timing-popover" role="dialog" aria-label="ブランド素材">
+    <header><strong>ブランド素材</strong><button aria-label="ブランド素材を閉じる" onClick={()=>setOpen(false)}>×</button></header>
+    <p>このプロジェクトの文字・色・画像・動きをセットで保存します。</p>
+    <div className="timing-fields"><label>素材名<input aria-label="素材名" placeholder="素材名" value={name} onChange={e=>setName(e.target.value)}/></label></div>
+    <button className="timing-add" onClick={()=>run(()=>{const s=store.getSnapshot();if(s.selection.size!==1)throw Error('グラフィックを一つ選択してください');store.dispatch(registerBrandKitCommand([...s.selection][0]!,name,id()));setName('');})}>選択したグラフィックを登録</button>
+    {(kits??[]).map(k=><div key={k.id} style={{display:'flex',gap:8,padding:'8px 0'}}><span>{k.name}</span><button aria-label={`${k.name}を配置`} onClick={()=>run(()=>{const clipId=id();store.dispatch(applyBrandKitCommand(k.id,store.getSnapshot().playhead,clipId,id));store.select([clipId]);})}>再生位置に配置</button><button aria-label={`${k.name}の登録を削除`} onClick={()=>run(()=>store.dispatch(removeBrandKitCommand(k.id)))}>登録を削除</button></div>)}
