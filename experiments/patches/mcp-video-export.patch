@@ -0,0 +1,64 @@
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+import { act, renderHook, cleanup } from "@testing-library/react";
+import type { EditorStore } from "@frontstage/core";
+import type { PlaybackEngine } from "@frontstage/engine";
+import { useFrameHistograms } from "../src/inspector/adjust/use-frame-histograms.js";
+
+class TestWorker {
+  static instances: TestWorker[] = [];
+  onmessage?: (event: { data: unknown }) => void;
+  onerror?: (event: { message: string }) => void;
+  postMessage = vi.fn();
+  terminate = vi.fn();
+  constructor() { TestWorker.instances.push(this); }
+}
+beforeEach(() => {
+  vi.useFakeTimers();
+  TestWorker.instances = [];
+  vi.stubGlobal("Worker", TestWorker);
+  vi.stubGlobal("requestAnimationFrame", (callback: () => void) => setTimeout(callback, 0));
+  vi.stubGlobal("cancelAnimationFrame", (id: number) => clearTimeout(id));
+});
+afterEach(() => { cleanup(); vi.unstubAllGlobals(); vi.useRealTimers(); });
+function setup() {
+  let state = { timeline: {}, selection: new Set<string>(), playhead: 0 };
+  const listeners = new Set<() => void>();
+  const store = { getSnapshot: () => state, subscribe: (cb: () => void) => { listeners.add(cb); return () => listeners.delete(cb); } } as unknown as EditorStore;
+  const readRGBA = vi.fn(async () => new Uint8Array(16));
+  const engineRef = { current: { width: 2, height: 2, readRGBA } as unknown as PlaybackEngine };
+  const update = () => { state = { ...state, playhead: state.playhead + 1 }; listeners.forEach(cb => cb()); };
+  return { store, engineRef, readRGBA, update };
+}
+test("非表示では解析せず、表示中も処理待ちを一件にまとめる", async () => {
+  const s = setup();
+  const hook = renderHook(({ enabled }) => useFrameHistograms(s.store, s.engineRef, enabled), { initialProps: { enabled: false } });
+  await act(() => vi.runAllTimersAsync());
+  expect(TestWorker.instances).toHaveLength(0);
+  hook.rerender({ enabled: true });
+  await act(() => vi.runAllTimersAsync());
+  const worker = TestWorker.instances[0]!;
+  expect(s.readRGBA).toHaveBeenCalledTimes(1);
+  act(() => { for (let i = 0; i < 100; i++) s.update(); });
+  await act(() => vi.runAllTimersAsync());
+  expect(s.readRGBA).toHaveBeenCalledTimes(1);
+  const data = { yrgb: { y: [4], r: [4], g: [4], b: [4] }, hue: [0] };
+  act(() => worker.onmessage?.({ data }));
+  await act(() => vi.runAllTimersAsync());
+  expect(s.readRGBA).toHaveBeenCalledTimes(2);
+  expect(hook.result.current.histogram).toEqual(data.yrgb);
+  hook.rerender({ enabled: false });
+  expect(worker.terminate).toHaveBeenCalledTimes(1);
+  act(() => s.update());
+  await act(() => vi.runAllTimersAsync());
+  expect(s.readRGBA).toHaveBeenCalledTimes(2);
+});
+test("読取り失敗を表示し、失敗した処理を無限に再投入しない", async () => {
+  const s = setup();
+  s.readRGBA.mockRejectedValueOnce(new Error("GPU読取り失敗"));
+  const hook = renderHook(() => useFrameHistograms(s.store, s.engineRef, true));
+  await act(() => vi.runAllTimersAsync());
+  expect(hook.result.current.histogramError).toContain("GPU読取り失敗");
+  act(() => s.update());
+  await act(() => vi.runAllTimersAsync());
+  expect(s.readRGBA).toHaveBeenCalledTimes(1);
+});
