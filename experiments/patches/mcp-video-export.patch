+import {z} from 'zod';
+const finite=z.number().finite();
+export const TextMotionSchema=z.object({
+  unit:z.enum(['grapheme','word']).default('grapheme'),
+  startFrame:finite.int().nonnegative().default(0),
+  staggerFrames:finite.int().nonnegative().default(2),
+  durationFrames:finite.int().positive().default(12),
+  offsetX:finite.default(0),offsetY:finite.default(40),scale:finite.positive().default(0.9),
+  curve:z.tuple([finite.min(0).max(1),finite,finite.min(0).max(1),finite]).default([0.22,1,0.36,1]),
+});
+export type TextMotion=z.infer<typeof TextMotionSchema>;
+export function textUnits(text:string,unit:TextMotion['unit']):string[]{
+  return [...new Intl.Segmenter('ja',{granularity:unit}).segment(text)].map(s=>s.segment);
+}
+export function motionEase(t:number,curve:TextMotion['curve']):number{
+  if(t<=0)return 0;if(t>=1)return 1;
+  const cubic=(u:number,a:number,b:number)=>3*(1-u)*(1-u)*u*a+3*(1-u)*u*u*b+u*u*u;
+  let lo=0,hi=1;
+  for(let i=0;i<24;i++){const mid=(lo+hi)/2;if(cubic(mid,curve[0],curve[2])<t)lo=mid;else hi=mid;}
+  return cubic((lo+hi)/2,curve[1],curve[3]);
+}
+export function textUnitPose(m:TextMotion,index:number,frame:number){
+  const progress=Math.max(0,Math.min(1,(frame-m.startFrame-index*m.staggerFrames)/m.durationFrames));
+  const eased=motionEase(progress,m.curve);
+  return {opacity:progress,x:m.offsetX*(1-eased),y:m.offsetY*(1-eased),scale:1+(m.scale-1)*(1-eased)};
+}
