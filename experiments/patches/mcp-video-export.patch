+   <h3>パーツの動き</h3><p>現在の時刻に値を記録します。グループを選ぶと子も一緒に動きます。</p>{(["x", "y", "rotation", "scaleX", "scaleY", "opacity"] as const).map(key => <div key={key} className="graphic-key"><span>{({ x: "横位置", y: "縦位置", rotation: "回転", scaleX: "横倍率", scaleY: "縦倍率", opacity: "不透明度" })[key]}</span><button onClick={() => { const at = Math.max(0, Math.round(clip.trimStartFrame + (playhead - clip.startFrame) * clip.speed)); const keys = [...(node.motion?.[key]?.keyframes ?? []).filter(k => k.frame !== at), { frame: at, value: graphicNodeAt(node, at)[key], interpolationOut: "smooth" as const }].sort((a, b) => a.frame - b.frame); patch({ motion: { ...node.motion, [key]: { keyframes: keys } } }); }}>◆ 記録</button><button onClick={() => patch({ motion: { ...node.motion, [key]: undefined } })}>解除</button><small>{node.motion?.[key]?.keyframes.map(k => k.frame + ":" + k.value).join(" / ")}</small></div>)}
+  </> : <p>パーツを選んで編集してください。</p>}</aside></div>{error && <div className="graphic-error" role="alert">{error}</div>}
+ </div></div>}</div>;
+}
