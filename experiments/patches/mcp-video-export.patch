+import { test, expect } from "vitest";
+import { EditorStore } from "./editor-store.js";
+import { clipFromAsset } from "./timeline-commands.js";
+import { defaultTimeline } from "../timeline.js";
+import { volumeAt } from "../clip.js";
+import { decodeProjectFiles } from "../schema/serialize.js";
+import { duckingCommand } from "./ducking-command.js";
+
+function fixture() {
+  const clip = clipFromAsset({ id: "music", name: "BGM", type: "audio", source: { kind: "project", relativePath: "music.wav" }, duration: 4 }, 30, 10, () => "bgm");
+  clip.volume = 0.5;
+  clip.fadeInFrames = 5;
+  clip.volumeTrack = { keyframes: [{ frame: 0, value: -3, interpolationOut: "smooth" }, { frame: 90, value: 0, interpolationOut: "hold" }] };
+  return { ...defaultTimeline(), markers: [{ id: "speech", kind: "speech" as const, frame: 40, endFrame: 60, label: "話す" }, { id: "overlap", kind: "speech" as const, frame: 50, endFrame: 70, label: "重なり" }], tracks: [{ id: "audio", type: "audio" as const, muted: false, hidden: false, syncLocked: true, clips: [clip] }] };
+}
+const args = { clipIds: ["bgm"], markerIds: ["speech", "overlap"], reductionDb: -12, attackFrames: 5, releaseFrames: 5 };
+
+test("元の曲線・フェードを保ち、重なる発話でも一重の減衰になる", () => {
+  const before = fixture();
+  const after = duckingCommand(args).apply(before);
+  const a = before.tracks[0]!.clips[0]!, b = after.tracks[0]!.clips[0]!;
+  for (let f = 10; f < 130; f++) {
+    const factor = f < 35 || f >= 75 ? 1 : f < 40 ? 10 ** (-12 * (f - 35) / 5 / 20) : f < 70 ? 10 ** (-12 / 20) : 10 ** (-12 * (1 - (f - 70 + 1) / 6) / 20);
+    expect(volumeAt(b, f)).toBeCloseTo(volumeAt(a, f) * factor, 12);
+  }
+  expect(b.volume).toBe(a.volume);
+  expect(b.fadeInFrames).toBe(a.fadeInFrames);
+});
+test("減衰は保存でき、一回のUndoで元の編集データまで復元する", () => {
+  const before = fixture(); const store = new EditorStore(before);
+  store.dispatch(duckingCommand(args));
+  const after = store.getSnapshot().timeline;
+  expect(decodeProjectFiles({ timeline: JSON.stringify(after) }).timeline.tracks[0]!.clips[0]!.volumeTrack).toEqual(after.tracks[0]!.clips[0]!.volumeTrack);
+  store.undo(); expect(store.getSnapshot().timeline).toBe(before);
+});
+test("不正な対象で一部のクリップだけが変更されることはない", () => {
+  const before = fixture(); const store = new EditorStore(before);
+  expect(() => store.dispatch(duckingCommand({ ...args, clipIds: ["bgm", "missing"] }))).toThrow("ありません");
+  expect(store.getSnapshot().timeline).toBe(before);
+});
+test("前後の復帰時間ゼロとクリップ端の発話を処理する", () => {
+  const before = fixture();
+  before.markers = [{ id: "speech", kind: "speech", frame: 0, endFrame: 30, label: "開始前からの発話" }];
+  const after = duckingCommand({ ...args, markerIds: ["speech"], attackFrames: 0, releaseFrames: 0 }).apply(before);
+  for (const f of [11, 29, 30, 129]) expect(volumeAt(after.tracks[0]!.clips[0]!, f)).toBeCloseTo(volumeAt(before.tracks[0]!.clips[0]!, f) * (f < 30 ? 10 ** (-12 / 20) : 1), 12);
+});
