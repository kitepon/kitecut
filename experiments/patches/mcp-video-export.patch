+import type { ToolContext } from '@frontstage/ai';
+import type { PlaybackEngine } from '@frontstage/engine';
+export function desktopPlayback(ref:{current:PlaybackEngine|null}):NonNullable<ToolContext['playback']>{
+  function engine(){if(!ref.current)throw Error('再生エンジンの準備ができていません');return ref.current;}
+  return {
+    state(){const e=engine();return {currentFrame:e.currentFrame,isPlaying:e.isPlaying,durationFrames:e.durationFrames};},
+    pause(){engine().pause();},
+    async seek(frame){await engine().captureFrame(frame);},
+    async play(){
+      const e=engine();
+      if(e.durationFrames===0)throw Error('再生するクリップがありません');
+      // 再生要求の受理ではなく、描画後のエンジン通知を成功条件にする。
+      await new Promise<void>((resolve,reject)=>{
+        const timeout=setTimeout(()=>{unsubscribe();e.pause();reject(Error('再生開始の描画を10秒以内に確認できませんでした'));},10000);
+        const unsubscribe=e.onStateChange(s=>{clearTimeout(timeout);unsubscribe();if(s.isPlaying)resolve();else reject(Error('再生が開始前に停止しました'));});
+        e.play();
+      });
+    },
+  };
+}
