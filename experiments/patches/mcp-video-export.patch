+import { timelineTotalFrames, type Timeline } from '@frontstage/core';
+
+export function createPosterExporter(deps:{
+  timeline:()=>Timeline;
+  capture:(frame:number)=>Promise<{rgba:Uint8Array;width:number;height:number}>;
+  pick:(name:string)=>Promise<string|null>;
+  write:(path:string,bytes:Uint8Array,overwrite:boolean)=>Promise<string>;
+  encode?:(rgba:Uint8Array,width:number,height:number)=>Promise<Uint8Array>;
+}){
+  return async(frame:number,outputPath?:string,overwrite=false)=>{
+    const timeline=deps.timeline();
+    if(!Number.isSafeInteger(frame)||frame<0||frame>=timelineTotalFrames(timeline))throw Error('ポスターのフレームは動画の範囲内で指定してください');
+    const path=outputPath??await deps.pick(`poster-${frame}.png`);
+    if(!path)return {status:'cancelled' as const};
+    if(!/\.png$/i.test(path))throw Error('ポスターの保存先には.pngを指定してください');
+    if(deps.timeline()!==timeline)throw Error('保存先の選択中に動画が変更されました');
+    const rendered=await deps.capture(frame);
+    if(deps.timeline()!==timeline)throw Error('ポスターの描画中に動画が変更されました');
+    if(rendered.width!==timeline.width||rendered.height!==timeline.height)throw Error('ポスターの寸法が動画に一致しません');
+    const bytes=await (deps.encode??encodePng)(rendered.rgba,rendered.width,rendered.height);
+    return {status:'exported' as const,path:await deps.write(path,bytes,outputPath?overwrite:true),frame,width:rendered.width,height:rendered.height,fps:timeline.fps};
+  };
+}
+async function encodePng(rgba:Uint8Array,width:number,height:number){
+  const canvas=new OffscreenCanvas(width,height),context=canvas.getContext('2d');
+  if(!context)throw Error('ポスターをPNGへ変換できません');
+  context.putImageData(new ImageData(new Uint8ClampedArray(rgba),width,height),0,0);
+  return new Uint8Array(await (await canvas.convertToBlob({type:'image/png'})).arrayBuffer());
+}
