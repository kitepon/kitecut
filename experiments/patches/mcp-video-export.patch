+    store.dispatch(setSceneBriefCommand({...copy.brief!, copy: "複製用"}));
+    expect(storyboardRows(store.getSnapshot().timeline)[0]!.brief).toEqual(brief);
+    const before = store.getSnapshot().timeline;
+    store.dispatch(ungroupSceneCommand(copy.id));
