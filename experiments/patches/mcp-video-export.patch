@@ -0,0 +1,39 @@
+import { test, expect, vi, afterEach } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+afterEach(() => vi.useRealTimers());
+
+function bridge() {
+  const main = readFileSync(new URL('../src/main/index.cjs', import.meta.url), 'utf8');
+  let response: any, sent: any;
+  const context: any = {
+    setTimeout, clearTimeout,
+    ipcMain: { on: (_name: string, fn: any) => { response = fn; } },
+    BrowserWindow: { getAllWindows: () => [{ isDestroyed: () => false, webContents: { isDestroyed: () => false, send: (_channel: string, data: any) => { sent = data; } } }] },
+  };
+  runInNewContext(main.slice(main.indexOf('const _bridgePending'), main.indexOf('let _mcpServer')) + '\n_authNonceGuard = { mint: () => "nonce", release() {} }; this.call = mcpBridge;', context);
+  return { call: context.call, respond: (result: unknown) => response(null, { id: sent.id, result }) };
+}
+
+test('30秒を超える音声生成でも保存完了の応答を受け取る', async () => {
+  vi.useFakeTimers();
+  const b = bridge();
+  let settled = false;
+  const pending = b.call('callTool', { name: 'generate_local_speech' }).then((result: unknown) => { settled = true; return result; }, (error: unknown) => { settled = true; return error; });
+  await vi.advanceTimersByTimeAsync(36000);
+  expect(settled).toBe(false);
+  b.respond({ assetId: 'saved', duration: 4.4 });
+  await expect(pending).resolves.toEqual({ assetId: 'saved', duration: 4.4 });
+  expect(vi.getTimerCount()).toBe(0);
+});
+
+test('通常操作は従来の30秒、音声生成も上限を超えると失敗する', async () => {
+  vi.useFakeTimers();
+  const b = bridge();
+  const normal = b.call('callTool', { name: 'get_media' }).catch((error: Error) => error.message);
+  await vi.advanceTimersByTimeAsync(30000);
+  await expect(normal).resolves.toBe('bridge timeout');
+  const speech = b.call('callTool', { name: 'generate_local_speech' }).catch((error: Error) => error.message);
+  await vi.advanceTimersByTimeAsync(120000);
+  await expect(speech).resolves.toBe('bridge timeout');
+});
