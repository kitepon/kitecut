@@ -0,0 +1,38 @@
+import { GraphicRasterizer } from "@frontstage/engine";
+import { GraphicDocumentSchema } from "@frontstage/core";
+import "./font-pack.js";
+async function main() {
+    const r = new GraphicRasterizer();
+    const results: string[] = [];
+    const d = GraphicDocumentSchema.parse({ version: 1, name: "描画試験", width: 200, height: 200, nodes: [{ id: "g", name: "透過グループ", kind: "group", width: 200, height: 200, opacity: .5 }, { id: "a", parentId: "g", name: "赤", kind: "rect", fill: "#ff0000", width: 100, height: 100 }, { id: "b", parentId: "g", name: "赤2", kind: "rect", x: 50, fill: "#ff0000", width: 100, height: 100 }] });
+    const c = document.createElement("canvas");
+    c.width = 200;
+    c.height = 200;
+    const ctx = c.getContext("2d")!;
+    const pixel = (x: number, y: number) => Array.from(ctx.getImageData(x, y, 1, 1).data);
+    const check = (value: boolean, name: string) => { if (!value)
+        throw Error(name); results.push(name); };
+    await r.prepare([d]);
+    r.draw(ctx, d, 0, d);
+    check(Math.abs(pixel(25, 25)[3]! - pixel(75, 25)[3]!) < 2 && Math.abs(pixel(75, 25)[3]! - 128) < 2, "重なった子もグループ全体で半透明になる");
+    d.nodes = [...GraphicDocumentSchema.parse({ ...d, nodes: [{ id: "circle", kind: "rect", name: "丸で切り抜き", width: 100, height: 100, fill: "#ffffff", mask: { kind: "ellipse" }, gradient: { from: "#ff0000", to: "#0000ff", angle: 0 } }] }).nodes];
+    ctx.clearRect(0, 0, 200, 200);
+    r.draw(ctx, d, 0, d);
+    check(pixel(0, 0)[3] === 0 && pixel(50, 50)[3] === 255, "楕円の外は透明になる");
+    check(pixel(20, 50)[0]! > pixel(80, 50)[0]!, "グラデーションが連続して変わる");
+    d.nodes = [...GraphicDocumentSchema.parse({ ...d, nodes: [{ id: "line", kind: "path", name: "光る線", path: "M40 80 H140", fill: "none", stroke: "#ffffff", strokeWidth: 6, glow: { color: "#ef8d32", blur: 12 } }] }).nodes];
+    ctx.clearRect(0, 0, 200, 200);
+    r.draw(ctx, d, 0, d);
+    check(pixel(80, 80)[3]! > 200 && pixel(80, 88)[3]! > 0, "線の縁取りと光彩が描かれる");
+    const src = "data:image/svg+xml;base64," + btoa('<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"><rect width="20" height="20" fill="#00ff00"/></svg>');
+    const imageDoc = GraphicDocumentSchema.parse({ ...d, nodes: [{ id: "image", name: "SVG", kind: "image", image: src, width: 100, height: 100 }] });
+    await r.prepare([imageDoc]);
+    ctx.clearRect(0, 0, 200, 200);
+    r.draw(ctx, imageDoc, 0, imageDoc);
+    check(pixel(20, 20)[1] === 255, "埋込みSVG画像を読み込める");
+    const one = r.rasterize("clip", imageDoc, 0, imageDoc), two = r.rasterize("clip", imageDoc, 40, imageDoc);
+    check(one === two, "静止パーツはフレームごとに再描画しない");
+    r.dispose();
+    return results;
+}
+void main().then(results => { document.getElementById("result")!.textContent = JSON.stringify({ passed: true, results }); }).catch(e => { document.getElementById("result")!.textContent = JSON.stringify({ passed: false, error: String(e) }); });
