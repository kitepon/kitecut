+import { afterEach, expect, test, vi } from 'vitest';
+import { EditorStore, TimelineSchema, type MediaManifestEntry } from '@frontstage/core';
+import { createVideoSearch, type SearchResult } from '../src/renderer/video-search.js';
+afterEach(() => vi.unstubAllGlobals());
+const result: SearchResult = { segments: [{ startSeconds: 2.2, endSeconds: 4.4, observation: 'カップに注ぐ', uncertainty: '開始時刻は概算' }], model: 'VideoChat3', revision: 'fixed', evidenceType: 'visual', rawAnswer: '', modelLoadSeconds: 1, inferenceSeconds: 2 };
+const entry = { id: 'source', type: 'video', name: '実演', duration: 10, width: 640, height: 360, hasAudio: true } as MediaManifestEntry;
+test('検索は非同期で共有され、素材秒を映像と音声のトリムへ変換し、一回で取り消して再配置できる', async () => {
+  const timeline = TimelineSchema.parse({ width: 640, height: 360, fps: 30, tracks: [] });
+  const store = new EditorStore(timeline), save = vi.fn();
+  const search = vi.fn(async () => result);
+  vi.stubGlobal('window', { desktopVideoSearch: { search } });
+  const facade = createVideoSearch(store, () => entry, () => 'original.mp4', save);
+  expect(facade.start({ mediaId: 'source', query: '注ぐ', startSeconds: 1, endSeconds: 8 }).status).toBe('running');
+  expect(store.getSnapshot().timeline).toEqual(timeline);
+  await vi.waitFor(() => expect(facade.state().status).toBe('completed'));
+  expect(search).toHaveBeenCalledWith({ path: 'original.mp4', query: '注ぐ', startSeconds: 1, endSeconds: 8 });
+  const placed = await facade.apply({ segmentIndex: 0, startFrame: 90, startSeconds: 2.5, endSeconds: 4 });
+  expect(placed).toMatchObject({ durationFrames: 45, trimStartFrame: 75 });
+  const after = store.getSnapshot().timeline;
+  const clips = after.tracks.flatMap(track => track.clips);
+  expect(clips).toHaveLength(2);
+  expect(clips.map(clip => clip.mediaType).sort()).toEqual(['audio', 'video']);
+  for (const clip of clips) expect(clip).toMatchObject({ startFrame: 90, durationFrames: 45, trimStartFrame: 75, trimEndFrame: 180 });
+  expect(clips[0]!.linkGroupId).toBe(clips[1]!.linkGroupId);
+  expect(save).toHaveBeenCalledOnce();
+  store.undo(); expect(store.getSnapshot().timeline).toEqual(timeline);
+  store.redo(); expect(store.getSnapshot().timeline).toEqual(after);
+});
