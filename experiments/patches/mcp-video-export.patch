+const response = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status });
+
+test('入力画像をComfyUIへ送り、動画生成と取得を接続する', async () => {
+  const fetcher = vi.fn().mockResolvedValueOnce(response({ name: 'source.png', subfolder: 'input' })).mockResolvedValueOnce(response({ prompt_id: 'video-job' }))
+    .mockResolvedValueOnce(response({ queue_running: [], queue_pending: [] })).mockResolvedValueOnce(response({ 'video-job': { status: { completed: true }, outputs: { '9': { images: [{ filename: 'video.mp4', subfolder: 'Frontstage', type: 'output' }] } } } }));
+  const gateway = createComfyGeneration(fetcher);
+  await expect(gateway.submit('http://localhost:8188', { kind: 'video', startImage: Buffer.from('image').toString('base64'), prompt: '回転', width: 768, height: 768, frames: 121, fps: 24, seed: 42, steps: 20 })).resolves.toEqual({ jobId: 'video-job' });
+  const uploaded = fetcher.mock.calls[0]![1].body.get('image');
+  expect(await uploaded.text()).toBe('image');
+  const graph = JSON.parse(fetcher.mock.calls[1]![1].body).prompt;
+  expect(graph['6'].inputs.image).toBe('input/source.png');
+  expect(graph['7'].inputs.length).toBe(121);
+  expect(graph['12'].inputs.fps).toBe(24);
+  const result = await gateway.status('http://localhost:8188', 'video-job');
+  expect(new URL(result.resultUrls[0]).searchParams.get('filename')).toBe('video.mp4');
+});
+
+test('生成を送信し、保存画像を既存の素材取込みへ返す', async () => {
+  const fetcher = vi.fn().mockResolvedValueOnce(response({ prompt_id: 'job' })).mockResolvedValueOnce(response({ queue_running: [], queue_pending: [] })).mockResolvedValueOnce(response({ job: { status: { completed: true }, outputs: { '9': { images: [{ filename: '背景 1.png', subfolder: 'Frontstage', type: 'output' }] } } } }));
+  const gateway = createComfyGeneration(fetcher);
+  await expect(gateway.submit('http://localhost:8188', { prompt: '背景', width: 1024, height: 1024, seed: 42, steps: 20, modelFile: 'model', textEncoderFile: 'encoder', vaeFile: 'vae' })).resolves.toEqual({ jobId: 'job' });
+  const graph = JSON.parse(fetcher.mock.calls[0][1].body).prompt;
+  expect(graph['4'].inputs.text).toBe('背景');
+  const result = await gateway.status('http://localhost:8188', 'job');
+  expect(result.status).toBe('succeeded');
+  expect(new URL(result.resultUrls[0]).searchParams.get('filename')).toBe('背景 1.png');
+});
+
+test('処理中とサーバーの生成失敗を区別する', async () => {
+  const fetcher = vi.fn().mockResolvedValueOnce(response({ queue_running: [[0, 'job']], queue_pending: [] })).mockResolvedValueOnce(response({ queue_running: [], queue_pending: [] })).mockResolvedValueOnce(response({ job: { status: { status_str: 'error', messages: [['execution_error', { exception_message: 'モデルの読込失敗' }]] } } }));
+  const gateway = createComfyGeneration(fetcher);
+  await expect(gateway.status('http://localhost:8188', 'job')).resolves.toEqual({ status: 'running' });
+  await expect(gateway.status('http://localhost:8188', 'job')).resolves.toEqual({ status: 'failed', errorMessage: 'モデルの読込失敗' });
+});
