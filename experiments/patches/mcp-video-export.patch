+"use strict";
+const { spawn } = require("node:child_process");
+const path = require("node:path");
+
+function trackMotion(input, python = process.env.FRONTSTAGE_TRACKING_PYTHON) {
+  if (!python) throw Error("追跡用のPython環境が設定されていません。");
+  return new Promise((resolve, reject) => {
+    const child = spawn(python, [path.join(__dirname, "motion-tracking.py")], {
+      windowsHide: true, stdio: ["pipe", "pipe", "pipe"], env: { ...process.env, PYTHONUTF8: "1" },
+    });
+    const output = [], errors = [];
+    child.stdout.on("data", chunk => output.push(chunk));
+    child.stderr.on("data", chunk => errors.push(chunk));
+    child.on("error", reject);
+    child.stdin.on("error", reject);
+    child.on("close", code => {
+      if (code !== 0) return reject(Error(`追跡に失敗しました (${code}): ${Buffer.concat(errors).toString("utf8")}`));
+      try { resolve(JSON.parse(Buffer.concat(output).toString("utf8"))); }
+      catch (error) { reject(error); }
+    });
+    child.stdin.end(JSON.stringify(input));
+  });
+}
+module.exports = { trackMotion };
diff --git a/apps/desktop/src/main/motion-tracking.py b/apps/desktop/src/main/motion-tracking.py
new file mode 100644
index 0000000..25bcf3f
--- /dev/null
+++ b/apps/desktop/src/main/motion-tracking.py
@@ -0,0 +1,69 @@
+"""指定動画の領域を特徴点で追跡し、素材時刻と正規化座標を返す。"""
+import json
+import sys
+import cv2
+import numpy as np
+
+
+def track(input):
+    capture = cv2.VideoCapture(input['path'])
+    if not capture.isOpened():
+        raise ValueError('動画を開けませんでした。')
+    try:
+        start, duration = float(input['startSeconds']), float(input['durationSeconds'])
+        roi = input['region']
+        if start < 0 or duration <= 0 or roi['width'] <= 0 or roi['height'] <= 0:
+            raise ValueError('開始時刻・長さ・追跡領域を確認してください。')
+        if min(roi['x'], roi['y']) < 0 or roi['x'] + roi['width'] > 1 or roi['y'] + roi['height'] > 1:
+            raise ValueError('追跡領域は素材の画面内に指定してください。')
+        capture.set(cv2.CAP_PROP_POS_MSEC, start * 1000)
+        ok, first = capture.read()
+        if not ok:
+            raise ValueError('開始位置の映像を読み取れませんでした。')
+        height, width = first.shape[:2]
+        previous = cv2.cvtColor(first, cv2.COLOR_BGR2GRAY)
+        mask = np.zeros_like(previous)
+        x, y = round(roi['x'] * width), round(roi['y'] * height)
+        right, bottom = round((roi['x'] + roi['width']) * width), round((roi['y'] + roi['height']) * height)
+        mask[y:bottom, x:right] = 255
+        points = cv2.goodFeaturesToTrack(previous, 50, .01, 3, mask=mask)
+        if points is None or len(points) < 3:
+            raise ValueError('領域内の特徴点が不足しています。輪郭や模様のある領域を指定してください。')
+        center = np.array([(x + right) / 2, (y + bottom) / 2], dtype=np.float64)
+        samples = [{'seconds': capture.get(cv2.CAP_PROP_POS_MSEC) / 1000, 'x': center[0] / width, 'y': center[1] / height}]
+        reason, stopped_at = 'range_end', None
+        while True:
+            ok, image = capture.read()
+            if not ok:
+                reason = 'media_end'
+                break
+            seconds = capture.get(cv2.CAP_PROP_POS_MSEC) / 1000
+            if seconds >= start + duration:
+                break
+            current = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
+            moved, status, error = cv2.calcOpticalFlowPyrLK(previous, current, points, None)
+            backward, backward_status, _ = cv2.calcOpticalFlowPyrLK(current, previous, moved, None)
+            distance = np.max(np.abs(points - backward), axis=(1, 2))
+            valid = (status.ravel() == 1) & (backward_status.ravel() == 1) & (error.ravel() < 20) & (distance < 1)
+            old, new = points[valid], moved[valid]
+            if len(new) < 3:
+                reason, stopped_at = 'lost', seconds
+                break
+            center += np.median((new - old).reshape(-1, 2), axis=0)
+            if not (0 <= center[0] < width and 0 <= center[1] < height):
+                reason, stopped_at = 'outside', seconds
+                break
+            samples.append({'seconds': seconds, 'x': center[0] / width, 'y': center[1] / height})
+            previous, points = current, new
+        return {'samples': samples, 'reason': reason, 'stoppedAtSeconds': stopped_at, 'sourceWidth': width, 'sourceHeight': height}
+    finally:
+        capture.release()
+
+
+if __name__ == '__main__':
+    cv2.setNumThreads(2)
+    try:
+        print(json.dumps(track(json.load(sys.stdin)), ensure_ascii=False))
+    except Exception as error:
+        print(str(error), file=sys.stderr)
+        sys.exit(1)
