+++ b/packages/ai/src/tools/beat-timing-tools.ts
@@ -0,0 +1,55 @@
+import { z } from "zod";
+import { findClip, editTimingMarkersCommand, type TimingMarker, type Timeline } from "@frontstage/core";
+import type { ToolContext, ToolSpec } from "./types.js";
+import { ok, errorResult } from "./executor.js";
+
+function source(timeline: Timeline, id: string) {
+  const loc = findClip(timeline, id);
+  if (!loc) throw Error("解析するクリップがありません");
+  const c = timeline.tracks[loc.trackIndex]!.clips[loc.clipIndex]!;
+  return { id, mediaRef: c.mediaRef, mediaType: c.mediaType, startFrame: c.startFrame, durationFrames: c.durationFrames, trimStartFrame: c.trimStartFrame, speed: c.speed, fps: timeline.fps };
+}
+interface Job {
+  status: "running" | "completed" | "failed";
+  source: ReturnType<typeof source>;
+  markers?: TimingMarker[];
+  estimates?: { seconds: number; bpm: number; confidence: number }[];
+  applied: boolean;
+  error?: string;
+}
+
+export function beatTimingTools(): ToolSpec[] {
+  const byStore = new WeakMap<ToolContext["store"], Map<string, Job>>();
+  function jobs(ctx: ToolContext) {
+    let current = byStore.get(ctx.store);
+    if (!current) { current = new Map(); byStore.set(ctx.store, current); }
+    return current;
+  }
+  return [
+    { name: "analyze_beat_timing", description: "音声または音声付き動画をローカルで解析し、拍の候補を返す。jobIdで同じ解析を確認する。解析だけでは目印を追加しない。冒頭の抜けや裏拍の誤検出があるため候補を確認し、apply_beat_timingで適用する。", inputSchema: z.object({ clipId: z.string().optional(), jobId: z.string().optional() }), run(args, ctx) {
+      const a = args as { clipId?: string; jobId?: string };
+      if (a.jobId) { const job = jobs(ctx).get(a.jobId); return job ? ok(JSON.stringify({ jobId: a.jobId, ...job })) : errorResult("拍の解析ジョブがありません"); }
+      if (!a.clipId || !ctx.analyzeBeats) return errorResult("解析するclipIdと音声解析の接続が必要です");
+      const s = source(ctx.store.getSnapshot().timeline, a.clipId);
+      const entry = ctx.getManifest().entries.find(e => e.id === s.mediaRef);
+      if (!entry || !["audio", "video"].includes(s.mediaType) || entry.hasAudio === false) return errorResult("音声を持つ素材を選んでください");
+      const id = ctx.newId(), job: Job = { source: s, status: "running", applied: false };
+      jobs(ctx).set(id, job);
+      void ctx.analyzeBeats(s.mediaRef).then(beats => {
+        const start = s.trimStartFrame / s.fps, end = start + s.durationFrames * s.speed / s.fps;
+        job.estimates = beats.filter(b => b.seconds >= start && b.seconds < end);
+        job.markers = job.estimates.map((b, index): TimingMarker => ({ id: ctx.newId(), kind: "beat", frame: s.startFrame + Math.round((b.seconds - start) * s.fps / s.speed), label: `拍 ${index + 1} / 約${Math.round(b.bpm * s.speed)} BPM` })).filter(m => m.frame < s.startFrame + s.durationFrames);
+        job.status = "completed";
+      }).catch(error => { job.status = "failed"; job.error = String(error); });
+      return ok(JSON.stringify({ jobId: id, status: job.status }));
+    } },
+    { name: "apply_beat_timing", description: "確認した拍の候補を一回のUndoで目印へ追加する。解析後に素材・位置・トリム・速度が変わった場合は再解析が必要。同じジョブの重複追加はしない。", inputSchema: z.object({ jobId: z.string() }), run(args, ctx) {
+      const job = jobs(ctx).get((args as { jobId: string }).jobId);
+      if (!job || job.status !== "completed" || !job.markers) return errorResult("拍の解析が完了していません");
+      if (job.applied) return ok(JSON.stringify({ applied: true, markers: job.markers }));
+      if (JSON.stringify(source(ctx.store.getSnapshot().timeline, job.source.id)) !== JSON.stringify(job.source)) return errorResult("解析後に対象クリップが変わりました。再解析してください");
+      ctx.store.dispatch(editTimingMarkersCommand(job.markers)); job.applied = true;
+      return ok(JSON.stringify({ markers: job.markers }));
+    } },
+  ];
+}
