index 0000000..2645626
--- /dev/null
+++ b/apps/desktop/src/main/local-speech-nemo.cjs
@@ -0,0 +1,63 @@
+"use strict";
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+let processHandle, starting;
+
+async function request(url, options) {
+  const response = await fetch(url, options);
+  if (!response.ok) throw Error(`Nemoの音声生成に失敗しました (${response.status}): ${await response.text()}`);
+  return response;
+}
+
+async function ensureStarted(config) {
+  const ready = async () => {
+    const manifest = await (await request(config.endpoint + '/engine_manifest', { signal: AbortSignal.timeout(3000) })).json();
+    if (manifest.uuid !== '208cf94d-43d2-4cf5-abc0-9783cac36d29') throw Error('指定先はVOICEVOX Nemoではありません。');
+  };
+  try { await ready(); return; }
+  catch (error) { if (error.cause?.code !== 'ECONNREFUSED') throw error; }
+  if (!starting) starting = (async () => {
+    const endpoint = new URL(config.endpoint);
+    let failure, errors = '';
+    const child = processHandle = spawn(config.engineExecutable, ['--host', endpoint.hostname, '--port', endpoint.port, '--cpu_num_threads', '8'], {
+      windowsHide: true, cwd: path.dirname(config.engineExecutable), stdio: ['ignore', 'ignore', 'pipe'],
+    });
+    processHandle.stderr.on('data', chunk => { errors = (errors + chunk.toString('utf8')).slice(-16000); });
+    processHandle.on('error', error => { failure = error; });
+    processHandle.on('exit', code => { failure = Error(`Nemoが終了しました (${code}): ${errors}`); if (processHandle === child) processHandle = undefined; });
+    const deadline = Date.now() + 30000;
+    // 自分で起動した外部エンジンの準備完了だけを待つ。
+    try { while (Date.now() < deadline) {
+      if (failure) throw failure;
+      try { await ready(); return; }
+      catch (error) { if (error.cause?.code !== 'ECONNREFUSED') throw error; }
+      await new Promise(resolve => setTimeout(resolve, 200));
+    }
+    throw Error(`Nemoの起動を確認できませんでした: ${errors}`);
+    } catch (error) { child.kill(); throw error; }
+  })().finally(() => { starting = undefined; });
+  await starting;
+}
+
+function waveInfo(bytes) {
+  let sampleRate, byteRate;
+  for (let offset = 12; offset + 8 <= bytes.length;) {
+    const tag = bytes.toString('ascii', offset, offset + 4), size = bytes.readUInt32LE(offset + 4);
+    if (tag === 'fmt ') { sampleRate = bytes.readUInt32LE(offset + 12); byteRate = bytes.readUInt32LE(offset + 16); }
+    if (tag === 'data' && byteRate) return { sampleRate, duration: size / byteRate };
+    offset += 8 + size + (size % 2);
+  }
+  throw Error('生成音声のWAV情報を読み取れません。');
+}
+
+async function generate(input, config) {
+  const begun = Date.now();
+  await ensureStarted(config);
+  const version = await (await request(config.endpoint + '/version')).json();
+  const query = await (await request(config.endpoint + '/audio_query?' + new URLSearchParams({ text: input.text, speaker: '10006' }), { method: 'POST' })).json();
+  query.speedScale = input.speed;
+  const response = await request(config.endpoint + '/synthesis?speaker=10006', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(query) });
+  const bytes = Buffer.from(await response.arrayBuffer());
+  return { base64: bytes.toString('base64'), ...waveInfo(bytes), elapsedSeconds: (Date.now() - begun) / 1000, voice: 'calm', provenance: { ...config.provenance, version, speedMethod: 'engine-speedScale' } };
+}
+module.exports = { generate, dispose() { processHandle?.kill(); } };
