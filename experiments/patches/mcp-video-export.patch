+import { useEffect, useRef, useState, useSyncExternalStore } from 'react';
+import { GRAPHIC_FONTS, storyboardRows, type EditorStore, type StoryPlanDraft } from '@frontstage/core';
+import type { StoryPlanInput, StoryPlanRecord, StoryPlansFacade, StoryPlanSummary } from '@frontstage/ai';
+import { StoryPlanInputSchema } from '@frontstage/ai';
+import './story-plans.css';
+
+type Props = { plans: StoryPlansFacade; store: EditorStore; execute: (name: string, args: object) => Promise<any> };
+export function StoryPlansPanel({ plans, store, execute }: Props) {
+  const [open,setOpen]=useState(false),[value,setValue]=useState<StoryPlanInput|null>(null),[record,setRecord]=useState<StoryPlanRecord|null>(null);
+  const [history,setHistory]=useState<StoryPlanSummary[]>([]),[error,setError]=useState(''),[notice,setNotice]=useState(''),[json,setJson]=useState('');
+  const [mapping,setMapping]=useState<Record<string,string>>({}),[segment,setSegment]=useState(0);
+  const dirty=useRef(false);
+  const [incoming,setIncoming]=useState<StoryPlanRecord|null>(null);
+  const timeline=useSyncExternalStore(cb=>store.subscribe(cb),()=>store.getSnapshot()).timeline;
+  const rows=storyboardRows(timeline),videos=timeline.tracks.flatMap(t=>t.clips).filter(c=>c.mediaType==='video');
+  const refresh=()=>plans.history().then(setHistory);
+  function show(r:StoryPlanRecord) {
+    dirty.current=false;setIncoming(null);
+    setRecord(r);setValue(r.draft ? {context:r.context,draft:r.draft,fps:r.fps??0,sources:r.sources,graphics:r.graphics,facts:r.facts,direction:r.direction,evidenceNotes:r.evidenceNotes} : null);
+    setMapping(Object.fromEntries((r.draft?.scenes??[]).filter(s=>storyboardRows(store.getSnapshot().timeline).some(row=>row.id===s.id)).map(s=>[s.id,s.id])));
+    setOpen(true);setNotice('');setError('');
+  }
+  useEffect(()=>{void refresh().catch(e=>setError(String(e)));void plans.state().then(r=>{if(r)show(r);}).catch(e=>setError(String(e)));return plans.subscribe(r=>{if(dirty.current)setIncoming(r);else show(r);void refresh().catch(e=>setError(String(e)));});},[plans]);
