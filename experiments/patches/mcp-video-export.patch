diff --git a/apps/desktop/src/main/capture.cjs b/apps/desktop/src/main/capture.cjs
new file mode 100644
index 0000000..fb40de8
--- /dev/null
+++ b/apps/desktop/src/main/capture.cjs
@@ -0,0 +1,58 @@
+"use strict";
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { randomUUID } = require('node:crypto');
+const { spawn } = require('node:child_process');
+
+function installCapture({ app, desktopCapturer, ipcMain, session, ffmpeg }) {
+  let selection;
+  let recording;
+  const sources = () => desktopCapturer.getSources({ types: ['window', 'screen'], thumbnailSize: { width: 0, height: 0 } });
+  ipcMain.handle('capture:sources', async () => (await sources()).map(({ id, name }) => ({ id, name })));
+  ipcMain.handle('capture:select', async (event, input) => {
+    const source = (await sources()).find(source => source.id === input.sourceId);
+    if (!source) throw Error('収録する画面が見つかりません。対象一覧を更新してください。');
+    selection = { source, audio: input.audio };
+    await event.sender.executeJavaScript('window.frontstageAcquireDisplay()', true);
+  });
+  session.defaultSession.setDisplayMediaRequestHandler((request, callback) => {
+    const selected = selection;
+    selection = undefined;
+    if (!selected) { callback({}); return; }
+    callback({ video: selected.source,
+      ...(selected.audio === 'system' ? { audio: 'loopback' } : selected.audio === 'application' ? { audio: request.frame, enableLocalEcho: true } : {}) });
+  });
+  ipcMain.handle('capture:begin', async () => {
+    if (recording) throw Error('すでに録画ファイルを保存しています。');
+    const directory = path.join(app.getPath('videos'), 'Frontstage Recordings');
+    await fs.mkdir(directory, { recursive: true });
+    const output = path.join(directory, `収録-${new Date().toISOString().replace(/[:.]/g, '-')}-${randomUUID().slice(0, 8)}.mp4`);
+    const temporary = output + '.partial';
+    recording = { output, temporary, handle: await fs.open(temporary, 'wx') };
+  });
+  ipcMain.handle('capture:append', async (_event, bytes) => {
+    if (!recording) throw Error('録画ファイルが開かれていません。');
+    await recording.handle.writeFile(Buffer.from(bytes));
+  });
+  ipcMain.handle('capture:abort', async () => {
+    const current = recording;
+    recording = undefined;
+    if (current) await current.handle.close();
+  });
+  ipcMain.handle('capture:finish', async () => {
+    if (!recording) throw Error('録画ファイルが開かれていません。');
+    const current = recording;
+    await current.handle.close();
+    recording = undefined;
+    await new Promise((resolve, reject) => {
+      const child = spawn(ffmpeg, ['-v', 'error', '-i', current.temporary, '-c', 'copy', '-movflags', '+faststart', current.output], { windowsHide: true });
+      let error = '';
+      child.stderr.on('data', chunk => { error += chunk; });
+      child.on('error', reject);
+      child.on('close', code => code === 0 ? resolve() : reject(Error(`録画の保存に失敗しました: ${error}`)));
+    });
+    await fs.unlink(current.temporary);
+    return { path: current.output, bytes: (await fs.stat(current.output)).size };
+  });
+}
+module.exports = { installCapture };
diff --git a/apps/desktop/src/main/comfy-generation.cjs b/apps/desktop/src/main/comfy-generation.cjs
new file mode 100644
index 0000000..7ee0fa9
--- /dev/null
+++ b/apps/desktop/src/main/comfy-generation.cjs
@@ -0,0 +1,81 @@
+"use strict";
+
+// 生成ジョブの保存と進捗は ComfyUI、素材の保存は既存の GenerationService が所有する。
+function buildImageWorkflow({ prompt, width, height, seed, steps, modelFile, textEncoderFile, vaeFile }) {
+  return {
+    "1": { class_type: "UNETLoader", inputs: { unet_name: modelFile, weight_dtype: "default" } },
+    "2": { class_type: "CLIPLoader", inputs: { clip_name: textEncoderFile, type: "mage", device: "default" } },
+    "3": { class_type: "VAELoader", inputs: { vae_name: vaeFile } },
+    "4": { class_type: "CLIPTextEncode", inputs: { clip: ["2", 0], text: prompt } },
+    "5": { class_type: "CLIPTextEncode", inputs: { clip: ["2", 0], text: "" } },
+    "6": { class_type: "EmptyFlux2LatentImage", inputs: { width, height, batch_size: 1 } },
+    "7": { class_type: "KSampler", inputs: { model: ["1", 0], positive: ["4", 0], negative: ["5", 0], latent_image: ["6", 0], seed, steps, cfg: 4, sampler_name: "euler", scheduler: "simple", denoise: 1 } },
+    "8": { class_type: "VAEDecode", inputs: { samples: ["7", 0], vae: ["3", 0] } },
+    "9": { class_type: "SaveImage", inputs: { images: ["8", 0], filename_prefix: "Frontstage/background" } },
+  };
+}
+
+function createComfyGeneration(fetcher = fetch) {
+  async function request(base, route, body) {
+    const response = await fetcher(`${base.replace(/\/$/, "")}${route}`, body === undefined ? undefined : {
+      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
+    });
+    if (!response.ok) throw Error(`ComfyUI ${response.status}: ${await response.text()}`);
+    return response.json();
+  }
+  return {
+    async submit(base, input) {
+      let graph;
+      if (input.kind === 'video') {
+        const form = new FormData();
+        form.append('image', new Blob([Buffer.from(input.startImage, 'base64')]), 'frontstage-source.png');
+        const uploaded = await fetcher(`${base.replace(/\/$/, '')}/upload/image`, { method: 'POST', body: form });
+        if (!uploaded.ok) throw Error(`ComfyUI ${uploaded.status}: ${await uploaded.text()}`);
+        const file = await uploaded.json();
+        if (!file.name) throw Error('ComfyUIが入力画像の保存先を返しませんでした。');
+        graph = buildVideoWorkflow(input, file.subfolder ? `${file.subfolder}/${file.name}` : file.name);
+      } else graph = buildImageWorkflow(input);
+      const result = await request(base, "/prompt", { prompt: graph });
+      if (!result.prompt_id) throw Error(`ComfyUI が生成を受け付けませんでした: ${JSON.stringify(result)}`);
+      return { jobId: result.prompt_id };
+    },
+    async status(base, jobId) {
+      const queue = await request(base, "/queue");
+      if (queue.queue_running.some(row => row[1] === jobId)) return { status: "running" };
+      if (queue.queue_pending.some(row => row[1] === jobId)) return { status: "queued" };
+      const history = await request(base, `/history/${encodeURIComponent(jobId)}`);
+      const item = history[jobId];
+      if (item) {
+        if (item.status?.status_str === "error") {
+          const failure = item.status.messages?.find(([kind]) => kind === "execution_error")?.[1];
+          return { status: "failed", errorMessage: failure?.exception_message ?? JSON.stringify(item.status) };
+        }
+        if (item.status?.completed) {
+          const images = item.outputs?.["9"]?.images ?? [];
+          if (!images.length) return { status: "failed", errorMessage: "ComfyUI の処理は終了しましたが、生成素材がありません。" };
+          return { status: "succeeded", resultUrls: images.map(image => `${base.replace(/\/$/, "")}/view?${new URLSearchParams({ filename: image.filename, subfolder: image.subfolder, type: image.type })}`) };
+        }
+      }
+      return { status: "failed", errorMessage: "ComfyUI に生成ジョブがありません。履歴の削除やサーバーの再起動を確認してください。" };
+    },
+  };
+}
+
+function buildVideoWorkflow(input, image) {
+  return {
+    '1': { class_type: 'UNETLoader', inputs: { unet_name: 'wan2.2_ti2v_5B_fp16.safetensors', weight_dtype: 'default' } },
+    '2': { class_type: 'CLIPLoader', inputs: { clip_name: 'umt5_xxl_fp8_e4m3fn_scaled.safetensors', type: 'wan', device: 'default' } },
+    '3': { class_type: 'VAELoader', inputs: { vae_name: 'wan2.2_vae.safetensors' } },
+    '4': { class_type: 'CLIPTextEncode', inputs: { clip: ['2', 0], text: input.prompt } },
+    '5': { class_type: 'CLIPTextEncode', inputs: { clip: ['2', 0], text: 'text, captions, watermark, camera shake, flicker, low quality' } },
+    '6': { class_type: 'LoadImage', inputs: { image } },
+    '7': { class_type: 'Wan22ImageToVideoLatent', inputs: { vae: ['3', 0], width: input.width, height: input.height, length: input.frames, batch_size: 1, start_image: ['6', 0] } },
+    '8': { class_type: 'ModelSamplingSD3', inputs: { model: ['1', 0], shift: 8 } },
+    '9': { class_type: 'SaveVideo', inputs: { video: ['12', 0], filename_prefix: 'Frontstage/background-video', format: 'mp4', codec: 'h264' } },
+    '10': { class_type: 'KSampler', inputs: { model: ['8', 0], positive: ['4', 0], negative: ['5', 0], latent_image: ['7', 0], seed: input.seed, steps: input.steps, cfg: 5, sampler_name: 'uni_pc', scheduler: 'simple', denoise: 1 } },
+    '11': { class_type: 'VAEDecode', inputs: { samples: ['10', 0], vae: ['3', 0] } },
+    '12': { class_type: 'CreateVideo', inputs: { images: ['11', 0], fps: input.fps } },
+  };
+}
+
+module.exports = { buildImageWorkflow, buildVideoWorkflow, createComfyGeneration };
diff --git a/apps/desktop/src/main/export-color.cjs b/apps/desktop/src/main/export-color.cjs
new file mode 100644
index 0000000..d67e308
--- /dev/null
+++ b/apps/desktop/src/main/export-color.cjs
@@ -0,0 +1,9 @@
+// 現在のCanvas書出しで圧縮器が通知するBT.709を、H.264とMP4の両方へ記録する。
+function exportColorArgs(color) {
+  if (!color || color.primaries !== 'bt709' || color.transfer !== 'bt709' || color.matrix !== 'bt709' || typeof color.fullRange !== 'boolean') {
+    throw new Error('GPU書出しの色情報が未対応または欠けています');
+  }
+  return ['-bsf:v', `h264_metadata=colour_primaries=1:transfer_characteristics=1:matrix_coefficients=1:video_full_range_flag=${color.fullRange ? 1 : 0}`,
+    '-color_primaries', 'bt709', '-color_trc', 'bt709', '-colorspace', 'bt709', '-color_range', color.fullRange ? 'pc' : 'tv'];
+}
+module.exports = { exportColorArgs };
