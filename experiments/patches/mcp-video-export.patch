+import { z } from "zod";
+import { TimingMarkersSchema, editTimingMarkersCommand, splitAtMarkerCommand, keyframeAtMarkerCommand, DuckingInputSchema, duckingCommand, type DuckingInput, type TimingMarker } from "@frontstage/core";
+import { ok } from "./executor.js";
+import type { ToolSpec } from "./types.js";
+
+const keyframeInput = z.discriminatedUnion("track", [
+  z.object({ track: z.literal("opacityTrack"), value: z.number().min(0).max(1) }),
+  z.object({ track: z.literal("volumeTrack"), value: z.number().finite() }),
+  z.object({ track: z.literal("rotationTrack"), value: z.number().finite() }),
+  z.object({ track: z.literal("positionTrack"), value: z.object({ a: z.number().finite(), b: z.number().finite() }) }),
+  z.object({ track: z.literal("scaleTrack"), value: z.object({ a: z.number().positive(), b: z.number().positive() }) }),
+  z.object({ track: z.literal("cropTrack"), value: z.object({ left: z.number().min(0).max(1), top: z.number().min(0).max(1), right: z.number().min(0).max(1), bottom: z.number().min(0).max(1) }) }),
+]);
+
+export function timingTools(): ToolSpec[] {
+  return [
+    { name: "duck_music_at_speech", description: "発話の目印の区間で、指定BGMの現在の音量カーブにreductionDb（負のdB）を加える。音量・フェードは保持。attackFramesは発話前の減衰時間、releaseFramesは発話後の復帰時間。重複発話は一重。再実行は追加減衰となるため調整し直す前にUndoする。", inputSchema: DuckingInputSchema, run(args, ctx) { ctx.store.dispatch(duckingCommand(args as DuckingInput)); return ok("発話中のBGMを下げました。一回の取り消しで元の音量編集へ戻せます"); } },
+    { name: "get_timing_markers", description: "タイムライン上の音の目印を返す。frame/endFrameは作品の絶対フレーム。endFrameは発話などの区間終端で、そのフレームを含まない。", inputSchema: z.object({}), run(_, ctx) { return ok(JSON.stringify({ fps: ctx.store.getSnapshot().timeline.fps, markers: ctx.store.getSnapshot().timeline.markers ?? [] })); } },
+    { name: "edit_timing_markers", description: "目印を追加・更新・削除する。同じIDは置換。全変更は一回のUndoにまとまり、GUIと保存作品にも反映する。作品時刻に固定した目印であり、クリップ移動には追従しない。", inputSchema: z.object({ upserts: TimingMarkersSchema.default([]), removeIds: z.array(z.string()).default([]) }), run(args, ctx) {
+      const a = args as { upserts: TimingMarker[]; removeIds: string[] };
+      ctx.store.dispatch(editTimingMarkersCommand(a.upserts, a.removeIds));
+      return ok(JSON.stringify({ markers: ctx.store.getSnapshot().timeline.markers ?? [] }));
+    } },
+    { name: "split_at_timing_marker", description: "選んだクリップとリンク音声を目印で分割。目印は全対象クリップの内側に必要。一回のUndoで戻せる。", inputSchema: z.object({ clipIds: z.array(z.string()).min(1), markerId: z.string() }), run(args, ctx) {
+      const a = args as { clipIds: string[]; markerId: string };
+      ctx.store.dispatch(splitAtMarkerCommand(a.clipIds, a.markerId, ctx.newId));
+      return ok("目印でカットしました");
+    } },
+    { name: "keyframe_at_timing_marker", description: "目印の瞬間へ位置・拡縮・回転・透明度・音量・クロップのキーフレームを置く。volumeTrackのvalueはdB（0は変更なし、負で減衰）。作品時刻からクリップ相対時刻へ変換する。範囲外はエラー。", inputSchema: z.object({ clipId: z.string(), markerId: z.string(), keyframe: keyframeInput }), run(args, ctx) {
+      const a = args as { clipId: string; markerId: string; keyframe: z.infer<typeof keyframeInput> };
