--- /dev/null
+++ b/packages/ui/src/inspector/GlyphPositions.tsx
@@ -0,0 +1,19 @@
+import {useState} from 'react';
+import {textUnits,type GraphicNode} from '@frontstage/core';
+import {NumberField} from './fields.js';
+export function GlyphPositions({node,onChange}:{node:GraphicNode;onChange:(patch:Partial<GraphicNode>)=>void}){
+ const [index,setIndex]=useState(0);
+ const glyphs=(node.text??'').split(/\r?\n/).flatMap(line=>textUnits(line,'grapheme'));
+ const selected=Math.min(index,Math.max(0,glyphs.length-1));
+ const offset=node.glyphOffsets?.find(v=>v.index===selected)??{index:selected,x:0,y:0};
+ const change=(axis:'x'|'y',value:number)=>{
+   const next={...offset,[axis]:value};
+   const values=(node.glyphOffsets??[]).filter(v=>v.index!==selected);
+   if(next.x||next.y)values.push(next);
+   onChange({glyphOffsets:values.length?values.sort((a,b)=>a.index-b.index):undefined});
+ };
+ return <section><h3>一文字ずつの位置</h3><p>改行を除いた文字の順番に保存します。濁点や絵文字の組合せは一文字として動きます。</p>
+ <label>調整する文字<select disabled={!glyphs.length} value={selected} onChange={e=>setIndex(Number(e.target.value))}>{glyphs.map((g,i)=><option key={i} value={i}>{i+1}：{g.trim()?g:'空白'}</option>)}</select></label>
+ {!!glyphs.length&&<><NumberField label="文字の横調整" value={offset.x} onChange={v=>change('x',v)}/><NumberField label="文字の縦調整" value={offset.y} onChange={v=>change('y',v)}/></>}
+ </section>;
+}
