+import type { Timeline } from '../timeline.js';
+import type { Command } from './editor-store.js';
+import { sceneGroups } from './scene-commands.js';
+
+export function preserveSceneCommand(sceneId: string, preserve: boolean): Command {
+  return {label: preserve ? 'AI改稿で場面を残す' : '場面の保持を解除', apply(timeline) {
+    if (!sceneGroups(timeline).some(g => g.id === sceneId)) throw Error('場面がありません');
+    const ids = new Set(timeline.preservedSceneIds ?? []);
+    if (preserve) ids.add(sceneId); else ids.delete(sceneId);
+    return {...timeline, preservedSceneIds: [...ids]};
+  }};
+}
+
+// 保持区間で合成される映像・音声と、その場面の構成メモを比較する。
+function sceneContent(timeline: Timeline, id: string, start: number, end: number) {
+  return {
+    fps: timeline.fps, width: timeline.width, height: timeline.height,
+    group: sceneGroups(timeline).find(g => g.id === id),
+    brief: timeline.sceneBriefs?.find(b => b.sceneId === id),
+    tracks: timeline.tracks.map(track => ({
+      id: track.id, type: track.type, muted: track.muted, hidden: track.hidden,
+      clips: track.clips.filter(c => c.startFrame < end && c.startFrame + c.durationFrames > start),
+    })).filter(track => track.clips.length),
+  };
+}
+
+export function assertPreservedScenes(before: Timeline, after: Timeline): void {
+  const ids = before.preservedSceneIds ?? [];
+  if (JSON.stringify([...ids].sort()) !== JSON.stringify([...(after.preservedSceneIds ?? [])].sort()))
+    throw Error('保持指定は人が画面で変更してください。AIからは変更できません。');
+  if (!ids.length) return;
+  const groups = sceneGroups(before);
+  for (const id of ids) {
+    const group = groups.find(g => g.id === id);
+    if (!group) continue;
+    if (JSON.stringify(sceneContent(before,id,group.startFrame,group.endFrame)) !==
+        JSON.stringify(sceneContent(after,id,group.startFrame,group.endFrame)))
+      throw Error(`「${group.name}」は人が残すと指定しています。保持区間の映像・音声・構成を変更できません。`);
+  }
+}
