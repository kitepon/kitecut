+import { useState } from "react";
+import { createPortal } from "react-dom";
+import { duckingCommand, editTimingMarkersCommand, splitAtMarkerCommand, keyframeAtMarkerCommand, type EditorStore, type TimingMarker } from "@frontstage/core";
+import { useStore } from "../store/use-store.js";
+import "./timing-markers.css";
+import { SpeechTimingPanel } from "./SpeechTimingPanel.js";
+import type { CaptionsExecutor } from "../media/CaptionsTab.js";
+
+const kinds = { manual: "手動", beat: "拍", speech: "発話", effect: "効果音" } as const;
+
+export function TimingMarkersPanel({ store, executor }: { store: EditorStore; executor?: CaptionsExecutor }) {
+  const [open, setOpen] = useState(false);
+  const [reductionDb, setReductionDb] = useState(-12);
+  const [attackFrames, setAttackFrames] = useState(6);
+  const [releaseFrames, setReleaseFrames] = useState(12);
+  const [error, setError] = useState("");
+  const timeline = useStore(store, s => s.timeline);
+  const [selectedId, setSelectedId] = useState("");
+  const selected = timeline.markers?.find(m => m.id === selectedId);
+  function run(action: () => void) {
+    try { action(); setError(""); } catch (e) { setError(e instanceof Error ? e.message : String(e)); }
+  }
+  function update(marker: TimingMarker) { run(() => store.dispatch(editTimingMarkersCommand([marker]))); }
+  return <div className="timing-markers">
+    <button className="timing-trigger" aria-expanded={open} onClick={() => setOpen(!open)}>◆ 音の目印 <span>{timeline.markers?.length || ""}</span></button>
+    {open && createPortal(<div className="timing-markers timing-overlay"><section className="timing-popover" role="dialog" aria-label="音の目印">
+      <header><div><strong>音に合わせる</strong><p>拍、発話、効果音にカットと動きを。</p></div><button aria-label="目印パネルを閉じる" onClick={() => setOpen(false)}>×</button></header>
+      <button className="timing-add" onClick={() => run(() => {
+        const marker: TimingMarker = { id: crypto.randomUUID(), frame: Math.round(store.getSnapshot().playhead), kind: "manual", label: "目印" };
+        store.dispatch(editTimingMarkersCommand([marker])); setSelectedId(marker.id);
+      })}>＋ 再生位置に目印</button>
+      <div className="timing-list">
+        {executor && <SpeechTimingPanel store={store} executor={executor} />}
+        {executor && <SpeechTimingPanel store={store} executor={executor} kind="beat" />}
+        {!timeline.markers?.length && <p className="timing-empty">音を聞きながら、合わせたい瞬間に目印を置いてください。</p>}
+        {timeline.markers?.map(m => <button key={m.id} className={m.id === selectedId ? "is-selected" : ""} onClick={() => { setSelectedId(m.id); store.setPlayhead(m.frame); }}>
+          <span className={"timing-kind " + m.kind}>◆</span><span>{m.label || kinds[m.kind]}</span><time>{(m.frame / timeline.fps).toFixed(3)}s</time>
+        </button>)}
+      </div>
+      {selected && <div className="timing-fields">
+        <label>名前<input key={selected.id + selected.label} aria-label="目印の名前" defaultValue={selected.label} onBlur={e => { if (e.target.value !== selected.label) update({ ...selected, label: e.target.value }); }} /></label>
+        <div className="timing-pair"><label>開始フレーム<input key={selected.id + selected.frame} aria-label="目印の開始フレーム" type="number" min="0" step="1" defaultValue={selected.frame} onBlur={e => { if (Number(e.target.value) !== selected.frame) update({ ...selected, frame: Number(e.target.value) }); }} /></label>
+        <label>終了（区間の場合）<input key={selected.id + selected.endFrame} aria-label="目印の終了フレーム" type="number" min={selected.frame + 1} step="1" defaultValue={selected.endFrame ?? ""} onBlur={e => { const endFrame = e.target.value === "" ? undefined : Number(e.target.value); if (endFrame !== selected.endFrame) update({ ...selected, endFrame }); }} /></label></div>
+        <label>種類<select aria-label="目印の種類" value={selected.kind} onChange={e => update({ ...selected, kind: e.target.value as TimingMarker["kind"] })}>{Object.entries(kinds).map(([k, v]) => <option key={k} value={k}>{v}</option>)}</select></label>
+        <div className="timing-actions"><button onClick={() => run(() => {
+          const ids = [...store.getSnapshot().selection];
+          if (!ids.length) throw Error("カットするクリップを選択してください");
+          store.dispatch(splitAtMarkerCommand(ids, selected.id, () => crypto.randomUUID()));
+        })}>選択クリップをカット</button><button onClick={() => run(() => {
+          const ids = [...store.getSnapshot().selection];
+          if (ids.length !== 1) throw Error("動かすクリップを一つ選択してください");
+          store.dispatch(keyframeAtMarkerCommand(ids[0]!, selected.id, "opacityTrack", 1));
+        })}>ここで不透明にする</button></div>
+        <button className="timing-delete" onClick={() => run(() => { store.dispatch(editTimingMarkersCommand([], [selected.id])); setSelectedId(""); })}>目印を削除</button>
+      </div>}
+      <details className="timing-fields"><summary>発話中のBGMを下げる</summary>
+        <label>下げる量（dB）<input aria-label="BGMの減衰dB" type="number" max="0" value={reductionDb} onChange={e => setReductionDb(Number(e.target.value))} /></label>
+        <div className="timing-pair"><label>発話前（フレーム）<input type="number" min="0" value={attackFrames} onChange={e => setAttackFrames(Number(e.target.value))} /></label><label>発話後（フレーム）<input type="number" min="0" value={releaseFrames} onChange={e => setReleaseFrames(Number(e.target.value))} /></label></div>
+        <p>終了時刻がある全ての発話の目印を使います。タイムラインでBGMを選択してください。</p>
+        <button className="timing-add" onClick={() => run(() => {
+          const state = store.getSnapshot();
+          store.dispatch(duckingCommand({ clipIds: [...state.selection], markerIds: (state.timeline.markers ?? []).filter(m => m.kind === "speech" && m.endFrame !== undefined).map(m => m.id), reductionDb, attackFrames, releaseFrames }));
+        })}>選択したBGMへ適用</button>
+        <p>現在の音量に加えて下げます。調整し直す時は、一度取り消してから適用してください。</p>
+      </details>
+      {error && <p role="alert" className="timing-error">{error}</p>}
+      <footer>作品時刻に固定 · 操作は取り消し可能</footer>
+    </section></div>, document.body)}
+  </div>;
+}
