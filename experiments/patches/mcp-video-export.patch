+import { afterEach, expect, test, vi } from "vitest";
+import { VideoDecodeManager } from "../src/decode/video-decoder.js";
+import type { DemuxedTrack } from "../src/demux/mp4-demuxer.js";
+
+// 圧縮順0,3,1,2に対し、表示時刻1には3だけでなく1のchunkも必要。
+class Decoder {
+  static async isConfigSupported() { return { supported: true }; }
+  state = "configured";
+  decodeQueueSize = 0;
+  private queue: number[] = [];
+  constructor(private init: { output: (f: unknown) => void }) {}
+  configure() {}
+  decode(chunk: { timestamp: number }) { this.queue.push(chunk.timestamp); }
+  async flush() {
+    for (const timestamp of this.queue.sort((a, b) => a - b)) this.init.output({ timestamp, close() {} });
+    this.queue = [];
+  }
+  close() { this.state = "closed"; }
+}
+afterEach(() => vi.unstubAllGlobals());
+test("Bフレームを含む圧縮順でも指定した表示時刻まで読む", async () => {
+  vi.stubGlobal("VideoDecoder", Decoder);
+  const chunks = [0, 3, 1, 2].map((timestamp, i) => ({ timestamp, type: i ? "delta" : "key" })) as EncodedVideoChunk[];
+  const track = { codec: "avc1.64001f", codedWidth: 16, codedHeight: 16 } as DemuxedTrack;
+  const manager = await VideoDecodeManager.create(track, chunks);
+  for (const target of [0, 1, 2, 1.5, 3]) {
+    const frame = await manager.frameAtMicros(target);
+    expect(frame.timestamp).toBe(Math.floor(target));
+    manager.closeFrame(frame);
+  }
+  manager.dispose();
+  expect(manager.openFrameCount()).toBe(0);
+});
