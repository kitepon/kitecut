+// 各画素から輪郭までの距離を保存し、動きとぼかしはGPUで評価する。
+export function signedDistances(alpha: Uint8ClampedArray, width: number, height: number): Float32Array {
+  const inside = new Float64Array(width * height), outside = new Float64Array(width * height);
+  for (let i = 0; i < inside.length; i++) {
+    const a = alpha[i]! / 255;
+    inside[i] = a === 0 ? 1e20 : a === 1 ? 0 : Math.max(0, 0.5 - a) ** 2;
+    outside[i] = a === 1 ? 1e20 : a === 0 ? 0 : Math.max(0, a - 0.5) ** 2;
+  }
+  const length = Math.max(width, height), f = new Float64Array(length), d = new Float64Array(length);
+  const sites = new Int32Array(length), bounds = new Float64Array(length + 1);
+  function line(n: number) {
+    let k = 0; sites[0] = 0; bounds[0] = -Infinity; bounds[1] = Infinity;
+    for (let q = 1; q < n; q++) {
+      let s: number;
+      do {
+        const p = sites[k]!;
+        s = ((f[q]! + q * q) - (f[p]! + p * p)) / (2 * (q - p));
+        if (s <= bounds[k]!) k--; else break;
+      } while (k >= 0);
+      k++; sites[k] = q; bounds[k] = s!; bounds[k + 1] = Infinity;
+    }
+    k = 0;
+    for (let q = 0; q < n; q++) {
+      while (bounds[k + 1]! < q) k++;
+      d[q] = (q - sites[k]!) ** 2 + f[sites[k]!]!;
+    }
+  }
+  for (const grid of [inside, outside]) {
+    for (let x = 0; x < width; x++) {
+      for (let y = 0; y < height; y++) f[y] = grid[y * width + x]!;
+      line(height);
+      for (let y = 0; y < height; y++) grid[y * width + x] = d[y]!;
+    }
+    for (let y = 0; y < height; y++) {
+      for (let x = 0; x < width; x++) f[x] = grid[y * width + x]!;
+      line(width);
+      for (let x = 0; x < width; x++) grid[y * width + x] = d[x]!;
+    }
+  }
+  return Float32Array.from(inside, (value, i) => Math.sqrt(value) - Math.sqrt(outside[i]!));
+}
+
+export function pathDistancePixels(path: string, width: number, height: number, viewWidth: number, viewHeight: number): Uint8Array<ArrayBuffer> {
+  if (!path.trim()) throw new Error('切り抜くパスが空です。');
+  const canvas = new OffscreenCanvas(width, height), ctx = canvas.getContext('2d', {willReadFrequently:true});
+  if (!ctx) throw new Error('パスの描画に必要なCanvasを作成できません。');
+  ctx.scale(width / viewWidth, height / viewHeight);
+  ctx.fillStyle = 'white'; ctx.fill(new Path2D(path));
+  const rgba = ctx.getImageData(0, 0, width, height).data;
+  const alpha = new Uint8ClampedArray(width * height);
+  for (let i = 0; i < alpha.length; i++) alpha[i] = rgba[i * 4 + 3]!;
+  if (!alpha.some(a => a > 0)) throw new Error('指定したパスには枠内に塗りつぶせる領域がありません。パスと基準寸法を確認してください。');
+  const distances = signedDistances(alpha, width, height), range = Math.hypot(width, height);
+  const pixels = new Uint8Array(width * height * 4);
+  for (let i = 0; i < distances.length; i++) {
+    const value = Math.round(Math.max(0, Math.min(1, 0.5 + distances[i]! / (2 * range))) * 65535);
+    pixels[i * 4] = value >> 8; pixels[i * 4 + 1] = value & 255; pixels[i * 4 + 3] = 255;
+  }
+  return pixels;
+}
