diff --git a/apps/desktop/src/renderer/media-restoration.ts b/apps/desktop/src/renderer/media-restoration.ts
new file mode 100644
index 0000000..8ee2e78
--- /dev/null
+++ b/apps/desktop/src/renderer/media-restoration.ts
@@ -0,0 +1,41 @@
+import { createPlaceholderEntry } from '@frontstage/core';
+import { probeMediaBlob, type MediaLibrary } from '@frontstage/ui';
+export type RestorationInput = { mediaId: string; mode: 'stabilize' | 'video-denoise' | 'audio-denoise'; noiseFloor?: number };
+type State = { status: 'idle' | 'running' | 'completed' | 'failed'; input?: RestorationInput; assetId?: string; elapsedSeconds?: number; error?: string };
+declare global { interface Window { desktopRestoration: { process(input: { path: string; mode: RestorationInput['mode']; noiseFloor?: number }): Promise<{ bytes: Uint8Array; duration: number; elapsedSeconds: number }> } } }
+export function createMediaRestoration(library: MediaLibrary, resolvePath: (id: string) => string | null, project: () => object | null, save: () => Promise<boolean>) {
+  let state: State = { status: 'idle' };
+  const listeners = new Set<() => void>();
+  const update = (next: State) => { state = next; listeners.forEach(listener => listener()); };
+  return {
+    state: () => state,
+    subscribe: (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; },
+    start(input: RestorationInput) {
+      if (state.status === 'running') throw Error('補正が終わってから次の素材を選んでください。');
+      const origin = project();
+      if (!origin) throw Error('先にプロジェクトを保存してください。');
+      if (input.mode === 'audio-denoise') input = { ...input, noiseFloor: input.noiseFloor ?? -30 };
+      const source = library.entry(input.mediaId), file = resolvePath(input.mediaId);
+      if (!source || !file) throw Error('保存済みの元の素材を選んでください。');
+      if (input.mode === 'audio-denoise' ? source.type !== 'audio' && !source.hasAudio : source.type !== 'video') throw Error('選んだ補正に対応する映像または音声がありません。');
+      const audio = input.mode === 'audio-denoise';
+      const entry = createPlaceholderEntry({ id: crypto.randomUUID(), type: audio ? 'audio' : 'video', name: source.name + '・補正後', duration: source.duration, ext: audio ? 'wav' : 'mp4',
+        genInput: { prompt: '素材補正', model: 'FFmpeg', parameters: { ...input }, duration: source.duration, aspectRatio: '', numImages: 1, outputIndex: 0, createdAt: new Date().toISOString() } });
+      update({ status: 'running', input, assetId: entry.id });
+      void window.desktopRestoration.process({ path: file, mode: input.mode, noiseFloor: input.noiseFloor }).then(async result => {
+        const { thumb, ...metadata } = await probeMediaBlob(new Blob([result.bytes as BlobPart]), entry.type);
+        if (project() !== origin || library.entry(input.mediaId) !== source) throw Error('補正中に素材またはプロジェクトが変わったため、結果を適用できませんでした。');
+        library.addEntry({ ...entry, ...metadata, generationStatus: undefined }, result.bytes);
+        if (thumb) library.setThumbnail(entry.id, thumb);
+        if (!await save()) throw Error('補正結果を保存できませんでした。プロジェクトを保存してください。');
+        if (project() !== origin) throw Error('保存中にプロジェクトが変わりました。元のプロジェクトで補正結果を確認してください。');
+        update({ status: 'completed', input, assetId: entry.id, elapsedSeconds: result.elapsedSeconds });
+      }).catch(error => { update({ status: 'failed', input, assetId: entry.id, error: String(error) }); });
+      return state;
+    },
+    async preview(mediaId: string) {
+      const blob = await library.byteSource.open(mediaId);
+      return URL.createObjectURL(new Blob([await blob.arrayBuffer()], { type: library.entry(mediaId)?.type === 'audio' ? 'audio/wav' : 'video/mp4' }));
+    },
+  };
+}
