+  const clip = clipFromAsset({ id: "source", name: "タイトル", type: "text", source: { kind: "project", relativePath: "" }, duration: 2 }, 30, 15, () => "clip");
+  const store = new EditorStore({ ...defaultTimeline(), tracks: [{ id: "t", type: "text", muted: false, hidden: false, syncLocked: true, clips: [clip] }] });
+  const tools = new ToolExecutor(timingTools(), { store, newId: () => crypto.randomUUID(), getManifest: () => ({ version: 2, entries: [], folders: [] }) });
+  expect((await tools.execute("edit_timing_markers", { upserts: [{ id: "hit", frame: 30, label: "着地", kind: "effect" }] })).isError).toBe(false);
+  const prior = store.getSnapshot().timeline;
+  expect((await tools.execute("keyframe_at_timing_marker", { clipId: "clip", markerId: "hit", keyframe: { track: "positionTrack", value: { a: 0.2, b: 0.3 } } })).isError).toBe(false);
+  expect(store.getSnapshot().timeline.tracks[0]!.clips[0]!.positionTrack!.keyframes[0]).toMatchObject({ frame: 15, value: { a: 0.2, b: 0.3 } });
+  store.undo(); expect(store.getSnapshot().timeline).toBe(prior);
+  expect((await tools.execute("keyframe_at_timing_marker", { clipId: "clip", markerId: "hit", keyframe: { track: "volumeTrack", value: -12 } })).isError).toBe(false);
+  expect(store.getSnapshot().timeline.tracks[0]!.clips[0]!.volumeTrack!.keyframes[0]!.value).toBe(-12);
+  store.undo();
+  expect((await tools.execute("split_at_timing_marker", { clipIds: ["clip"], markerId: "unknown" })).isError).toBe(true);
+  expect(store.getSnapshot().timeline).toBe(prior);
+  expect((await tools.execute("get_timing_markers", {})).blocks[0]).toMatchObject({ kind: "text", text: JSON.stringify({ fps: 30, markers: prior.markers }) });
+});
