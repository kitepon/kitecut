diff --git a/packages/engine/src/audio/beat-detection.ts b/packages/engine/src/audio/beat-detection.ts
new file mode 100644
index 0000000..8212106
--- /dev/null
+++ b/packages/engine/src/audio/beat-detection.ts
@@ -0,0 +1,33 @@
+import createAubio from "aubiojs";
+
+export interface BeatCandidate {
+  seconds: number;
+  bpm: number;
+  confidence: number;
+}
+
+export const BEAT_SAMPLE_RATE = 44100;
+const WINDOW = 2048;
+const HOP = 128;
+
+/** 拍の候補を返す。短い冒頭や裏拍の曖昧さを残すため、推定BPMと信頼値も保持する。 */
+export async function detectBeatCandidates(pcm: Float32Array, sampleRate: number): Promise<BeatCandidate[]> {
+  if (sampleRate !== BEAT_SAMPLE_RATE) throw new Error("拍の解析には44100Hzのモノラル音声が必要です");
+  const aubio = await createAubio();
+  // embindの解放メソッドは実体に存在するが、aubiojsの型宣言には含まれていない。
+  const tempo = new aubio.Tempo(WINDOW, HOP, sampleRate) as InstanceType<typeof aubio.Tempo> & { delete(): void };
+  const block = new Float32Array(HOP);
+  const beats: BeatCandidate[] = [];
+  try {
+    for (let offset = 0; offset < pcm.length; offset += HOP) {
+      block.fill(0);
+      block.set(pcm.subarray(offset, offset + HOP));
+      const position = tempo.do(block);
+      if (position > 0) {
+        const sample = offset + Math.round(position * HOP);
+        if (sample < pcm.length) beats.push({ seconds: sample / sampleRate, bpm: tempo.getBpm(), confidence: tempo.getConfidence() });
+      }
+    }
+    return beats;
+  } finally { tempo.delete(); }
+}
