+test('人が構成を保存し、外部からの改稿と取り消しを同じ入力欄に反映する',()=>{
+  const clip=(id:string,startFrame:number)=>ClipSchema.parse({id,mediaRef:'m',mediaType:'video',sourceClipType:'video',startFrame,durationFrames:30});
+  const store=new EditorStore(createSceneCommand(['a','b'],'実演','scene').apply(TimelineSchema.parse({tracks:[{id:'v',type:'video',clips:[clip('a',0),clip('b',40)]}]})));
