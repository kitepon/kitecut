+}
diff --git a/packages/ui/src/timeline/SceneComparisonPanel.tsx b/packages/ui/src/timeline/SceneComparisonPanel.tsx
new file mode 100644
index 0000000..5c6f7ca
--- /dev/null
+++ b/packages/ui/src/timeline/SceneComparisonPanel.tsx
@@ -0,0 +1,55 @@
+import {useEffect,useRef,useState,useSyncExternalStore} from 'react';
+import {createPortal} from 'react-dom';
+import {sceneGroups,type EditorStore} from '@frontstage/core';
+import type {SceneComparisonFacade} from '@frontstage/ai';
+import {useStore} from '../store/use-store.js';
+
+export function SceneComparisonPanel({store,facade,request}:{store:EditorStore;facade:SceneComparisonFacade;request:number}){
+  const state=useSyncExternalStore(facade.subscribe,facade.state);
+  const timeline=useStore(store,s=>s.timeline),groups=sceneGroups(timeline);
+  const [open,setOpen]=useState(false),[refs,setRefs]=useState<{name:string;path:string}[]>([]);
+  const [path,setPath]=useState(''),[sceneId,setSceneId]=useState(''),[error,setError]=useState('');
+  const [urls,setUrls]=useState<{before:string;after:string}|null>(null);
+  const before=useRef<HTMLVideoElement>(null),after=useRef<HTMLVideoElement>(null);
+  useEffect(()=>{if(request)setOpen(true);},[request]);
+  useEffect(()=>{if(state?.id)setOpen(true);},[state?.id]);
+  useEffect(()=>{if(!open)return;let active=true;facade.references().then(r=>{if(active)setRefs(r);}).catch(e=>{if(active)setError(String(e));});return()=>{active=false;};},[facade,open]);
+  useEffect(()=>{
+    if(!open||state?.status!=='completed'){setUrls(null);return;}
+    let active=true,created:string[]=[];
+    Promise.all([facade.preview('before'),facade.preview('after')]).then(blobs=>{
+      if(!active)return;created=blobs.map(b=>URL.createObjectURL(b));setUrls({before:created[0]!,after:created[1]!});
+    }).catch(e=>{if(active)setError(String(e));});
+    return()=>{active=false;created.forEach(u=>URL.revokeObjectURL(u));};
+  },[facade,open,state?.id,state?.status]);
+  useEffect(()=>{
+    if(!urls||!open)return;
+    return facade.bindPlayback(async side=>{
+      const selected=side==='before'?before.current:after.current,other=side==='before'?after.current:before.current;
+      if(!selected)throw Error('比較動画の準備ができていません');
+      other?.pause();selected.currentTime=0;await selected.play();
+    });
+  },[facade,urls,open]);
+  if(!open)return null;
+  return createPortal(<div className="timing-markers timing-overlay" style={{zIndex:1250,justifyContent:'center'}}>
+    <section className="timing-popover" role="dialog" aria-label="改稿の比較" style={{width:'min(1100px,90vw)'}}>
+      <header><div><strong>同じ場面で、改稿を見比べる</strong><p>変更前と変更後を、音声付きで再生できます。</p></div><button aria-label="改稿比較を閉じる" onClick={()=>setOpen(false)}>×</button></header>
+      <div className="timing-fields timing-pair">
+        <label>比較元の保存済みプロジェクト<select value={path} onChange={e=>setPath(e.target.value)}><option value="">別名保存した版を選択</option>{refs.map(r=><option key={r.path} value={r.path}>{r.name}</option>)}</select></label>
+        <label>比較する場面<select value={sceneId} onChange={e=>setSceneId(e.target.value)}><option value="">場面を選択</option>{groups.map(g=><option key={g.id} value={g.id}>{g.name}</option>)}</select></label>
+      </div>
+      <button className="timing-add" disabled={!path||!sceneId||state?.status==='running'} onClick={()=>{try{setError('');facade.start(path,sceneId);}catch(e){setError(String(e));}}}>現在の版を保存して比較動画を作る</button>
+      {state?.status==='running'&&<p role="status">比較動画を作成中 · {state.done} / {state.total||'準備中'} フレーム</p>}
+      {state?.status==='failed'&&<p role="alert" className="timing-error">{state.error}</p>}
+      {urls&&state?.status==='completed'&&<div className="timing-pair" style={{marginTop:20}}>
+        {(['before','after'] as const).map(side=>{const version=state[side]!;return <article key={side}>
+          <strong>{side==='before'?'変更前':'変更後'}</strong><p>{version.name}<br/>{(version.startFrame/version.fps).toFixed(2)}–{(version.endFrame/version.fps).toFixed(2)}秒</p>
+          <video ref={side==='before'?before:after} aria-label={side==='before'?'変更前の比較動画':'変更後の比較動画'} controls playsInline preload="auto" src={urls[side]} style={{width:'100%',background:'#090a10',borderRadius:10}} onPlay={()=>{facade.pauseEditor();(side==='before'?after:before).current?.pause();}}/>
+          <p>{version.copy}</p><button onClick={()=>facade.play(side).catch(e=>setError(String(e)))}>先頭から再生</button>
+        </article>;})}
+      </div>}
+      {error&&<p role="alert" className="timing-error">{error}</p>}
+      <footer>比較動画は現在のプロジェクトに保存します。編集の取り消し履歴は維持します。</footer>
+    </section>
+  </div>,document.body);
+}
