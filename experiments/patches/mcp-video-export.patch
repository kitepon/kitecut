diff --git a/packages/ai/src/generation/sound-effect.ts b/packages/ai/src/generation/sound-effect.ts
new file mode 100644
index 0000000..1076a7a
--- /dev/null
+++ b/packages/ai/src/generation/sound-effect.ts
@@ -0,0 +1,37 @@
+export type SoundEffectInput = { preset: 'chime' | 'whoosh' | 'arrival'; duration: number; pitch: number; seed: number };
+const rate = 48000;
+
+/** 外部録音を使わず、正弦波と帯域を絞った雑音から短い効果音を合成する。 */
+export function synthesizeSoundEffect(input: SoundEffectInput): Uint8Array {
+  const count = Math.round(input.duration * rate), samples = new Float64Array(count);
+  function note(start: number, frequency: number, gain: number) {
+    const first = Math.round(start * rate), seconds = input.duration - start;
+    for (let index = first; index < count; index++) {
+      const t = (index - first) / rate;
+      const envelope = Math.min(1, t / .006) * Math.exp(-t / (seconds * .24)) * Math.min(1, (count - 1 - index) / (rate * .06));
+      samples[index]! += gain * envelope * (Math.sin(2 * Math.PI * frequency * t) + .16 * Math.sin(4 * Math.PI * frequency * t));
+    }
+  }
+  if (input.preset === 'chime') note(0, input.pitch, .4);
+  else if (input.preset === 'arrival') {
+    for (const [index, ratio] of [1, 1.25, 1.5].entries()) note(index * input.duration * .12, input.pitch * ratio, .19);
+  } else {
+    let seed = input.seed >>> 0, low = 0, previousLow = 0;
+    for (let index = 0; index < count; index++) {
+      seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+      const progress = index / count, cutoff = input.pitch * (1 + 5 * Math.sin(Math.PI * progress));
+      const coefficient = 1 - Math.exp(-2 * Math.PI * cutoff / rate);
+      previousLow += .015 * (low - previousLow);
+      low += coefficient * (seed / 2147483648 - 1 - low);
+      samples[index] = (low - previousLow) * .38 * Math.sin(Math.PI * progress) ** 2;
+    }
+  }
+  const buffer = new ArrayBuffer(44 + count * 2), view = new DataView(buffer);
+  function text(at: number, value: string) { for (let i = 0; i < value.length; i++) view.setUint8(at + i, value.charCodeAt(i)); }
+  text(0, 'RIFF'); view.setUint32(4, buffer.byteLength - 8, true); text(8, 'WAVEfmt ');
+  view.setUint32(16, 16, true); view.setUint16(20, 1, true); view.setUint16(22, 1, true);
+  view.setUint32(24, rate, true); view.setUint32(28, rate * 2, true); view.setUint16(32, 2, true); view.setUint16(34, 16, true);
+  text(36, 'data'); view.setUint32(40, count * 2, true);
+  for (let index = 0; index < count; index++) view.setInt16(44 + index * 2, Math.round(samples[index]! * 32767), true);
+  return new Uint8Array(buffer);
+}
