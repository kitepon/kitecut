+import { useEffect, useState } from "react";
+import { createPortal } from "react-dom";
+import { sceneGroups,createSceneCommand,moveSceneCommand,duplicateSceneCommand,transformSceneCommand,ungroupSceneCommand,type EditorStore,type Command } from "@frontstage/core";
+import { useStore } from "../store/use-store.js";
+import "./timing-markers.css";
+import { setSceneBriefCommand, storyboardRows, type SceneBrief } from "@frontstage/core";
+import { preserveSceneCommand } from "@frontstage/core";
+import { SceneComparisonPanel } from './SceneComparisonPanel.js';
+
+function SceneBriefEditor({store,sceneId}:{store:EditorStore;sceneId:string}) {
+  const timeline=useStore(store,s=>s.timeline);
+  const saved=timeline.sceneBriefs?.find(b=>b.sceneId===sceneId);
+  const [draft,setDraft]=useState<SceneBrief>(()=>saved??{sceneId,purpose:'',copy:'',audioNotes:''});
+  const [base,setBase]=useState(saved),[dirty,setDirty]=useState(false);
+  const [error,setError]=useState('');
+  useEffect(()=>{if(!dirty){setDraft(saved??{sceneId,purpose:'',copy:'',audioNotes:''});setBase(saved);setError('');}},[saved,sceneId,dirty]);
+  function edit(value:SceneBrief){setDraft(value);setDirty(true);}
+  return <div className="timing-fields">
+    <strong>この場面で伝えること</strong>
+    <label>目的<textarea value={draft.purpose} onChange={e=>edit({...draft,purpose:e.target.value})}/></label>
+    <label>コピー<textarea value={draft.copy} onChange={e=>edit({...draft,copy:e.target.value})}/></label>
+    <label>音の指示<textarea value={draft.audioNotes} onChange={e=>edit({...draft,audioNotes:e.target.value})}/></label>
+    <button onClick={()=>{try{
+      if(store.getSnapshot().timeline.sceneBriefs?.find(b=>b.sceneId===sceneId)!==base)throw Error('入力中に構成が変更されました。入力内容を控えてから最新の構成を読み直してください。');
+      store.dispatch(setSceneBriefCommand(draft));setDirty(false);setError('');
+    }catch(e){setError(String(e));}}}>構成を保存</button>
+    {dirty&&saved!==base&&<button onClick={()=>setDirty(false)}>最新の構成を読み直す（入力を破棄）</button>}
+    <p>構成メモの保存です。映像や音声への適用は編集操作で行います。</p>
+    <details><summary>使用素材の区間</summary>{storyboardRows(timeline).find(r=>r.id===sceneId)?.sources.map(s=><p key={s.clipId}>{s.mediaType} · 素材 {(s.sourceStartFrame/timeline.fps).toFixed(2)}–{(s.sourceEndFrame/timeline.fps).toFixed(2)}秒 · {s.speed}倍速</p>)}</details>
+    {error&&<p role="alert">{error}</p>}
+  </div>;
+}
+
+export function SceneGroupsPanel({store,comparison}:{store:EditorStore;comparison?:import('@frontstage/ai').SceneComparisonFacade}) {
+  const [compareRequest,setCompareRequest]=useState(0);
+  const [open,setOpen]=useState(false),[name,setName]=useState('実演'),[selected,setSelected]=useState(''),[error,setError]=useState('');
+  const [frame,setFrame]=useState(0),[x,setX]=useState(0),[y,setY]=useState(0),[scale,setScale]=useState(100);
+  const timeline=useStore(store,s=>s.timeline), groups=sceneGroups(timeline), group=groups.find(g=>g.id===selected);
+  function run(make:()=>Command) {try {store.dispatch(make());setError('');}catch(e){setError(e instanceof Error?e.message:String(e));}}
+  return <div className="timing-markers"><button className="timing-trigger" aria-expanded={open} onClick={()=>setOpen(!open)}>場面 <span>{groups.length||''}</span></button>
+    {comparison&&<SceneComparisonPanel store={store} facade={comparison} request={compareRequest}/>}
+    {open&&createPortal(<div className="timing-markers timing-overlay"><section className="timing-popover" role="dialog" aria-label="場面の編集">
+      <header><div><strong>場面を編集する</strong><p>映像、文字、音を一緒に。</p></div>{comparison&&<button onClick={()=>{setOpen(false);setCompareRequest(n=>n+1);}}>改稿を比較</button>}<button aria-label="場面パネルを閉じる" onClick={()=>setOpen(false)}>×</button></header>
+      <div className="timing-fields"><label>場面の名前<input value={name} onChange={e=>setName(e.target.value)}/></label>
+        <button className="timing-add" onClick={()=>{const id=crypto.randomUUID();run(()=>createSceneCommand([...store.getSnapshot().selection],name,id));setSelected(id);}}>選択クリップをまとめる</button></div>
+      <div className="timing-list">{!groups.length&&<p>タイムラインで二つ以上のクリップを選択してください。リンクされた音声も含めます。</p>}{groups.map(g=><button key={g.id} className={selected===g.id?'is-selected':''} onClick={()=>{setSelected(g.id);setFrame(g.startFrame);}}><span>{g.name}</span><time>{(g.startFrame/timeline.fps).toFixed(2)}–{(g.endFrame/timeline.fps).toFixed(2)}秒 · {g.clipIds.length}個</time></button>)}</div>
+      {group&&<div className="timing-fields"><strong>{group.name}</strong>
+        <label className="scene-preserve"><input type="checkbox" checked={timeline.preservedSceneIds?.includes(group.id)??false} onChange={e=>run(()=>preserveSceneCommand(group.id,e.target.checked))}/>AIの改稿でこの場面を残す</label>
+        <p>同じ区間の背景・字幕・音楽と構成メモも保持します。人は引き続き編集できます。</p>
+        <SceneBriefEditor key={group.id} store={store} sceneId={group.id}/>
+        <label>移動・複製先のフレーム<input type="number" min="0" step="1" value={frame} onChange={e=>setFrame(Number(e.target.value))}/></label>
+        <div className="timing-actions"><button onClick={()=>run(()=>moveSceneCommand(group.id,frame))}>場面を移動</button><button onClick={()=>run(()=>duplicateSceneCommand(group.id,frame,()=>crypto.randomUUID()))}>場面を複製</button></div>
+        <p>複製は元のトラックの直上へ追加します。</p>
+        <div className="timing-pair"><label>横へ移動（%）<input type="number" value={x} onChange={e=>setX(Number(e.target.value))}/></label><label>縦へ移動（%）<input type="number" value={y} onChange={e=>setY(Number(e.target.value))}/></label></div>
+        <label>現在の大きさに掛ける倍率（%）<input type="number" min="1" value={scale} onChange={e=>setScale(Number(e.target.value))}/></label>
+        <button onClick={()=>run(()=>transformSceneCommand(group.id,x/100,y/100,scale/100))}>映像の位置・拡縮を適用</button><p>画面中心を基準に、既存の動きにも適用します。再実行すると追加で変形します。</p>
+        <button className="timing-delete" onClick={()=>run(()=>ungroupSceneCommand(group.id))}>場面を解除</button></div>}
+      {error&&<p role="alert" className="timing-error">{error}</p>}<footer>操作ごとに一回で取り消せます</footer>
+    </section></div>,document.body)}
+  </div>;
+}
diff --git a/packages/ui/src/timeline/SpeechTimingPanel.tsx b/packages/ui/src/timeline/SpeechTimingPanel.tsx
