new file mode 100644
index 0000000..deb4aec
--- /dev/null
+++ b/apps/desktop/src/renderer/motion-tracking.ts
@@ -0,0 +1,52 @@
+import { transformAt, affineTransform, mat2dApply, setClipPropertyCommand, type EditorStore } from '@frontstage/core';
+type Input = { sourceClipId: string; startFrame: number; durationFrames: number; region: { x: number; y: number; width: number; height: number } };
+type Result = { samples: { seconds: number; x: number; y: number }[]; reason: string; stoppedAtSeconds: number | null; sourceWidth: number; sourceHeight: number };
+type State = { status: 'idle' | 'running' | 'completed' | 'failed'; input?: Input; result?: Result; error?: string };
+declare global { interface Window { desktopMotionTracking: { track(input: { path: string; startSeconds: number; durationSeconds: number; region: Input['region'] }): Promise<Result> } } }
+export function createMotionTracking(store: EditorStore, resolvePath: (id: string) => string | null, save: () => Promise<unknown>) {
+  let state: State = { status: 'idle' };
+  const listeners = new Set<() => void>();
+  const update = (value: State) => { state = value; listeners.forEach(listener => listener()); };
+  return {
+    state: () => state,
+    subscribe: (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; },
+    async start(input: Input) {
+      if (state.status === 'running') throw Error('追跡中です。完了してから次の解析を始めてください。');
+      const timeline = store.getSnapshot().timeline, clip = timeline.tracks.flatMap(track => track.clips).find(clip => clip.id === input.sourceClipId);
+      if (!clip || clip.mediaType !== 'video') throw Error('追跡元の動画クリップを選んでください。');
+      if (input.startFrame < clip.startFrame || input.startFrame + input.durationFrames > clip.startFrame + clip.durationFrames) throw Error('追跡範囲を動画クリップ内に指定してください。');
+      const path = resolvePath(clip.mediaRef);
+      if (!path) throw Error('元動画のファイルを参照できません。');
+      update({ status: 'running', input });
+      try {
+        const result = await window.desktopMotionTracking.track({ path, region: input.region,
+          startSeconds: (clip.trimStartFrame + (input.startFrame - clip.startFrame) * clip.speed) / timeline.fps,
+          durationSeconds: input.durationFrames * clip.speed / timeline.fps });
+        update({ status: 'completed', input, result }); return state;
+      } catch (error) { update({ status: 'failed', input, error: String(error) }); throw error; }
+    },
+    async apply({ targetClipId, offsetX, offsetY }: { targetClipId: string; offsetX: number; offsetY: number }) {
+      if (!state.result || !state.input || state.status !== 'completed') throw Error('完了した追跡結果がありません。');
+      const timeline = store.getSnapshot().timeline;
+      const clips = timeline.tracks.flatMap(track => track.clips);
+      const source = clips.find(clip => clip.id === state.input!.sourceClipId), target = clips.find(clip => clip.id === targetClipId);
+      if (!source || !target || source.id === target.id) throw Error('追跡元とは別の注釈クリップを選んでください。');
+      const result = state.result;
+      const frames = new Map<number, { frame: number; value: { a: number; b: number }; interpolationOut: 'linear' }>();
+      for (const sample of result.samples) {
+        const frame = Math.round(source.startFrame + (sample.seconds * timeline.fps - source.trimStartFrame) / source.speed);
+        if (frame < target.startFrame || frame >= target.startFrame + target.durationFrames) continue;
+        const matrix = affineTransform(transformAt(source, frame), { width: result.sourceWidth, height: result.sourceHeight }, timeline);
+        const point = mat2dApply(matrix, { x: sample.x * result.sourceWidth, y: sample.y * result.sourceHeight });
+        const transform = transformAt(target, frame);
+        const relative = frame - target.startFrame;
+        frames.set(relative, { frame: relative, value: { a: point.x / timeline.width + offsetX - transform.width / 2, b: point.y / timeline.height + offsetY - transform.height / 2 }, interpolationOut: 'linear' });
+      }
+      if (!frames.size) throw Error('注釈の表示期間と追跡結果が重なっていません。');
+      const command = setClipPropertyCommand(targetClipId, 'positionTrack', { keyframes: [...frames.values()].sort((a, b) => a.frame - b.frame) });
+      store.dispatch({ ...command, label: '追跡を注釈へ反映' });
+      await save();
+      return { keyframes: frames.size, reason: result.reason, stoppedAtSeconds: result.stoppedAtSeconds };
+    },
+  };
+}
