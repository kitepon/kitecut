+++ b/packages/ui/src/timeline/SpeechTimingPanel.tsx
@@ -0,0 +1,47 @@
+import { useEffect, useState } from "react";
+import type { EditorStore, TimingMarker } from "@frontstage/core";
+import type { CaptionsExecutor } from "../media/CaptionsTab.js";
+
+interface Analysis { jobId: string; status: "running" | "completed" | "failed"; markers?: TimingMarker[]; language?: string; error?: string; applied?: boolean }
+
+export function SpeechTimingPanel({ store, executor, kind = "speech" }: { store: EditorStore; executor: CaptionsExecutor; kind?: "speech" | "beat" }) {
+  const label = kind === "speech" ? "発話" : "拍";
+  const [analysis, setAnalysis] = useState<Analysis | null>(null);
+  const [error, setError] = useState("");
+  const [starting, setStarting] = useState(false);
+  async function invoke(name: string, args: unknown) {
+    const result = await executor.execute(name, args);
+    const text = result.blocks.filter(b => b.kind === "text").map(b => b.kind === "text" ? b.text : "").join("\n");
+    if (result.isError) throw Error(text);
+    return JSON.parse(text);
+  }
+  useEffect(() => {
+    if (!analysis || analysis.status !== "running") return;
+    let closed = false;
+    const timer = setTimeout(() => {
+      void invoke(`analyze_${kind}_timing`, { jobId: analysis.jobId }).then(next => {
+        if (!closed) setAnalysis(next);
+      }, e => { if (!closed) { setError(String(e)); setAnalysis({ ...analysis, status: "failed" }); } });
+    }, 1000);
+    return () => { closed = true; clearTimeout(timer); };
+  }, [analysis, executor, kind]);
+  async function start() {
+    setStarting(true); setError("");
+    try {
+      const ids = [...store.getSnapshot().selection];
+      if (ids.length !== 1) throw Error(`${label}を調べる音声または動画を一つ選んでください`);
+      setAnalysis(await invoke(`analyze_${kind}_timing`, { clipId: ids[0] }));
+    } catch (e) { setError(String(e)); } finally { setStarting(false); }
+  }
+  return <div className="timing-fields">
+    <button className="timing-add" disabled={starting || analysis?.status === "running"} onClick={() => void start()}>{starting || analysis?.status === "running" ? `${label}を解析中…` : `選択素材の${label}を自動検出`}</button>
+    <p>{kind === "speech" ? "保存済みの認識を活用し、必要なら無償のローカル認識を準備します。" : "音楽を端末内で解析します。冒頭の抜けや裏拍の誤検出は、目印を編集して調整できます。"}</p>
+    {analysis?.status === "completed" && <><p>{analysis.markers?.length ?? 0}個の{label}候補。内容と位置を確認してから適用してください。</p>
+      {analysis.language && <p>認識言語: {analysis.language === "ja" ? "日本語" : analysis.language === "en" ? "英語" : analysis.language}</p>}
+      <ol aria-label={`${label}の候補`}>{analysis.markers?.map(marker => <li key={marker.id}><span>{marker.frame}{marker.endFrame === undefined ? "" : `–${marker.endFrame}`} フレーム</span><p>{marker.label}</p></li>)}</ol>
+      <button disabled={analysis.applied || !analysis.markers?.length} className="timing-add" onClick={() => {
+        void invoke(`apply_${kind}_timing`, { jobId: analysis.jobId }).then(() => { setAnalysis({ ...analysis, applied: true }); setError(""); }, e => setError(String(e)));
+      }}>{analysis.applied ? "目印へ適用済み" : `${label}の目印にする`}</button></>}
+    {(error || analysis?.error) && <p role="alert" className="timing-error">{error || analysis?.error}</p>}
+  </div>;
+}
