+import { useEffect, useState, useSyncExternalStore } from 'react';
+import type { EditorStore } from '@frontstage/core';
+import type { createMotionTracking } from './motion-tracking.js';
+import './motion-tracking.css';
+export function MotionTrackingPanel({ tracking, store }: { tracking: ReturnType<typeof createMotionTracking>; store: EditorStore }) {
+  const [open, setOpen] = useState(false), [source, setSource] = useState(''), [target, setTarget] = useState(''), [error, setError] = useState('');
+  const [start, setStart] = useState(0), [duration, setDuration] = useState(30);
+  const [region, setRegion] = useState({ x: .25, y: .25, width: .25, height: .25 });
+  const state = useSyncExternalStore(tracking.subscribe, tracking.state);
+  useEffect(() => {
+    if (!state.input) return;
+    setSource(state.input.sourceClipId); setStart(state.input.startFrame);
+    setDuration(state.input.durationFrames); setRegion(state.input.region);
+  }, [state.input]);
+  const timeline = useSyncExternalStore(callback => store.subscribe(callback), () => store.getSnapshot()).timeline;
+  const clips = timeline.tracks.flatMap(track => track.clips);
+  const active = state.status === 'running';
+  const label = active ? '追跡中…' : state.result ? `追跡結果 ${state.result.samples.length}点` : '動きに追従';
+  async function run(action: () => Promise<unknown>) { try { setError(''); await action(); } catch (error) { setError(String(error)); } }
+  return <div className="motion-tracking"><button className="motion-launch" onClick={() => setOpen(!open)}>{label}</button>
+    {open && <section role="dialog" aria-label="動きに追従"><header><strong>対象の動きに注釈を合わせる</strong><button aria-label="追跡パネルを閉じる" onClick={() => setOpen(false)}>×</button></header>
+      <label>追跡元の動画<select value={source} onChange={event => { const id = event.target.value; setSource(id); const clip = clips.find(clip => clip.id === id); if (clip) { setStart(clip.startFrame); setDuration(clip.durationFrames); } }}><option value="">動画を選ぶ</option>{clips.filter(clip => clip.mediaType === 'video').map(clip => <option key={clip.id} value={clip.id}>{clip.id.slice(0,8)} · {clip.startFrame}フレームから</option>)}</select></label>
+      <div className="motion-grid"><label>開始フレーム<input type="number" value={start} onChange={event => setStart(Number(event.target.value))}/></label><label>追跡フレーム数<input type="number" min="1" value={duration} onChange={event => setDuration(Number(event.target.value))}/></label></div>
+      <p>元素材の左上を0%、右下を100%として、追う領域を指定します。</p>
+      <div className="motion-grid">{(['x','y','width','height'] as const).map((key,index) => <label key={key}>{['左から (%)','上から (%)','幅 (%)','高さ (%)'][index]}<input type="number" value={region[key]*100} onChange={event => setRegion({...region,[key]:Number(event.target.value)/100})}/></label>)}</div>
+      <button disabled={active || !source} onClick={() => void run(() => tracking.start({ sourceClipId: source, startFrame: start, durationFrames: duration, region }))}>領域を追跡</button>
+      <div role="status">{label}{state.result && <p>{state.result.reason === 'lost' || state.result.reason === 'outside' ? `素材の${state.result.stoppedAtSeconds?.toFixed(2)}秒で追跡停止。以降は最後の位置を保持します。再指定するかキーフレームを編集してください。` : '指定範囲または素材の末尾まで解析しました。'}</p>}</div>
+      {state.result && <><label>追従させる注釈<select value={target} onChange={event => setTarget(event.target.value)}><option value="">クリップを選ぶ</option>{clips.filter(clip => clip.id !== state.input?.sourceClipId && clip.mediaType !== 'audio').map(clip => <option key={clip.id} value={clip.id}>{clip.textContent || clip.id.slice(0,8)}</option>)}</select></label>
+        <p>注釈の中心を追跡位置に合わせ、既存の位置キーフレームを置き換えます。反映後は取り消しとキーフレーム編集ができます。</p>
+        <button disabled={active || !target} onClick={() => void run(() => tracking.apply({ targetClipId: target, offsetX: 0, offsetY: 0 }))}>注釈へ反映して保存</button></>}
+      {(error || state.error) && <p role="alert">{error || state.error}</p>}
+    </section>}
+  </div>;
+}
