+afterEach(() => vi.unstubAllGlobals());
+test('素材時刻を速度とトリムから変換し、注釈の位置へ反映して取り消せる', async () => {
+  const timeline = TimelineSchema.parse({ width: 1000, height: 1000, fps: 30, tracks: [
+    { id: 'v', type: 'video', clips: [{ id: 'source', mediaRef: 'media', mediaType: 'video', sourceClipType: 'video', startFrame: 30, durationFrames: 60, trimStartFrame: 30, speed: 2, transform: { centerX: .5, centerY: .5, width: .5, height: .5, rotation: 0, flipHorizontal: true, flipVertical: false } }] },
+    { id: 't', type: 'text', clips: [{ id: 'target', mediaRef: 'text', mediaType: 'text', sourceClipType: 'text', startFrame: 30, durationFrames: 60 }] },
+  ] });
+  const store = new EditorStore(timeline), save = vi.fn();
+  const track = vi.fn(async () => ({ samples: [{ seconds: 1, x: .2, y: .4 }, { seconds: 2, x: .4, y: .6 }], reason: 'lost', stoppedAtSeconds: 2.1, sourceWidth: 320, sourceHeight: 180 }));
+  vi.stubGlobal('window', { desktopMotionTracking: { track } });
