@@ -0,0 +1,57 @@
+import { useEffect, useRef, useState } from 'react';
+import type { EditorStore, Timeline } from '@frontstage/core';
+import type { ToolResult } from '@frontstage/ai';
+import { useStore } from '../store/use-store.js';
+import { Button } from '../primitives/index.js';
+import { theme } from '../theme/theme.js';
+
+type Executor = { execute(name: string, args: unknown): Promise<ToolResult> };
+type Word = [number, string, number, number, ...unknown[]];
+type Transcript = { fps: number; clips: { clipId: string; words: Word[] }[]; nextStartFrame?: number; skipped?: { error: string }[] };
+function text(result: ToolResult): string {
+  const message = result.blocks.filter(b => b.kind === 'text').map(b => b.text).join('\n');
+  if (result.isError) throw Error(message);
+  return message;
+}
+
+export function TranscriptEditor({ store, executor }: { store: EditorStore; executor: Executor }) {
+  const timeline = useStore(store, s => s.timeline);
+  const [transcript, setTranscript] = useState<Transcript | null>(null);
+  const [source, setSource] = useState<Timeline | null>(null);
+  const [selected, setSelected] = useState<number[]>([]), [busy, setBusy] = useState(false), [message, setMessage] = useState('');
+  const request = useRef(0);
+  useEffect(() => () => { request.current++; }, []);
+  const stale = source !== timeline;
+  async function read() {
+    const id = ++request.current, current = store.getSnapshot().timeline;
+    setBusy(true); setMessage('このPCで文字起こししています。'); setSelected([]);
+    try {
+      let job = JSON.parse(text(await executor.execute('get_transcript', { local: true, background: true })));
+      while (job.status === 'running' && id === request.current) {
+        await new Promise(resolve => setTimeout(resolve, 1000));
+        if (id !== request.current) return;
+        job = JSON.parse(text(await executor.execute('get_transcript', { jobId: job.jobId })));
+      }
+      if (id !== request.current) return;
+      const result: Transcript = JSON.parse(text(job.result));
+      setTranscript(result); setSource(current);
+      setMessage(result.skipped?.map(s => s.error).join('\n') ?? (result.nextStartFrame !== undefined ? '単語数が表示上限に達しました。続きは公開操作から取得できます。' : '単語を選ぶと、その発話区間を削除できます。'));
+    } catch (error) { if (id === request.current) setMessage(String(error)); }
+    finally { if (id === request.current) setBusy(false); }
+  }
+  return <details data-testid="transcript-editor" style={{ padding: 8, border: `1px solid ${theme.border.subtle}`, borderRadius: 8, marginBottom: 10, fontSize: 12 }}><summary style={{ cursor: 'pointer', paddingBottom: 8 }}>文字起こしから編集する</summary>
+    <Button disabled={busy} onClick={() => void read()}>文字起こしを読み込む</Button>
+    {message && <p role="status">{message}</p>}
+    {transcript && stale && <p>編集内容が変わりました。削除前に文字起こしを読み直してください。</p>}
+    <div style={{ maxHeight: 260, overflowY: 'auto', margin: '8px 0' }}>{transcript?.clips.flatMap(c => c.words).map(word => <div key={word[0]} style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', minHeight: 30, gap: 8 }}>
+      <label style={{ display: 'flex', alignItems: 'center', gap: 5 }}><input type="checkbox" disabled={busy || stale} checked={selected.includes(word[0])} onChange={event => setSelected(ids => event.target.checked ? [...ids, word[0]] : ids.filter(id => id !== word[0]))} />{word[1]}</label>
+      <button style={{ background: 'transparent', color: theme.accent.timecode, border: 0, fontSize: 11, cursor: 'pointer', whiteSpace: 'nowrap' }} disabled={busy || stale} aria-label={`${word[1]}の位置へ移動`} onClick={async () => { try { text(await executor.execute('seek_preview', { frame: word[2] })); } catch (e) { setMessage(String(e)); } }}>{(word[2] / transcript!.fps).toFixed(2)}–{(word[3] / transcript!.fps).toFixed(2)}秒</button>
+    </div>)}</div>
+    <Button disabled={busy || stale || !selected.length} onClick={async () => {
+      setBusy(true); setMessage('');
+      try { text(await executor.execute('remove_words', { words: selected, cutAggressiveness: 'tight' })); setSelected([]); setTranscript(null); setMessage('選んだ発話区間を削除しました。取り消しで戻せます。'); }
+      catch (error) { setMessage(String(error)); }
+      finally { setBusy(false); }
+    }}>選んだ単語の区間を削除</Button>
+  </details>;
+}
