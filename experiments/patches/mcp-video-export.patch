+    <style>{'.audio-library-tab label{display:grid;gap:4px;margin:8px 0}.audio-library-tab input,.audio-library-tab select{width:100%;background:var(--bg-raised);color:var(--text-primary);border:1px solid var(--border-primary);padding:6px}.audio-library-tab button{background:var(--bg-prominent);color:var(--text-primary);border:1px solid var(--border-primary);padding:6px;margin:4px 0}.audio-library-tab audio{width:100%}'}</style>
